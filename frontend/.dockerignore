.idea

# Test files
__tests__
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
coverage
.nyc_output

# Documentation
*.md
docs

# Logs
logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
*.swp
*.swo
*~

# Misc
.eslintcache
.prettierignore
Dockerfile
.dockerignore

# Storybook (if exists)
.storybook
storybook-static
