# KreupAI ManithPro - Production Environment Configuration
# CRITICAL: This file is a template only. ALL values must come from secure secrets management.
# Never commit actual production secrets to version control.

# =============================================================================
# Database (Use managed PostgreSQL - AWS RDS, GCP Cloud SQL, etc.)
# =============================================================================
DATABASE_URL="${PRODUCTION_DATABASE_URL}"

# =============================================================================
# Authentication (Generate strong secrets with openssl rand -base64 64)
# =============================================================================
JWT_SECRET="${PRODUCTION_JWT_SECRET}"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="${PRODUCTION_JWT_REFRESH_SECRET}"
JWT_REFRESH_EXPIRES_IN="7d"

# =============================================================================
# Server
# =============================================================================
PORT=3000
NODE_ENV="production"
LOG_LEVEL="warn"

# =============================================================================
# URLs
# =============================================================================
FRONTEND_URL="${PRODUCTION_FRONTEND_URL}"
API_URL="${PRODUCTION_API_URL}"
CORS_ORIGINS="${PRODUCTION_CORS_ORIGINS}"

# =============================================================================
# Redis (Use managed Redis - AWS ElastiCache, Redis Cloud, etc.)
# =============================================================================
REDIS_URL="${PRODUCTION_REDIS_URL}"
REDIS_PASSWORD="${PRODUCTION_REDIS_PASSWORD}"
REDIS_TLS=true

# =============================================================================
# Email (Production email service)
# =============================================================================
SMTP_HOST="${PRODUCTION_SMTP_HOST}"
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER="${PRODUCTION_SMTP_USER}"
SMTP_PASS="${PRODUCTION_SMTP_PASS}"
EMAIL_FROM="noreply@manithpro.com"

# Alternative: SendGrid
# SENDGRID_API_KEY="${PRODUCTION_SENDGRID_API_KEY}"

# Alternative: AWS SES
# AWS_SES_REGION="${PRODUCTION_AWS_SES_REGION}"

# =============================================================================
# File Upload (Production S3)
# =============================================================================
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES="pdf,doc,docx"
AWS_ACCESS_KEY_ID="${PRODUCTION_AWS_ACCESS_KEY_ID}"
AWS_SECRET_ACCESS_KEY="${PRODUCTION_AWS_SECRET_ACCESS_KEY}"
AWS_REGION="${PRODUCTION_AWS_REGION}"
AWS_S3_BUCKET="${PRODUCTION_AWS_S3_BUCKET}"

# =============================================================================
# OAuth Providers (Production credentials)
# =============================================================================
LINKEDIN_CLIENT_ID="${PRODUCTION_LINKEDIN_CLIENT_ID}"
LINKEDIN_CLIENT_SECRET="${PRODUCTION_LINKEDIN_CLIENT_SECRET}"
LINKEDIN_REDIRECT_URI="${PRODUCTION_API_URL}/api/auth/linkedin/callback"

GOOGLE_CLIENT_ID="${PRODUCTION_GOOGLE_CLIENT_ID}"
GOOGLE_CLIENT_SECRET="${PRODUCTION_GOOGLE_CLIENT_SECRET}"
GOOGLE_REDIRECT_URI="${PRODUCTION_API_URL}/api/auth/google/callback"

# =============================================================================
# Payments (Stripe Live Mode)
# =============================================================================
STRIPE_SECRET_KEY="${PRODUCTION_STRIPE_SECRET_KEY}"
STRIPE_WEBHOOK_SECRET="${PRODUCTION_STRIPE_WEBHOOK_SECRET}"
STRIPE_PUBLISHABLE_KEY="${PRODUCTION_STRIPE_PUBLISHABLE_KEY}"

# =============================================================================
# Monitoring & Observability
# =============================================================================
SENTRY_DSN="${PRODUCTION_SENTRY_DSN}"
ENABLE_MONITORING=true

# APM (Application Performance Monitoring)
NEW_RELIC_LICENSE_KEY="${PRODUCTION_NEW_RELIC_LICENSE_KEY}"
DATADOG_API_KEY="${PRODUCTION_DATADOG_API_KEY}"

# =============================================================================
# Security
# =============================================================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
BCRYPT_ROUNDS=12
SESSION_SECRET="${PRODUCTION_SESSION_SECRET}"

# =============================================================================
# Third-party Integrations
# =============================================================================
# Background Check Provider
CHECKR_API_KEY="${PRODUCTION_CHECKR_API_KEY}"

# Calendar Integration
GOOGLE_CALENDAR_API_KEY="${PRODUCTION_GOOGLE_CALENDAR_API_KEY}"

# AI/ML Services
OPENAI_API_KEY="${PRODUCTION_OPENAI_API_KEY}"
