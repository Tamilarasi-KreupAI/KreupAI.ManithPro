  bookmarkedById        String?
  bookmarkNotes         String?

  // Metadata
  extractedAt           DateTime            @default(now())

  @@index([interviewId])
  @@index([highlightType])
  @@index([importance])
  @@map("interview_highlights")
}

// 4.2.10 - COMPARATIVE ANALYSIS
model CandidateComparison {
  id                    String              @id @default(uuid())

  // Job Context
  jobId                 String
  comparisonName        String?             // Name for this comparison set

  // Candidates Being Compared
  candidateIds          String[]            @default([])
  interviewIds          String[]            @default([])

  // Primary Candidate (if comparing one vs others)
  primaryCandidateId    String?
  primaryCandidate      User?               @relation("ComparisonCandidate", fields: [primaryCandidateId], references: [id], onDelete: SetNull)

  // Creator
  createdById           String
  createdBy             User                @relation("ComparisonCreator", fields: [createdById], references: [id], onDelete: Cascade)

  // Comparison Criteria
  criteria              String[]            @default([]) // Skills, experience, etc.
  weights               Json?               // { criterion: weight }

  // Rankings
  overallRanking        Json                // Array of { candidateId, rank, score }
  categoryRankings      Json?               // { category: [{ candidateId, rank, score }] }

  // Comparative Scores
  scores                Json                // { candidateId: { overall, technical, communication, etc. } }
  normalizedScores      Json?               // Scores normalized to same scale

  // Analysis
  strengthsComparison   Json?               // { candidateId: [strengths] }
  weaknessesComparison  Json?               // { candidateId: [weaknesses] }
  uniqueStrengths       Json?               // What makes each candidate unique

  // Skills Matrix
  skillsMatrix          Json?               // { skill: { candidateId: level } }
  skillGapsAnalysis     Json?               // Who has what gaps

  // Cultural Fit Comparison
  culturalFitScores     Json?               // { candidateId: score }

  // Experience Comparison
  experienceComparison  Json?               // Years, relevance, etc.
  qualificationMatch    Json?               // How well each matches requirements

  // Recommendations
  topRecommendation     String?             // Recommended candidateId
  recommendationReason  String?             @db.Text
  orderOfPreference     String[]            @default([]) // Ordered list of candidateIds

  // Insights
  keyDifferentiators    Json?               // What sets candidates apart
  tieBreakers           String[]            @default([]) // Factors that differentiate similar candidates
  concerns              Json?               // { candidateId: [concerns] }

  // Status
  status                String              @default("DRAFT") // DRAFT, COMPLETED, SHARED
  isActive              Boolean             @default(true)

  // Sharing
  sharedWith            String[]            @default([])
  sharedAt              DateTime?

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([jobId])
  @@index([createdById])
  @@map("candidate_comparisons")
}

