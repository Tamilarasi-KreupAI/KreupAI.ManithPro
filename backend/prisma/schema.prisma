  comparedCandidateIds  Json                // Array of candidate IDs compared

  // Comparison Results
  percentileRank        Float?              // Where candidate ranks (0-100)
  relativeStrength      String?             // ABOVE_AVERAGE, AVERAGE, BELOW_AVERAGE
  standoutAreas         Json?               // Areas where candidate excels
  gapAreas              Json?               // Areas where candidate lags

  // Benchmark Data
  benchmarkAvgScore     Float?
  benchmarkMedianScore  Float?
  benchmarkTopScore     Float?
  benchmarkCriteriaAvg  Json?               // By criteria comparison

