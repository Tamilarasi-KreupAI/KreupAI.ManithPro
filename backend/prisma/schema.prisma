  followers             Int                 @default(0)
  following             Int                 @default(0)
  gists                 Int                 @default(0)

  // Contribution Data
  totalContributions    Int                 @default(0)
  contributionsLastYear Int                 @default(0)
  longestStreak         Int                 @default(0)
  currentStreak         Int                 @default(0)

  // Languages & Skills
  topLanguages          Json?               // Array of {name, percentage, bytes}
