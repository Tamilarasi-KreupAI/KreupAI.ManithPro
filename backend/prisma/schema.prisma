generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model User {
  id                      String                    @id @default(uuid())
  email                   String                    @unique
  password                String
  firstName               String
  lastName                String
  role                    UserRole                  @default(CANDIDATE)
  phone                   String?
  bio                     String?
  skills                  String[]                  @default([])
  experience              Int?
  education               String?
  location                String?
  linkedIn                String?
  portfolio               String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  screeningInterviews     AIScreeningInterview[]    @relation("ScreeningCandidate")
  conductedScreenings     AIScreeningInterview[]    @relation("ScreeningRecruiter")
  applicationInsights     ApplicationInsight[]
  applications            Application[]
  availabilitySlots       AvailabilitySlot[]
  bufferTimeSettings      BufferTimeSettings?
  calendarConflicts       CalendarConflict[]
  calendarEvents          CalendarEvent[]
  calendarIntegrations    CalendarIntegration[]
  candidateProfile        CandidateProfile?
  careerPathAdvice        CareerPathAdvice[]
  confirmationRequests    ConfirmationRequest[]     @relation("ConfirmationRecipient")
  sentConfirmations       ConfirmationRequest[]     @relation("ConfirmationSender")
  coverLetters            CoverLetter[]
  entityRecognitions      EntityRecognition[]
  experienceDescriptions  ExperienceDescription[]
  holidayCalendars        HolidayCalendar[]
  interviewPreps          InterviewPrep[]
  candidateInterviews     Interview[]               @relation("CandidateInterviews")
  scheduledInterviews     Interview[]               @relation("ScheduledInterviews")
  postedJobs              Job[]                     @relation("PostedJobs")
  learningRecommendations LearningRecommendation[]
  receivedMessages        Message[]                 @relation("ReceivedMessages")
  sentMessages            Message[]                 @relation("SentMessages")
  notificationChannels    NotificationChannel[]
  notificationPreference  NotificationPreference?
  notifications           Notification[]
  panelMemberships        PanelMember[]
  organizedPanelSessions  PanelSession[]            @relation("PanelOrganizer")
  parsedDocuments         ParsedDocument[]
  portfolioFeedback       PortfolioFeedback[]
  prepDeliveries          PrepMaterialDelivery[]    @relation("PrepDeliveryRecipient")
  prepMaterials           PrepMaterial[]
  profileEnhancements     ProfileEnhancement[]
  pushSubscriptions       PushSubscription[]
  questionFlows           QuestionFlow[]
  recruiterProfile        RecruiterProfile?
  reminderNotifications   ReminderNotification[]
  reminderSchedules       ReminderSchedule[]
  resumes                 Resume[]
  salaryNegotiationAdvice SalaryNegotiationAdvice[]
  savedJobs               SavedJob[]
  schedulingLinks         SchedulingLink[]
  screeningResponses      ScreeningResponse[]
  semanticSearchIndices   SemanticSearchIndex[]
  skillExtractions        SkillExtraction[]
  skillsGapAnalyses       SkillsGapAnalysis[]
  timezonePreference      TimezonePreference?
  workingHours            WorkingHours[]

  @@map("users")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Job {
  id                      String                   @id @default(uuid())
  title                   String
  description             String
  requirements            String[]                 @default([])
  responsibilities        String[]                 @default([])
  location                String
  type                    JobType
  salary                  String?
  salaryMin               Int?
  salaryMax               Int?
  benefits                String[]                 @default([])
  skills                  String[]                 @default([])
  experience              String?
  education               String?
  status                  JobStatus                @default(OPEN)
  positions               Int                      @default(1)
  deadline                DateTime?
  companyName             String
  companyDescription      String?
  companyWebsite          String?
  companyLogo             String?
  companySize             String?
  companyIndustry         String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  postedById              String
  screeningInterviews     AIScreeningInterview[]
  applications            Application[]
  postedBy                User                     @relation("PostedJobs", fields: [postedById], references: [id], onDelete: Cascade)
  learningRecommendations LearningRecommendation[]
  questionFlows           QuestionFlow[]
  savedBy                 SavedJob[]

  @@index([status, createdAt])
  @@index([type])
  @@index([companyName])
  @@index([companyName], map: "idx_jobs_company")
  @@index([type], map: "idx_jobs_type")
  @@map("jobs")
}

model Application {
  id                  String                 @id @default(uuid())
  resume              String
  coverLetter         String?
  status              ApplicationStatus      @default(PENDING)
  notes               String?
  appliedAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  jobId               String
  candidateId         String
  screeningInterviews AIScreeningInterview[]
  insight             ApplicationInsight?
  candidate           User                   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job                 Job                    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  interviews          Interview[]
  messages            Message[]

  @@unique([jobId, candidateId])
  @@index([status])
  @@index([candidateId])
  @@index([status], map: "idx_applications_status")
  @@map("applications")
}

model SavedJob {
  id      String   @id @default(uuid())
  userId  String
  jobId   String
  savedAt DateTime @default(now())
  job     Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@map("saved_jobs")
}

model Resume {
  id         String   @id @default(uuid())
  userId     String
  fileName   String
  filePath   String
  fileSize   Int
  fileType   String
  isDefault  Boolean  @default(false)
  uploadedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("resumes")
}

model Interview {
  id                     String                 @id @default(uuid())
  type                   InterviewType
  status                 InterviewStatus        @default(SCHEDULED)
  scheduledAt            DateTime
  endTime                DateTime
  timeZone               String?
  meetingLink            String?
  location               String?
  instructions           String?
  notes                  String?
  feedback               String?
  rating                 Int?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  applicationId          String
  scheduledById          String
  candidateId            String
  proposal_id            Int?
  confirmationRequests   ConfirmationRequest[]
  application            Application            @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  candidate              User                   @relation("CandidateInterviews", fields: [candidateId], references: [id])
  scheduledBy            User                   @relation("ScheduledInterviews", fields: [scheduledById], references: [id])
  prepMaterialDeliveries PrepMaterialDelivery[]
  reminderNotifications  ReminderNotification[]

  @@index([status, scheduledAt])
  @@index([candidateId])
  @@index([scheduledById])
  @@index([proposal_id], map: "idx_interviews_proposal")
  @@index([status, scheduledAt], map: "idx_interviews_status_scheduled")
  @@map("interviews")
}

model Message {
  id            String        @id @default(uuid())
  content       String
  status        MessageStatus @default(SENT)
  attachments   String[]      @default([])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  senderId      String
  receiverId    String
  applicationId String?
  application   Application?  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  receiver      User          @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  sender        User          @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId])
  @@index([applicationId])
  @@index([createdAt])
  @@map("messages")
}

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@index([userId, isRead], map: "idx_notifications_user_read")
  @@map("notifications")
}

model AuditLog {
  id          String      @id @default(uuid())
  action      AuditAction
  entity      String
  entityId    String?
  changes     Json?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime    @default(now())
  userId      String?
  performedBy String?

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@index([entity, entityId], map: "idx_audit_logs_entity")
  @@index([userId], map: "idx_audit_logs_user")
  @@map("audit_logs")
}

model FAQ {
  id          String   @id @default(uuid())
  question    String
  answer      String
  category    String?
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  views       Int      @default(0)
  helpful     Int      @default(0)
  notHelpful  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isPublished])
  @@map("faqs")
}

model EmailTemplate {
  id        String   @id @default(uuid())
  name      String   @unique
  subject   String
  body      String
  variables String[] @default([])
  category  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isActive])
  @@map("email_templates")
}

model NotificationTemplate {
  id        String           @id @default(uuid())
  name      String           @unique
  title     String
  body      String
  type      NotificationType
  variables String[]         @default([])
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([type])
  @@index([isActive])
  @@map("notification_templates")
}

model StaticPage {
  id              String    @id @default(uuid())
  slug            String    @unique
  title           String
  content         String
  metaTitle       String?
  metaDescription String?
  isPublished     Boolean   @default(true)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([slug])
  @@index([isPublished])
  @@map("static_pages")
}

model HelpArticle {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  content     String
  category    String
  tags        String[]  @default([])
  views       Int       @default(0)
  helpful     Int       @default(0)
  notHelpful  Int       @default(0)
  isPublished Boolean   @default(true)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([category])
  @@index([slug])
  @@index([isPublished])
  @@map("help_articles")
}

model Subscription {
  id           String             @id @default(uuid())
  plan         SubscriptionPlan
  status       SubscriptionStatus @default(TRIAL)
  startDate    DateTime           @default(now())
  endDate      DateTime?
  trialEndDate DateTime?
  maxJobs      Int?
  maxUsers     Int?
  features     Json?
  price        Float
  billingCycle String
  autoRenew    Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  userId       String?            @unique
  companyId    String?
  invoices     Invoice[]
  payments     Payment[]

  @@index([userId])
  @@index([status])
  @@index([endDate])
  @@index([endDate], map: "idx_subscriptions_enddate")
  @@index([status], map: "idx_subscriptions_status")
  @@index([userId], map: "idx_subscriptions_user")
  @@map("subscriptions")
}

model Payment {
  id              String        @id @default(uuid())
  amount          Float
  currency        String        @default("USD")
  status          PaymentStatus @default(PENDING)
  method          PaymentMethod
  transactionId   String?       @unique
  stripePaymentId String?
  paypalOrderId   String?
  cardLast4       String?
  cardBrand       String?
  metadata        Json?
  failureReason   String?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  subscriptionId  String
  invoiceId       String?       @unique
  invoice         Invoice?      @relation(fields: [invoiceId], references: [id])
  subscription    Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([status])
  @@index([createdAt])
  @@index([status], map: "idx_payments_status")
  @@index([subscriptionId], map: "idx_payments_subscription")
  @@map("payments")
}

model Invoice {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique
  amount         Float
  tax            Float         @default(0)
  discount       Float         @default(0)
  total          Float
  currency       String        @default("USD")
  status         PaymentStatus @default(PENDING)
  dueDate        DateTime?
  paidAt         DateTime?
  items          Json
  billingAddress Json?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  subscriptionId String
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  payment        Payment?

  @@index([subscriptionId])
  @@index([status])
  @@index([invoiceNumber])
  @@index([createdAt])
  @@index([status], map: "idx_invoices_status")
  @@index([subscriptionId], map: "idx_invoices_subscription")
  @@map("invoices")
}

model ErrorLog {
  id         String     @id @default(uuid())
  level      ErrorLevel @default(ERROR)
  message    String
  stack      String?
  context    Json?
  endpoint   String?
  method     String?
  statusCode Int?
  userId     String?
  ipAddress  String?
  userAgent  String?
  resolved   Boolean    @default(false)
  resolvedAt DateTime?
  resolvedBy String?
  notes      String?
  createdAt  DateTime   @default(now())

  @@index([level])
  @@index([resolved])
  @@index([createdAt])
  @@index([userId])
  @@index([level], map: "idx_error_logs_level")
  @@index([resolved], map: "idx_error_logs_resolved")
  @@map("error_logs")
}

model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  type        String   @default("string")
  category    String?
  description String?
  isPublic    Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  @@index([category])
  @@index([isPublic])
  @@index([category], map: "idx_system_configs_category")
  @@index([isPublic], map: "idx_system_configs_public")
  @@map("system_configs")
}

model CandidateProfile {
  id                             String                           @id @default(uuid())
  userId                         String                           @unique
  headline                       String?
  summary                        String?
  dateOfBirth                    DateTime?
  nationality                    String?
  languages                      Json?
  address                        String?
  city                           String?
  state                          String?
  country                        String?
  zipCode                        String?
  preferredLocation              String[]                         @default([])
  willingToRelocate              Boolean                          @default(false)
  remotePreference               String?
  expectedSalary                 Float?
  expectedSalaryCurrency         String?                          @default("USD")
  noticePeriod                   String?
  availableFrom                  DateTime?
  jobTypes                       String[]                         @default([])
  industries                     String[]                         @default([])
  completenessScore              Int                              @default(0)
  lastCompletedSection           String?
  website                        String?
  github                         String?
  linkedin                       String?
  twitter                        String?
  stackoverflow                  String?
  dribbble                       String?
  behance                        String?
  medium                         String?
  kaggle                         String?
  isPublic                       Boolean                          @default(true)
  allowMessages                  Boolean                          @default(true)
  showSalaryExpectation          Boolean                          @default(false)
  createdAt                      DateTime                         @default(now())
  updatedAt                      DateTime                         @updatedAt
  academicProfiles               AcademicProfile[]
  achievements                   Achievement[]
  BackgroundCheck                BackgroundCheck[]
  blogPlatforms                  BlogPlatform[]
  user                           User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills                         CandidateSkill[]
  CertificationVerification      CertificationVerification[]
  certifications                 Certification[]
  codingPlatforms                CodingPlatformProfile[]
  customPortfolioLinks           CustomPortfolioLink[]
  designPortfolios               DesignPortfolio[]
  EducationVerification          EducationVerification[]
  educations                     Education[]
  EmailDomainVerification        EmailDomainVerification[]
  ExternalAssessment             ExternalAssessment[]
  githubProfile                  GithubProfile?
  gitlabProfile                  GitLabProfile?
  kaggleProfile                  KaggleProfile?
  LinkedInEmploymentVerification LinkedInEmploymentVerification[]
  linkedInProfile                LinkedInProfile?
  ManagerReference               ManagerReference[]
  notionPortfolio                NotionPortfolio?
  onlineCourseProfiles           OnlineCourseProfile[]
  PeerEndorsement                PeerEndorsement[]
  versions                       ProfileVersion[]
  projects                       Project[]
  stackOverflowProfile           StackOverflowProfile?
  TrustScore                     TrustScore?
  VerifiedBadge                  VerifiedBadge[]
  workExperiences                WorkExperience[]

  @@map("candidate_profiles")
}

model RecruiterProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  companyName        String
  companyWebsite     String?
  companySize        String?
  industry           String?
  companyDescription String?
  title              String?
  department         String?
  yearsOfExperience  Int      @default(0)
  specializations    String[] @default([])
  hiringRegions      String[] @default([])
  activeJobs         Int      @default(0)
  totalHires         Int      @default(0)
  successRate        Float    @default(0.0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("recruiter_profiles")
}

model WorkExperience {
  id                 String             @id @default(uuid())
  profileId          String
  companyName        String
  companyLogo        String?
  companyWebsite     String?
  companyLinkedin    String?
  companySize        String?
  industry           String?
  title              String
  employmentType     EmploymentType
  department         String?
  location           String?
  isRemote           Boolean            @default(false)
  startDate          DateTime
  endDate            DateTime?
  isCurrent          Boolean            @default(false)
  description        String?
  responsibilities   String[]           @default([])
  achievements       String[]           @default([])
  technologies       String[]           @default([])
  skills             String[]           @default([])
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  verificationMethod String?
  referenceEmail     String?
  teamSize           Int?
  budget             Float?
  revenue            Float?
  displayOrder       Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  profile            CandidateProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([startDate])
  @@index([isCurrent])
  @@index([verificationStatus])
  @@map("work_experiences")
}

model Education {
  id                  String             @id @default(uuid())
  profileId           String
  institutionName     String
  institutionLogo     String?
  institutionWebsite  String?
  institutionLocation String?
  institutionType     String?
  degree              String
  fieldOfStudy        String
  specialization      String?
  startDate           DateTime
  endDate             DateTime?
  isOngoing           Boolean            @default(false)
  grade               String?
  gradeScale          String?
  activities          String[]           @default([])
  achievements        String[]           @default([])
  thesis              String?
  thesisDescription   String?
  courseProjects      Json?
  verificationStatus  VerificationStatus @default(PENDING)
  verifiedAt          DateTime?
  verificationMethod  String?
  certificateUrl      String?
  displayOrder        Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  profile             CandidateProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([startDate])
  @@index([verificationStatus])
  @@map("educations")
}

model Certification {
  id                  String             @id @default(uuid())
  profileId           String
  name                String
  issuingOrganization String
  organizationLogo    String?
  organizationWebsite String?
  credentialId        String?
  credentialUrl       String?
  issueDate           DateTime
  expirationDate      DateTime?
  doesNotExpire       Boolean            @default(false)
  description         String?
  skills              String[]           @default([])
  verificationStatus  VerificationStatus @default(PENDING)
  verifiedAt          DateTime?
  verificationMethod  String?
  displayOrder        Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  profile             CandidateProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([issueDate])
  @@index([expirationDate])
  @@index([verificationStatus])
  @@map("certifications")
}

model CandidateSkill {
  id                 String                @id @default(uuid())
  profileId          String
  name               String
  category           String?
  subcategory        String?
  proficiencyLevel   Int                   @default(5)
  proficiencyLabel   SkillProficiencyLevel @default(INTERMEDIATE)
  yearsOfExperience  Float?
  lastUsed           DateTime?
  projects           String[]              @default([])
  certifications     String[]              @default([])
  isVerified         Boolean               @default(false)
  verifiedAt         DateTime?
  verificationMethod String?
  endorsementCount   Int                   @default(0)
  tags               String[]              @default([])
  isPrimary          Boolean               @default(false)
  displayOrder       Int                   @default(0)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  profile            CandidateProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  endorsements       SkillEndorsement[]

  @@unique([profileId, name])
  @@index([profileId])
  @@index([category])
  @@index([proficiencyLevel])
  @@index([isPrimary])
  @@map("candidate_skills")
}

model SkillEndorsement {
  id               String         @id @default(uuid())
  skillId          String
  endorserId       String
  endorserName     String
  endorserTitle    String?
  endorserCompany  String?
  endorserLinkedin String?
  relationship     String?
  comment          String?
  rating           Int?
  isVerified       Boolean        @default(false)
  verifiedAt       DateTime?
  createdAt        DateTime       @default(now())
  skill            CandidateSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, endorserId])
  @@index([skillId])
  @@index([endorserId])
  @@map("skill_endorsements")
}

model Project {
  id               String           @id @default(uuid())
  profileId        String
  title            String
  shortDescription String?
  description      String?
  projectType      String?
  status           String?
  startDate        DateTime?
  endDate          DateTime?
  isOngoing        Boolean          @default(false)
  technologies     String[]         @default([])
  frameworks       String[]         @default([])
  languages        String[]         @default([])
  tools            String[]         @default([])
  repositoryUrl    String?
  liveUrl          String?
  demoUrl          String?
  documentationUrl String?
  thumbnailUrl     String?
  images           String[]         @default([])
  videos           String[]         @default([])
  role             String?
  teamSize         Int?
  contributions    String[]         @default([])
  impact           String?
  users            Int?
  downloads        Int?
  stars            Int?
  forks            Int?
  workExperienceId String?
  isPublic         Boolean          @default(true)
  isFeatured       Boolean          @default(false)
  displayOrder     Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  profile          CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([projectType])
  @@index([isFeatured])
  @@index([isPublic])
  @@map("projects")
}

model Achievement {
  id              String           @id @default(uuid())
  profileId       String
  title           String
  description     String?
  type            String
  category        String?
  badgeIcon       String?
  badgeColor      String?
  points          Int              @default(0)
  currentProgress Int              @default(0)
  targetProgress  Int              @default(1)
  isCompleted     Boolean          @default(false)
  earnedAt        DateTime?
  createdAt       DateTime         @default(now())
  profile         CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, type, category])
  @@index([profileId])
  @@index([type])
  @@index([isCompleted])
  @@map("achievements")
}

model ProfileVersion {
  id              String           @id @default(uuid())
  profileId       String
  versionNumber   Int
  versionLabel    String?
  profileSnapshot Json
  changes         Json?
  changeSummary   String?
  createdBy       String?
  createdAt       DateTime         @default(now())
  profile         CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, versionNumber])
  @@index([profileId])
  @@index([createdAt])
  @@map("profile_versions")
}

model GithubProfile {
  id                    String             @id @default(uuid())
  profileId             String             @unique
