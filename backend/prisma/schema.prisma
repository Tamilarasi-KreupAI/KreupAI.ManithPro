// ============================================

enum VerificationRequestStatus {
  PENDING
  SENT
  COMPLETED
  EXPIRED
  DECLINED
  FAILED
}

enum ReferenceRequestStatus {
  PENDING
  SENT
  IN_PROGRESS
  COMPLETED
  DECLINED
  EXPIRED
}

enum EndorsementRequestStatus {
  PENDING
  SENT
  ACCEPTED
