// Prisma schema for Recruitment Portal

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CANDIDATE
  RECRUITER
  ADMIN
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  REMOTE
}

enum JobStatus {
  OPEN
  CLOSED
  DRAFT
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  SHORTLISTED
  INTERVIEW_SCHEDULED
  REJECTED
  ACCEPTED
  WITHDRAWN
}

enum InterviewType {
  PHONE_SCREEN
  TECHNICAL
  HR
  FINAL
  PEER
  CULTURAL_FIT
  OTHER
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
  NO_SHOW
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

enum NotificationType {
  APPLICATION_STATUS
  INTERVIEW_SCHEDULED
  INTERVIEW_REMINDER
  MESSAGE_RECEIVED
  JOB_POSTED
  APPLICATION_RECEIVED
  OFFER_MADE
  OFFER_ACCEPTED
  OFFER_REJECTED
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  password      String
  firstName     String
  lastName      String
  role          UserRole      @default(CANDIDATE)
  phone         String?
  bio           String?
  skills        String[]      @default([])
  experience    Int?          // years of experience
  education     String?
  location      String?
  linkedIn      String?
  portfolio     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  postedJobs           Job[]           @relation("PostedJobs")
  applications         Application[]
  savedJobs            SavedJob[]
  scheduledInterviews  Interview[]     @relation("ScheduledInterviews")
  candidateInterviews  Interview[]     @relation("CandidateInterviews")
  sentMessages         Message[]       @relation("SentMessages")
  receivedMessages     Message[]       @relation("ReceivedMessages")
  notifications        Notification[]
  candidateProfile     CandidateProfile?

  @@map("users")
}

model Job {
  id              String        @id @default(uuid())
  title           String
  description     String
  requirements    String[]      @default([])
  responsibilities String[]     @default([])
  location        String
  type            JobType
  salary          String?
  salaryMin       Int?
  salaryMax       Int?
  benefits        String[]      @default([])
  skills          String[]      @default([])
  experience      String?       // e.g., "2-5 years"
  education       String?
  status          JobStatus     @default(OPEN)
  positions       Int           @default(1)
  deadline        DateTime?

  // Company Information
  companyName     String
  companyDescription String?
  companyWebsite  String?
  companyLogo     String?
  companySize     String?       // e.g., "1-50", "51-200", "201-500", "500+"
  companyIndustry String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  postedById      String
  postedBy        User          @relation("PostedJobs", fields: [postedById], references: [id], onDelete: Cascade)
  applications    Application[]
  savedBy         SavedJob[]

  @@index([status, createdAt])
  @@index([type])
  @@index([companyName])
  @@map("jobs")
}

model Application {
  id            String            @id @default(uuid())
  resume        String            // file path
  coverLetter   String?
  status        ApplicationStatus @default(PENDING)
  notes         String?           // recruiter notes
  appliedAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // Relations
  jobId         String
  job           Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId   String
  candidate     User              @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interviews    Interview[]
  messages      Message[]

  @@unique([jobId, candidateId]) // One application per job per candidate
  @@index([status])
  @@index([candidateId])
  @@map("applications")
}

model SavedJob {
  id          String   @id @default(uuid())
  userId      String
  jobId       String
  savedAt     DateTime @default(now())

  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId]) // One save per job per user
  @@index([userId])
  @@map("saved_jobs")
}

model Interview {
  id              String          @id @default(uuid())
  type            InterviewType
  status          InterviewStatus @default(SCHEDULED)
  scheduledAt     DateTime
  endTime         DateTime
  timeZone        String?         // e.g., "America/New_York"
  meetingLink     String?         // Video call link (Zoom, Google Meet, etc.)
  location        String?         // Physical location if in-person
  instructions    String?         // Instructions for the candidate
  notes           String?         // Internal notes from recruiter
  feedback        String?         // Post-interview feedback
  rating          Int?            // 1-5 rating
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  applicationId   String
  application     Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scheduledById   String
  scheduledBy     User            @relation("ScheduledInterviews", fields: [scheduledById], references: [id])
  candidateId     String
  candidate       User            @relation("CandidateInterviews", fields: [candidateId], references: [id])

  @@index([status, scheduledAt])
  @@index([candidateId])
  @@index([scheduledById])
  @@map("interviews")
}

model Message {
  id              String        @id @default(uuid())
  content         String
  status          MessageStatus @default(SENT)
  attachments     String[]      @default([])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  senderId        String
  sender          User          @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId      String
  receiver        User          @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  applicationId   String?
  application     Application?  @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId])
  @@index([applicationId])
  @@index([createdAt])
  @@map("messages")
}

model Notification {
  id          String            @id @default(uuid())
  type        NotificationType
  title       String
  message     String
  link        String?           // Link to relevant page
  isRead      Boolean           @default(false)
  createdAt   DateTime          @default(now())

  // Relations
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================
// ADMIN MODULE MODELS
// ============================================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  RESTORE
  EXPORT
  IMPORT
}

enum SubscriptionPlan {
  FREE
  BASIC
  PROFESSIONAL
  ENTERPRISE
  CUSTOM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  SUSPENDED
  TRIAL
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  PAYPAL
  STRIPE
  BANK_TRANSFER
  OTHER
}

enum ErrorLevel {
  INFO
  WARNING
  ERROR
  CRITICAL
}

// Audit Log Model - Track all system changes
model AuditLog {
  id            String      @id @default(uuid())
  action        AuditAction
  entity        String      // e.g., "User", "Job", "Application"
  entityId      String?     // ID of the affected entity
  changes       Json?       // JSON object with before/after values
  ipAddress     String?
  userAgent     String?
  metadata      Json?       // Additional context
  createdAt     DateTime    @default(now())

  // Relations
  userId        String?
  performedBy   String?     // User name or email

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// FAQ Model - Frequently Asked Questions
model FAQ {
  id            String      @id @default(uuid())
  question      String
  answer        String
  category      String?
  order         Int         @default(0)
  isPublished   Boolean     @default(true)
  views         Int         @default(0)
  helpful       Int         @default(0)
  notHelpful    Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([category])
  @@index([isPublished])
  @@map("faqs")
}

// Email Template Model - Reusable email templates
model EmailTemplate {
  id            String      @id @default(uuid())
  name          String      @unique
  subject       String
  body          String
  variables     String[]    @default([]) // Available variables like {firstName}, {jobTitle}
  category      String?     // e.g., "Application", "Interview", "Offer"
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([category])
  @@index([isActive])
  @@map("email_templates")
}

// Notification Template Model - Reusable notification templates
model NotificationTemplate {
  id            String      @id @default(uuid())
  name          String      @unique
  title         String
  body          String
  type          NotificationType
  variables     String[]    @default([])
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([type])
  @@index([isActive])
  @@map("notification_templates")
}

// Static Page Model - CMS for static pages
model StaticPage {
  id            String      @id @default(uuid())
  slug          String      @unique
  title         String
  content       String
  metaTitle     String?
  metaDescription String?
  isPublished   Boolean     @default(true)
  publishedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([slug])
  @@index([isPublished])
  @@map("static_pages")
}

// Help Article Model - Knowledge base articles
model HelpArticle {
  id            String      @id @default(uuid())
  title         String
  slug          String      @unique
  content       String
  category      String
  tags          String[]    @default([])
  views         Int         @default(0)
  helpful       Int         @default(0)
  notHelpful    Int         @default(0)
  isPublished   Boolean     @default(true)
  publishedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([category])
  @@index([slug])
  @@index([isPublished])
  @@map("help_articles")
}

// Subscription Model - User/Company subscriptions
model Subscription {
  id            String              @id @default(uuid())
  plan          SubscriptionPlan
  status        SubscriptionStatus  @default(TRIAL)
  startDate     DateTime            @default(now())
  endDate       DateTime?
  trialEndDate  DateTime?
  maxJobs       Int?                // Limit based on plan
  maxUsers      Int?                // Limit based on plan
  features      Json?               // JSON object with enabled features
  price         Float
  billingCycle  String              // e.g., "monthly", "yearly"
  autoRenew     Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  // Relations
  userId        String?             @unique
  companyId     String?             // For company-wide subscriptions
  payments      Payment[]
  invoices      Invoice[]

  @@index([userId])
  @@index([status])
  @@index([endDate])
  @@map("subscriptions")
}

// Payment Model - Payment records
model Payment {
  id                String        @id @default(uuid())
  amount            Float
  currency          String        @default("USD")
  status            PaymentStatus @default(PENDING)
  method            PaymentMethod
  transactionId     String?       @unique // External payment gateway transaction ID
  stripePaymentId   String?       // Stripe-specific ID
  paypalOrderId     String?       // PayPal-specific ID
  cardLast4         String?
  cardBrand         String?       // e.g., "Visa", "Mastercard"
  metadata          Json?
  failureReason     String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  subscriptionId    String
  subscription      Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  invoiceId         String?       @unique
  invoice           Invoice?      @relation(fields: [invoiceId], references: [id])

  @@index([subscriptionId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

// Invoice Model - Billing invoices
model Invoice {
  id                String        @id @default(uuid())
  invoiceNumber     String        @unique
  amount            Float
  tax               Float         @default(0)
  discount          Float         @default(0)
  total             Float
  currency          String        @default("USD")
  status            PaymentStatus @default(PENDING)
  dueDate           DateTime?
  paidAt            DateTime?
  items             Json          // Line items with descriptions and amounts
  billingAddress    Json?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  subscriptionId    String
  subscription      Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  payment           Payment?

  @@index([subscriptionId])
  @@index([status])
  @@index([invoiceNumber])
  @@index([createdAt])
  @@map("invoices")
}

// Error Log Model - System error tracking
model ErrorLog {
  id            String      @id @default(uuid())
  level         ErrorLevel  @default(ERROR)
  message       String
  stack         String?
  context       Json?       // Additional context
  endpoint      String?     // API endpoint where error occurred
  method        String?     // HTTP method
  statusCode    Int?
  userId        String?
  ipAddress     String?
  userAgent     String?
  resolved      Boolean     @default(false)
  resolvedAt    DateTime?
  resolvedBy    String?
  notes         String?
  createdAt     DateTime    @default(now())

  @@index([level])
  @@index([resolved])
  @@index([createdAt])
  @@index([userId])
  @@map("error_logs")
}

// System Config Model - Application configuration
model SystemConfig {
  id            String      @id @default(uuid())
  key           String      @unique
  value         String
  type          String      @default("string") // string, number, boolean, json
  category      String?     // e.g., "email", "security", "features"
  description   String?
  isPublic      Boolean     @default(false) // Can be accessed by frontend
  updatedAt     DateTime    @updatedAt
  updatedBy     String?     // User ID who updated

  @@index([category])
  @@index([isPublic])
  @@map("system_configs")
}

// ============================================
// CV-LESS RECRUITMENT & RICH PROFILES (Features 1.1.1 - 1.1.5)
// ============================================

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum SkillProficiencyLevel {
  BEGINNER        // 1-2
  ELEMENTARY      // 3-4
  INTERMEDIATE    // 5-6
  ADVANCED        // 7-8
  EXPERT          // 9-10
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  FREELANCE
  INTERNSHIP
  APPRENTICESHIP
  SELF_EMPLOYED
}

// 1.1.1 - Structured Profile Builder
model CandidateProfile {
  id                    String              @id @default(uuid())
  userId                String              @unique

  // Professional Summary
  headline              String?             // Professional headline (e.g., "Senior Software Engineer")
  summary               String?             // Professional summary/bio

  // Personal Information
  dateOfBirth           DateTime?
  nationality           String?
  languages             Json?               // Array of {language, proficiency}

  // Contact & Location
  address               String?
  city                  String?
  state                 String?
  country               String?
  zipCode               String?
  preferredLocation     String[]            @default([])
  willingToRelocate     Boolean             @default(false)
  remotePreference      String?             // "remote", "hybrid", "onsite", "flexible"

  // Career Preferences
  expectedSalary        Float?
  expectedSalaryCurrency String?            @default("USD")
  noticePeriod          String?             // e.g., "2 weeks", "1 month", "immediate"
  availableFrom         DateTime?
  jobTypes              String[]            @default([]) // Array of preferred job types
  industries            String[]            @default([]) // Preferred industries

  // Profile Completeness
  completenessScore     Int                 @default(0) // 0-100
  lastCompletedSection  String?

  // Social Links
  website               String?
  github                String?
  linkedin              String?
  twitter               String?
  stackoverflow         String?
  dribbble              String?
  behance               String?
  medium                String?
  kaggle                String?

  // Profile Settings
  isPublic              Boolean             @default(true)
  allowMessages         Boolean             @default(true)
  showSalaryExpectation Boolean             @default(false)

  // Timestamps
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  workExperiences       WorkExperience[]
  educations            Education[]
  certifications        Certification[]
  skills                CandidateSkill[]
  projects              Project[]
  achievements          Achievement[]

  @@index([userId])
  @@index([completenessScore])
  @@index([isPublic])
  @@map("candidate_profiles")
}

// 1.1.3 - Experience Timeline
model WorkExperience {
  id                    String              @id @default(uuid())
  profileId             String

  // Company Information
  companyName           String
  companyLogo           String?
  companyWebsite        String?
  companyLinkedin       String?
  companySize           String?             // e.g., "1-50", "51-200", "201-500", "500+"
  industry              String?

  // Role Information
  title                 String
  employmentType        EmploymentType
  department            String?

  // Location
  location              String?
  isRemote              Boolean             @default(false)

  // Duration
  startDate             DateTime
  endDate               DateTime?
  isCurrent             Boolean             @default(false)

  // Details
  description           String?             // Rich text description
  responsibilities      String[]            @default([])
  achievements          String[]            @default([])

  // Technologies & Skills Used
  technologies          String[]            @default([])
  skills                String[]            @default([])

  // Verification
  verificationStatus    VerificationStatus  @default(PENDING)
  verifiedAt            DateTime?
  verificationMethod    String?             // "linkedin", "email", "reference"
  referenceEmail        String?             // Manager/colleague email for verification

  // Metrics & Impact
  teamSize              Int?                // Size of team managed
  budget                Float?              // Budget managed
  revenue               Float?              // Revenue generated

  // Display Order
  displayOrder          Int                 @default(0)

  // Timestamps
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  profile               CandidateProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([startDate])
  @@index([isCurrent])
  @@index([verificationStatus])
  @@map("work_experiences")
}

// 1.1.4 - Education & Certifications Hub
model Education {
  id                    String              @id @default(uuid())
  profileId             String

  // Institution
  institutionName       String
  institutionLogo       String?
  institutionWebsite    String?
  institutionLocation   String?
  institutionType       String?             // "university", "college", "online", "bootcamp"

  // Degree/Program
  degree                String              // e.g., "Bachelor of Science", "Master of Arts"
  fieldOfStudy          String              // e.g., "Computer Science"
  specialization        String?             // Minor or focus area

  // Duration
  startDate             DateTime
  endDate               DateTime?
  isOngoing             Boolean             @default(false)

  // Academic Details
  grade                 String?             // e.g., "3.8 GPA", "First Class Honours"
  gradeScale            String?             // e.g., "4.0", "percentage"
  activities            String[]            @default([]) // Clubs, societies
  achievements          String[]            @default([]) // Dean's list, scholarships

  // Projects & Thesis
  thesis                String?             // Thesis title
  thesisDescription     String?
  courseProjects        Json?               // Array of {name, description, technologies}

  // Verification
  verificationStatus    VerificationStatus  @default(PENDING)
  verifiedAt            DateTime?
  verificationMethod    String?
  certificateUrl        String?             // URL to degree certificate

  // Display Order
  displayOrder          Int                 @default(0)

  // Timestamps
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  profile               CandidateProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([startDate])
  @@index([verificationStatus])
  @@map("educations")
}

model Certification {
  id                    String              @id @default(uuid())
  profileId             String

  // Certification Details
  name                  String
  issuingOrganization   String
  organizationLogo      String?
  organizationWebsite   String?

  // Credential
  credentialId          String?
  credentialUrl         String?             // URL to verify certification

  // Duration
  issueDate             DateTime
  expirationDate        DateTime?
  doesNotExpire         Boolean             @default(false)

  // Details
  description           String?
  skills                String[]            @default([])

  // Verification
  verificationStatus    VerificationStatus  @default(PENDING)
  verifiedAt            DateTime?
  verificationMethod    String?             // "api", "manual", "url"

  // Display Order
  displayOrder          Int                 @default(0)

  // Timestamps
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  profile               CandidateProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([issueDate])
  @@index([expirationDate])
  @@index([verificationStatus])
  @@map("certifications")
}

// 1.1.2 - Dynamic Skills Matrix
model CandidateSkill {
  id                    String              @id @default(uuid())
  profileId             String

  // Skill Information
  name                  String
  category              String?             // e.g., "Programming Languages", "Frameworks", "Soft Skills"
  subcategory           String?             // e.g., "Frontend", "Backend", "Database"

  // Proficiency
  proficiencyLevel      Int                 @default(5) // 1-10 scale
  proficiencyLabel      SkillProficiencyLevel @default(INTERMEDIATE)
  yearsOfExperience     Float?

  // Last Used
  lastUsed              DateTime?

  // Evidence
  projects              String[]            @default([]) // Project IDs where skill was used
  certifications        String[]            @default([]) // Certification IDs proving skill

  // Verification & Endorsements
  isVerified            Boolean             @default(false)
  verifiedAt            DateTime?
  verificationMethod    String?             // "assessment", "certification", "endorsement"
  endorsementCount      Int                 @default(0)

  // Tags
  tags                  String[]            @default([])

  // Display Order
  isPrimary             Boolean             @default(false) // Featured skill
  displayOrder          Int                 @default(0)

  // Timestamps
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  profile               CandidateProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  endorsements          SkillEndorsement[]

  @@unique([profileId, name])
  @@index([profileId])
  @@index([category])
  @@index([proficiencyLevel])
  @@index([isPrimary])
  @@map("candidate_skills")
}

model SkillEndorsement {
  id                    String              @id @default(uuid())
  skillId               String

  // Endorser Information
  endorserId            String              // User ID of endorser
  endorserName          String
  endorserTitle         String?
  endorserCompany       String?
  endorserLinkedin      String?
  relationship          String?             // "colleague", "manager", "client", "mentor"

  // Endorsement Details
  comment               String?
  rating                Int?                // Optional 1-5 rating

  // Verification
  isVerified            Boolean             @default(false)
  verifiedAt            DateTime?

  // Timestamps
  createdAt             DateTime            @default(now())

  // Relations
  skill                 CandidateSkill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, endorserId])
  @@index([skillId])
  @@index([endorserId])
  @@map("skill_endorsements")
}

// 1.1.5 - Project Portfolio
model Project {
  id                    String              @id @default(uuid())
  profileId             String

  // Project Information
  title                 String
  shortDescription      String?             // Brief one-liner
  description           String?             // Full description (rich text)

  // Project Type & Status
  projectType           String?             // "personal", "professional", "open-source", "freelance", "academic"
  status                String?             // "completed", "in-progress", "on-hold", "archived"

  // Duration
  startDate             DateTime?
  endDate               DateTime?
  isOngoing             Boolean             @default(false)

  // Technical Details
  technologies          String[]            @default([])
  frameworks            String[]            @default([])
  languages             String[]            @default([])
  tools                 String[]            @default([])

  // Links
  repositoryUrl         String?             // GitHub, GitLab, etc.
  liveUrl               String?             // Deployed project URL
  demoUrl               String?             // Demo video URL
  documentationUrl      String?

  // Media
  thumbnailUrl          String?
  images                String[]            @default([])
  videos                String[]            @default([])

  // Role & Team
  role                  String?             // Your role in the project
  teamSize              Int?
  contributions         String[]            @default([]) // Specific contributions

  // Impact & Metrics
  impact                String?             // Description of impact
  users                 Int?                // Number of users
  downloads             Int?                // Number of downloads
  stars                 Int?                // GitHub stars
  forks                 Int?                // GitHub forks

  // Associated Work Experience
  workExperienceId      String?             // Link to work experience if professional project

  // Visibility
  isPublic              Boolean             @default(true)
  isFeatured            Boolean             @default(false)

  // Display Order
  displayOrder          Int                 @default(0)

  // Timestamps
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  profile               CandidateProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([projectType])
  @@index([isFeatured])
  @@index([isPublic])
  @@map("projects")
}

// Achievement Badges System (bonus feature 1.1.6 preview)
model Achievement {
  id                    String              @id @default(uuid())
  profileId             String

  // Achievement Details
  title                 String
  description           String?
  type                  String              // "profile", "activity", "skill", "milestone"
  category              String?             // e.g., "profile_completion", "applications", "interviews"

  // Badge Information
  badgeIcon             String?
  badgeColor            String?
  points                Int                 @default(0)

  // Progress (for progressive achievements)
  currentProgress       Int                 @default(0)
  targetProgress        Int                 @default(1)
  isCompleted           Boolean             @default(false)

  // Timestamps
  earnedAt              DateTime?
  createdAt             DateTime            @default(now())

  // Relations
  profile               CandidateProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, type, category])
  @@index([profileId])
  @@index([type])
  @@index([isCompleted])
  @@map("achievements")
}
