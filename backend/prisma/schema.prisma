  requiredSkills        String[]            @default([])
  location              String
  experienceLevel       String              // ENTRY, MID, SENIOR, LEAD, EXECUTIVE
  industry              String?

  // Availability Metrics
  availabilityScore     Float               // 0-100 (higher = easier to find)
  difficultyLevel       String              // VERY_EASY, EASY, MODERATE, HARD, VERY_HARD
  estimatedCandidatePool Int                // Estimated available candidates

  // Supply/Demand
  talentSupply          String              // ABUNDANT, ADEQUATE, LIMITED, SCARCE
  hiringDemand          String              // LOW, MODERATE, HIGH, EXTREME
  supplyDemandRatio     Float               // > 1 = more supply

  // Competition
  competitorActivity    String              // LOW, MODERATE, HIGH, INTENSE
  competingOpenings     Int?                // Similar jobs in market
  marketShare           Float?              // Company's hiring share

  // Salary Intelligence
  marketSalaryMin       Float?
  marketSalaryMax       Float?
  marketSalaryMedian    Float?
  salaryTrend           String              // DECREASING, STABLE, INCREASING, RAPIDLY_INCREASING

  // Geographic Analysis
  locationPremium       Float?              // Location salary premium
  remoteAvailability    Float?              // % willing to work remote
  relocationWillingness Float?              // % willing to relocate

  // Skill Scarcity
  scarcestSkills        Json                // Most hard to find skills
  commonSkills          Json                // Easily found skills
  skillPremiums         Json?               // Premium for specific skills

  // Recommendations
  sourcingRecommendations Json              // Where to find talent
  compensationGuidance  Json                // Comp recommendations
  timelineExpectation   Int                 // Expected days to hire

  // Metadata
  analyzedAt            DateTime            @default(now())
  dataFreshness         DateTime            // When underlying data was collected
  updatedAt             DateTime            @updatedAt

  @@index([companyId])
  @@index([jobId])
  @@index([availabilityScore])
  @@index([difficultyLevel])
  @@map("market_availability_analyses")
}

// 5.2.7 Salary Trend Prediction
model SalaryTrendPrediction {
  id                    String              @id @default(uuid())
  companyId             String

  // Target
  roleTitle             String
  location              String
  experienceLevel       String
  industry              String?

  // Current State
  currentMedian         Float
  currentMin            Float
  currentMax            Float
  currentPercentile25   Float?
  currentPercentile75   Float?

  // Predictions
  prediction3Mo         Json                // { median, min, max, changePercent }
  prediction6Mo         Json
  prediction1Yr         Json
  prediction2Yr         Json?

  // Trend Analysis
  trendDirection        String              // DECLINING, STABLE, GROWING, SURGING
  annualGrowthRate      Float               // Expected annual % change
  volatility            String              // LOW, MODERATE, HIGH

  // Influencing Factors
  demandImpact          Float               // Impact of demand changes
  supplyImpact          Float               // Impact of supply changes
  economicImpact        Float               // Economic factors impact
  technologyImpact      Float               // Tech changes impact
  regulatoryImpact      Float?              // Regulatory changes

  // Market Context
  industryComparison    Json                // How this role compares
  locationComparison    Json                // Geographic comparison
  experienceProgression Json                // Salary by experience level

  // Recommendations
  competitiveRange      Json                // { low, target, high }
  budgetGuidance        String?             @db.Text
  timingRecommendation  String?             // Best time to hire

  // Metadata
  predictedAt           DateTime            @default(now())
  modelVersion          String              @default("1.0")
  dataSource            String?
  updatedAt             DateTime            @updatedAt

  @@index([companyId])
  @@index([roleTitle])
  @@index([location])
  @@map("salary_trend_predictions")
}

// 5.2.8 Pipeline Health Prediction
model PipelineHealthPrediction {
  id                    String              @id @default(uuid())
  companyId             String
  jobId                 String?             // null = overall pipeline

  // Current State
  currentCandidates     Int                 // Total in pipeline
  byStage               Json                // Candidates per stage
  stageConversions      Json                // Conversion rates by stage

  // Health Score
  overallHealthScore    Float               // 0-100
  healthGrade           String              // A, B, C, D, F
  healthTrend           String              // IMPROVING, STABLE, DECLINING

  // Predictions
  predictedHires        Int                 // Expected hires from current pipeline
  predictedDropouts     Int                 // Expected dropouts
  fillProbability       Float               // Probability of filling role
  timeToFill            Int?                // Predicted days

  // Bottleneck Analysis
  bottleneckStages      Json                // Stages with issues
  stageRisks            Json                // Risk by stage
  conversionConcerns    Json                // Problematic conversions

  // Gap Analysis
  candidateGap          Int                 // Needed candidates
  qualityGap            Float               // Quality score gap
  diversityGap          Json?               // Diversity metrics gap

  // Velocity Metrics
  averageTimeInStage    Json                // Avg time per stage
  velocityTrend         String              // FASTER, STABLE, SLOWER
  stalledCandidates     Int                 // Candidates stuck

  // Recommendations
  urgentActions         Json                // Immediate actions needed
  sourcingNeeds         Json                // Sourcing recommendations
  processImprovements   Json                // Process optimization

  // Forecast
  weeklyForecast        Json                // Next 4 weeks prediction
  hireByDateProbability Json                // P(hire by date) for key dates

  // Metadata
  analyzedAt            DateTime            @default(now())
  nextUpdateAt          DateTime?
  updatedAt             DateTime            @updatedAt

  @@index([companyId])
  @@index([jobId])
  @@index([overallHealthScore])
  @@map("pipeline_health_predictions")
}

// Prediction Model Configuration
model PredictionModelConfig {
  id                    String              @id @default(uuid())
  companyId             String
  modelType             String              // HIRING_SUCCESS, TIME_TO_HIRE, OFFER_ACCEPTANCE, etc.

  // Model Settings
  modelVersion          String              @default("1.0")
  isEnabled             Boolean             @default(true)
  confidenceThreshold   Float               @default(0.7)

  // Feature Weights
  featureWeights        Json                // Weight configuration
  enabledFeatures       String[]            @default([])
  disabledFeatures      String[]            @default([])

  // Calibration
  calibrationDate       DateTime?
  calibrationData       Json?
  accuracyMetrics       Json?               // Historical accuracy

  // Thresholds
  actionThresholds      Json                // When to trigger actions
  alertThresholds       Json                // When to send alerts

  // Custom Rules
  customRules           Json?               // Company-specific rules
  exclusions            Json?               // What to exclude

  // Metadata
  createdById           String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([companyId, modelType])
  @@index([companyId])
  @@map("prediction_model_configs")
}

// Prediction Audit Log
model PredictionAuditLog {
  id                    String              @id @default(uuid())
  companyId             String
  predictionType        String              // Which prediction type
