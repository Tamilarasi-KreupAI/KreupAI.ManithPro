// 1.3.7 - Background Check Integration
model BackgroundCheck {
  id                    String              @id @default(uuid())
  profileId             String

  // Background Check Provider
  provider              String              // "checkr", "sterling", "goodhire", "hireright"
  providerCheckId       String?             @unique // External ID from provider

  // Check Details
  checkType             BackgroundCheckType @default(STANDARD)
  packageName           String?             // Provider's package name
  includedChecks        String[]            @default([]) // List of included check types

  // Request Details
  requestId             String?             @unique
  status                BackgroundCheckStatus @default(NOT_STARTED)
  requestedAt           DateTime?
  requestedBy           String?             // Recruiter who requested

  // Candidate Consent
  consentGiven          Boolean             @default(false)
  consentGivenAt        DateTime?
  consentDocument       String?             // Signed consent PDF

  // Check Progress
  completedChecks       Int                 @default(0)
  totalChecks           Int                 @default(0)
  currentStep           String?             // Current step in process

  // Results Summary (high-level, no sensitive details)
  overallResult         String?             // "clear", "consider", "alert", "pending"
  completedAt           DateTime?
  reportUrl             String?             // Link to full report in provider's system

  // Individual Check Results (sanitized)
  checkResults          Json?               // Array of {checkType, status, completedAt}

  // Adjudication
  adjudicationStatus    String?             // "pending", "approved", "declined", "escalated"
  adjudicatedAt         DateTime?
  adjudicatedBy         String?
  adjudicationNotes     String?

  // Validity
  validUntil            DateTime?           // When check expires
  canBeShared           Boolean             @default(true)

  // Webhook/Notification
  webhookUrl            String?
  lastWebhookAt         DateTime?

  // Errors
  errorMessage          String?
  errorCode             String?

  // Timestamps
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  profile               CandidateProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([status])
  @@index([provider])
  @@map("background_checks")
}

// 1.3.9 - Verified Badge System
model VerifiedBadge {
  id                    String              @id @default(uuid())
  profileId             String

  // Badge Info
  badgeType             String              // "email", "linkedin", "education", "employment", "certification", "background", "identity", "premium"
  badgeName             String
  badgeDescription      String?
  badgeIcon             String?
  badgeColor            String?

  // Verification Details
  verificationSource    String              // Source of verification
  verificationId        String?             // ID of the verification that granted this badge
  verificationType      String?             // Type of verification

  // Badge Status
  isActive              Boolean             @default(true)
  earnedAt              DateTime            @default(now())
  expiresAt             DateTime?

  // Display Settings
  showOnProfile         Boolean             @default(true)
  displayOrder          Int                 @default(0)

  // Metadata
  metadata              Json?               // Additional badge-specific data

  // Timestamps
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  profile               CandidateProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, badgeType])
  @@index([profileId])
  @@index([badgeType])
  @@map("verified_badges")
}

// 1.4.1 - Built-in Coding Challenges
model CodingChallenge {
  id                    String              @id @default(uuid())

  // Challenge Info
  title                 String
  slug                  String              @unique
  description           String              // Full description (markdown)
  shortDescription      String?             // Brief summary

  // Difficulty & Categories
  difficulty            QuizDifficulty      @default(INTERMEDIATE)
  category              String              // "algorithms", "data-structures", "system-design", "frontend", "backend"
  subcategory           String?
  tags                  String[]            @default([])

  // Languages
  supportedLanguages    String[]            @default([]) // ["javascript", "python", "java", "cpp"]
  defaultLanguage       String              @default("javascript")

  // Problem Definition
  problemStatement      String              // The actual problem to solve
  constraints           String[]            @default([])
  hints                 String[]            @default([])
  examples              Json                // Array of {input, output, explanation}

  // Test Cases
  sampleTestCases       Json                // Public test cases
  hiddenTestCases       Json                // Private test cases for grading
  totalTestCases        Int                 @default(0)

  // Starter Code
  starterCode           Json                // {language: code} for each supported language
  solutionCode          Json?               // {language: code} solution for reference

  // Time & Scoring
  timeLimitMinutes      Int                 @default(60)
  maxAttempts           Int?                // null = unlimited
  pointsValue           Int                 @default(100)

  // Grading Settings
  autoGrade             Boolean             @default(true)
  partialCredit         Boolean             @default(true)
  memoryLimitMB         Int                 @default(256)
  executionTimeLimitMs  Int                 @default(5000)

  // Status
  status                ChallengeStatus     @default(DRAFT)
  publishedAt           DateTime?

  // Statistics
  totalAttempts         Int                 @default(0)
  totalCompletions      Int                 @default(0)
  avgCompletionTime     Float?              // in minutes
  avgScore              Float?
  successRate           Float?

  // Creator Info
  createdById           String?
  createdByName         String?

  // Timestamps
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  submissions           ChallengeSubmission[]

  @@index([difficulty])
  @@index([category])
  @@index([status])
  @@map("coding_challenges")
}

model ChallengeSubmission {
  id                    String              @id @default(uuid())
  challengeId           String
  userId                String              // User who submitted

  // Submission Info
  attemptNumber         Int                 @default(1)
  language              String              // Programming language used
  code                  String              // Submitted code
  status                ChallengeSubmissionStatus @default(NOT_STARTED)

  // Timing
  startedAt             DateTime            @default(now())
  submittedAt           DateTime?
  completedAt           DateTime?
  timeSpentSeconds      Int?

  // Results
  testCasesPassed       Int                 @default(0)
  totalTestCases        Int                 @default(0)
  score                 Float?              // 0-100
  executionTime         Float?              // Average in ms
  memoryUsed            Float?              // Average in MB

  // Test Results
  testResults           Json?               // Array of {testCaseId, passed, output, expectedOutput, error}

  // Code Analysis
  codeQualityScore      Float?              // Linting/quality score
  complexity            String?             // Big-O complexity detected
  linesOfCode           Int?

  // Feedback
  autoFeedback          String?             // Auto-generated feedback
  reviewerFeedback      String?
  reviewedBy            String?
  reviewedAt            DateTime?

  // Plagiarism Check
  plagiarismScore       Float?              // Similarity with other submissions
  plagiarismFlags       Json?

  // Timestamps
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  challenge             CodingChallenge     @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId])
  @@index([userId])
  @@index([status])
  @@map("challenge_submissions")
}

// 1.4.2 - Technical Quiz Library
model TechnicalQuiz {
  id                    String              @id @default(uuid())

  // Quiz Info
  title                 String
  slug                  String              @unique
  description           String?
  instructions          String?

  // Categories & Difficulty
  category              String              // "javascript", "python", "react", "sql", "devops", "general"
  subcategory           String?
  difficulty            QuizDifficulty      @default(INTERMEDIATE)
  tags                  String[]            @default([])

  // Questions
  questionCount         Int                 @default(0)
  passingScore          Float               @default(70) // Percentage
  shuffleQuestions      Boolean             @default(true)
  shuffleOptions        Boolean             @default(true)

  // Time
  timeLimitMinutes      Int?                // null = no limit
  showTimer             Boolean             @default(true)

  // Attempts
  maxAttempts           Int?                // null = unlimited
  cooldownMinutes       Int?                // Time between retakes

  // Display Settings
  showCorrectAnswers    Boolean             @default(false) // After submission
  showExplanations      Boolean             @default(true)
  showScoreImmediately  Boolean             @default(true)

  // Status
  status                ChallengeStatus     @default(DRAFT)
  publishedAt           DateTime?

  // Statistics
  totalAttempts         Int                 @default(0)
  totalCompletions      Int                 @default(0)
  avgScore              Float?
  avgTimeSeconds        Float?

  // Creator Info
  createdById           String?
  createdByName         String?

  // Timestamps
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  questions             QuizQuestion[]
  attempts              QuizAttempt[]

  @@index([category])
  @@index([difficulty])
  @@index([status])
  @@map("technical_quizzes")
}

model QuizQuestion {
  id                    String              @id @default(uuid())
  quizId                String

  // Question Info
  questionNumber        Int
  questionType          String              @default("multiple_choice") // "multiple_choice", "multiple_select", "true_false", "fill_blank", "code_output"
  questionText          String              // The question (markdown supported)
  questionCode          String?             // Optional code snippet

  // Options (for multiple choice)
  options               Json                // Array of {id, text, isCorrect}
  correctAnswers        String[]            @default([]) // IDs of correct options

  // For fill-in-blank or code output
  expectedAnswer        String?
  acceptedVariations    String[]            @default([])
  caseSensitive         Boolean             @default(false)

  // Explanation
  explanation           String?             // Shown after answering
  references            String[]            @default([]) // Links to learn more

  // Points & Difficulty
  points                Int                 @default(1)
  difficulty            QuizDifficulty      @default(INTERMEDIATE)

  // Tags
  tags                  String[]            @default([])
  skill                 String?             // Specific skill tested

  // Display Order
  displayOrder          Int                 @default(0)

  // Statistics
  correctCount          Int                 @default(0)
  incorrectCount        Int                 @default(0)
  skipCount             Int                 @default(0)

  // Timestamps
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  quiz                  TechnicalQuiz       @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([questionType])
  @@map("quiz_questions")
}

model QuizAttempt {
  id                    String              @id @default(uuid())
  quizId                String
  userId                String

  // Attempt Info
  attemptNumber         Int                 @default(1)
  status                ChallengeSubmissionStatus @default(NOT_STARTED)

  // Timing
  startedAt             DateTime            @default(now())
  submittedAt           DateTime?
  timeSpentSeconds      Int?

  // Results
  score                 Float?              // Percentage
  pointsEarned          Int                 @default(0)
  totalPoints           Int                 @default(0)
  correctAnswers        Int                 @default(0)
  incorrectAnswers      Int                 @default(0)
  skippedQuestions      Int                 @default(0)
  totalQuestions        Int                 @default(0)

  // Pass/Fail
  passed                Boolean?
  passingScore          Float?              // Score needed to pass

  // Answers
  answers               Json                // Array of {questionId, selectedOptions, isCorrect, points}

  // Skill Assessment Results
  skillBreakdown        Json?               // {skill: {correct, total, percentage}}

  // Timestamps
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  quiz                  TechnicalQuiz       @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([userId])
  @@index([status])
  @@map("quiz_attempts")
}

// ============================================
// BATCH 7: ADVANCED ASSESSMENTS (Features 1.4.3-1.4.7)
// ============================================

enum LiveCodingSessionStatus {
  SCHEDULED
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ProjectSubmissionStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  REVIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ExternalAssessmentProvider {
  HACKERRANK
  CODESIGNAL
  LEETCODE
  CODILITY
  TESTGORILLA
  TOGGL_HIRE
  OTHER
}

enum SoftSkillCategory {
  PERSONALITY
  SITUATIONAL_JUDGMENT
  EMOTIONAL_INTELLIGENCE
  LEADERSHIP
  TEAMWORK
  COMMUNICATION
  PROBLEM_SOLVING
  ADAPTABILITY
}

enum LanguageTestType {
  SPEAKING
  WRITING
  READING
  LISTENING
  COMPREHENSIVE
}

// 1.4.3 - Live Coding Environment
model LiveCodingSession {
  id                    String              @id @default(uuid())

  // Session Info
  title                 String
  description           String?

  // Participants
  candidateId           String
  interviewerId         String
  additionalInterviewers String[]           @default([])

  // Scheduling
  scheduledAt           DateTime
  duration              Int                 @default(60) // minutes
  timezone              String              @default("UTC")
  status                LiveCodingSessionStatus @default(SCHEDULED)

  // Session Configuration
  language              String              @default("javascript")
  supportedLanguages    String[]            @default(["javascript", "python", "java"])
  template              String?             // Starter code
  problem               String?             // Problem statement
  testCases             Json?               // Test cases for auto-checking

  // Meeting Integration
  meetingUrl            String?             // Zoom/Meet/Teams URL
  meetingProvider       String?             // "zoom", "meet", "teams", "custom"
  roomId                String?             @unique // For collaborative coding room

  // Real-time Collaboration
  currentCode           String?             // Latest code state
  codeHistory           Json?               // Array of code snapshots with timestamps
  chatHistory           Json?               // Array of chat messages
  annotations           Json?               // Code annotations/comments

  // Recording
  isRecorded            Boolean             @default(false)
  recordingUrl          String?
  recordingConsent      Boolean             @default(false)

  // Session Events
  startedAt             DateTime?
  endedAt               DateTime?
  actualDuration        Int?                // Actual minutes

  // Evaluation
  interviewerNotes      String?
  technicalScore        Int?                // 1-5
  communicationScore    Int?                // 1-5
  problemSolvingScore   Int?                // 1-5
  overallScore          Int?                // 1-5
  recommendation        String?             // "strong_yes", "yes", "maybe", "no", "strong_no"
  feedback              String?

  // Job Link
  jobId                 String?
  applicationId         String?

  // Timestamps
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([candidateId])
  @@index([interviewerId])
  @@index([status])
  @@index([scheduledAt])
  @@map("live_coding_sessions")
}

// 1.4.4 - Take-Home Project System
model TakeHomeProject {
  id                    String              @id @default(uuid())

  // Project Definition
  title                 String
  slug                  String              @unique
  description           String              // Full project description (markdown)
  briefDescription      String?             // Short summary

  // Requirements
  requirements          String[]            @default([])
  technicalRequirements String[]            @default([]) // Tech stack requirements
  deliverables          String[]            @default([]) // What to submit
  evaluationCriteria    Json?               // {criterion: weight} for scoring

  // Difficulty & Category
  difficulty            QuizDifficulty      @default(INTERMEDIATE)
  category              String              // "frontend", "backend", "fullstack", "mobile", "data"
  subcategory           String?
  tags                  String[]            @default([])
  estimatedHours        Int                 @default(8) // Estimated completion time

  // Time Limits
  deadlineDays          Int                 @default(7) // Days to complete
  allowExtension        Boolean             @default(true)
  maxExtensionDays      Int                 @default(3)

  // Submission Settings
  maxSubmissions        Int                 @default(1)
  allowResubmission     Boolean             @default(false)
  submissionFormat      String[]            @default(["github", "zip"]) // Accepted formats

  // Resources
  starterRepoUrl        String?             // GitHub template repo
  resourceLinks         String[]            @default([])
  supportContact        String?             // Email for questions

  // Status
  status                ChallengeStatus     @default(DRAFT)
  publishedAt           DateTime?

  // Statistics
  totalAssignments      Int                 @default(0)
  totalSubmissions      Int                 @default(0)
  avgCompletionHours    Float?
  avgScore              Float?

  // Creator
  createdById           String?
  createdByName         String?

  // Timestamps
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  submissions           ProjectSubmission[]

  @@index([category])
  @@index([difficulty])
  @@index([status])
  @@map("take_home_projects")
}

model ProjectSubmission {
  id                    String              @id @default(uuid())
  projectId             String
  candidateId           String

  // Assignment Info
  assignedAt            DateTime            @default(now())
  assignedBy            String?             // Recruiter who assigned
  deadline              DateTime
  extendedDeadline      DateTime?
  extensionReason       String?

  // Submission Details
  status                ProjectSubmissionStatus @default(ASSIGNED)
  submissionNumber      Int                 @default(1)

  // Submission Content
  githubUrl             String?
  zipFileUrl            String?
  livePreviewUrl        String?
  submissionNotes       String?
  technologiesUsed      String[]            @default([])

  // Time Tracking
  startedAt             DateTime?
  submittedAt           DateTime?
  timeSpentHours        Float?              // Self-reported

  // Review
  reviewerId            String?
  reviewerName          String?
  reviewStartedAt       DateTime?
  reviewCompletedAt     DateTime?

  // Evaluation Scores
  overallScore          Float?              // 0-100
  codeQualityScore      Float?              // 0-100
  functionalityScore    Float?              // 0-100
  designScore           Float?              // 0-100
  documentationScore    Float?              // 0-100
  creativityScore       Float?              // 0-100
  criteriaScores        Json?               // {criterion: score} based on project criteria

  // Feedback
  reviewFeedback        String?             // Detailed feedback
  strengths             String[]            @default([])
  improvements          String[]            @default([])
  recommendation        String?             // "strong_yes", "yes", "maybe", "no"

  // Plagiarism Check
  plagiarismChecked     Boolean             @default(false)
  plagiarismScore       Float?              // Similarity percentage
  plagiarismReport      String?

  // Job Link
  jobId                 String?
  applicationId         String?

  // Timestamps
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  project               TakeHomeProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([candidateId])
  @@index([status])
  @@map("project_submissions")
}

// 1.4.5 - HackerRank/CodeSignal Integration
model ExternalAssessment {
  id                    String              @id @default(uuid())
  profileId             String

  // Provider Info
  provider              ExternalAssessmentProvider
  providerUserId        String?             // User ID on external platform
  providerUsername      String?             // Username on platform

  // Assessment Details
  assessmentId          String              // External assessment ID
  assessmentName        String
  assessmentType        String?             // "coding", "sql", "frontend", "general"
  assessmentUrl         String?             // Link to assessment/certificate

  // Scores
  score                 Float?              // Percentage or points
  maxScore              Float?
  percentile            Float?              // Percentile ranking
  rank                  Int?                // Global/regional rank
  level                 String?             // Platform-specific level (e.g., "Gold", "5 stars")

  // Skill Breakdown
  skillScores           Json?               // {skill: score}
  badges                String[]            @default([])
  certifications        String[]            @default([])

  // Verification
  isVerified            Boolean             @default(false)
  verifiedAt            DateTime?
  verificationMethod    String?             // "api", "screenshot", "certificate"
  verificationData      Json?               // API response or verification details

  // Assessment Dates
  takenAt               DateTime?
  expiresAt             DateTime?           // Some assessments expire
  lastSyncedAt          DateTime?

  // Import Status
  importedAt            DateTime            @default(now())
  importSource          String?             // "oauth", "manual", "api"
  rawData               Json?               // Raw API response

  // Display Settings
  showOnProfile         Boolean             @default(true)
  featuredScore         Boolean             @default(false)

  // Timestamps
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  profile               CandidateProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, provider, assessmentId])
  @@index([profileId])
  @@index([provider])
  @@map("external_assessments")
}

// 1.4.6 - Soft Skills Assessment
model SoftSkillsAssessment {
  id                    String              @id @default(uuid())

  // Assessment Info
  title                 String
  slug                  String              @unique
  description           String?
  instructions          String?
  category              SoftSkillCategory
  subcategory           String?

  // Assessment Configuration
  questionCount         Int                 @default(0)
  timeLimitMinutes      Int?                // null = no limit
  isAdaptive            Boolean             @default(false) // Adaptive questioning

  // Scoring
  scoringMethod         String              @default("standard") // "standard", "ipsative", "normative"
  resultType            String              @default("profile") // "profile", "score", "category"

  // Status
  status                ChallengeStatus     @default(DRAFT)
  publishedAt           DateTime?

  // Statistics
  totalAttempts         Int                 @default(0)
  avgCompletionMinutes  Float?

  // Creator
  createdById           String?

  // Timestamps
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  questions             SoftSkillQuestion[]
  attempts              SoftSkillAttempt[]

  @@index([category])
  @@index([status])
  @@map("soft_skills_assessments")
}

model SoftSkillQuestion {
  id                    String              @id @default(uuid())
  assessmentId          String

  // Question Info
  questionNumber        Int
  questionType          String              @default("likert") // "likert", "forced_choice", "scenario", "ranking"
  questionText          String
  scenario              String?             // For situational judgment questions

  // Options
  options               Json                // Array of {id, text, dimension?, weight?}
  dimensions            String[]            @default([]) // Personality dimensions measured

  // For ranking questions
  itemsToRank           String[]            @default([])

  // Scoring
  scoringKey            Json?               // How to score each response
  weight                Float               @default(1)

  // Display
  displayOrder          Int                 @default(0)
  isRequired            Boolean             @default(true)

  // Timestamps
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  assessment            SoftSkillsAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@map("soft_skill_questions")
}

model SoftSkillAttempt {
  id                    String              @id @default(uuid())
  assessmentId          String
  userId                String

  // Attempt Info
  status                ChallengeSubmissionStatus @default(NOT_STARTED)
  startedAt             DateTime            @default(now())
  completedAt           DateTime?
  timeSpentMinutes      Int?

  // Responses
  responses             Json                // Array of {questionId, response, timestamp}

  // Results
  dimensionScores       Json?               // {dimension: score}
  traitProfile          Json?               // Personality/skill profile
  overallProfile        String?             // Summary profile type

  // Interpretation
  interpretation        String?             // AI-generated interpretation
  strengths             String[]            @default([])
  developmentAreas      String[]            @default([])
  recommendations       String[]            @default([])

  // Validity Indicators
  consistencyScore      Float?              // Response consistency check
  socialDesirabilityScore Float?            // Detecting impression management
  isValid               Boolean             @default(true)

  // Timestamps
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  assessment            SoftSkillsAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@index([userId])
  @@map("soft_skill_attempts")
}

// 1.4.7 - Language Proficiency Tests
model LanguageProficiencyTest {
  id                    String              @id @default(uuid())

  // Test Info
  title                 String
  slug                  String              @unique
  description           String?
  language              String              // "english", "spanish", "mandarin", etc.
  testType              LanguageTestType    @default(COMPREHENSIVE)

  // Test Configuration
  sections              Json                // Array of {type, questionCount, timeLimit}
  totalQuestions        Int                 @default(0)
  totalTimeMinutes      Int                 @default(60)

  // Scoring
  scoringScale          String              @default("cefr") // "cefr", "ielts", "toefl", "custom"
  maxScore              Float               @default(100)
  levelThresholds       Json?               // {level: minScore} e.g., {"A1": 0, "A2": 20, ...}

  // Features
  hasSpeaking           Boolean             @default(false)
  hasWriting            Boolean             @default(false)
  hasListening          Boolean             @default(false)
  hasReading            Boolean             @default(true)
  hasGrammar            Boolean             @default(true)
  hasVocabulary         Boolean             @default(true)

  // AI Features
  aiSpeakingEvaluation  Boolean             @default(false)
  aiWritingEvaluation   Boolean             @default(false)

  // Status
  status                ChallengeStatus     @default(DRAFT)
  publishedAt           DateTime?

  // Statistics
  totalAttempts         Int                 @default(0)
  avgScore              Float?

  // Creator
  createdById           String?

  // Timestamps
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  questions             LanguageQuestion[]
  attempts              LanguageTestAttempt[]

  @@index([language])
  @@index([testType])
  @@index([status])
  @@map("language_proficiency_tests")
}

model LanguageQuestion {
  id                    String              @id @default(uuid())
  testId                String

  // Question Info
  questionNumber        Int
  section               String              // "reading", "listening", "grammar", "vocabulary", "writing", "speaking"
  questionType          String              // "multiple_choice", "fill_blank", "essay", "speaking_prompt", "listening_comp"
  difficulty            QuizDifficulty      @default(INTERMEDIATE)

  // Content
  questionText          String
  contextText           String?             // Reading passage or context
  audioUrl              String?             // For listening questions
  imageUrl              String?             // Supporting image

  // Options (for multiple choice)
  options               Json?               // Array of {id, text, isCorrect}

  // For open-ended
  rubric                Json?               // Scoring rubric for essays/speaking
  sampleAnswer          String?             // Model answer
  minWords              Int?                // Minimum word count
  maxWords              Int?                // Maximum word count
  speakingTimeSeconds   Int?                // Time limit for speaking

  // Scoring
  points                Int                 @default(1)
  correctAnswer         String?             // For auto-graded questions

  // Display
  displayOrder          Int                 @default(0)
  timeLimit             Int?                // Question-specific time limit

  // Statistics
  correctCount          Int                 @default(0)
  attemptCount          Int                 @default(0)

  // Timestamps
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  test                  LanguageProficiencyTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([testId])
  @@index([section])
  @@map("language_questions")
}

model LanguageTestAttempt {
  id                    String              @id @default(uuid())
  testId                String
  userId                String

  // Attempt Info
  status                ChallengeSubmissionStatus @default(NOT_STARTED)
  startedAt             DateTime            @default(now())
  completedAt           DateTime?
  timeSpentMinutes      Int?

  // Section Completion
  sectionsCompleted     Json?               // {section: completed}
  currentSection        String?

  // Responses
  responses             Json                // Array of {questionId, response, audioUrl?, timeSpent}

  // Section Scores
  readingScore          Float?
  listeningScore        Float?
  grammarScore          Float?
  vocabularyScore       Float?
  writingScore          Float?
  speakingScore         Float?

  // Overall Results
  totalScore            Float?
  percentile            Float?
  level                 String?             // CEFR level or equivalent

  // AI Evaluations
  writingFeedback       Json?               // {score, feedback, suggestions}
  speakingFeedback      Json?               // {pronunciation, fluency, vocabulary, grammar, feedback}
  aiEvaluatedAt         DateTime?

  // Human Review (if needed)
  reviewerId            String?
  reviewedAt            DateTime?
  reviewerFeedback      String?
  finalScore            Float?              // After human review

  // Certificate
  certificateUrl        String?
  certificateIssuedAt   DateTime?

  // Timestamps
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  test                  LanguageProficiencyTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([testId])
  @@index([userId])
  @@index([status])
  @@map("language_test_attempts")
}

// ============================================
// BATCH 8: DOMAIN ASSESSMENTS, ANALYTICS & AI SCORING (1.4.8-2.1.2)
// ============================================

// Domain categories for assessments
enum DomainCategory {
  FINANCE
  HEALTHCARE
  LEGAL
  TECHNOLOGY
  MARKETING
  SALES
  HR
  OPERATIONS
  ENGINEERING
  DATA_SCIENCE
  CYBERSECURITY
  COMPLIANCE
  OTHER
}

// 1.4.8 - Domain-Specific Assessments
model DomainAssessment {
  id                    String              @id @default(uuid())
  title                 String
  slug                  String              @unique
  description           String?
  domain                DomainCategory
  subDomain             String?             // e.g., "Investment Banking" under FINANCE

  // Assessment Configuration
  difficultyLevel       String              // BEGINNER, INTERMEDIATE, ADVANCED, EXPERT
  estimatedMinutes      Int                 @default(30)
  passingScore          Float               @default(70)
  totalPoints           Int                 @default(100)

  // Question Configuration
  questionCount         Int                 @default(30)
  randomizeQuestions    Boolean             @default(true)
  showCorrectAnswers    Boolean             @default(false) // After completion

  // Timing
  timeLimit             Int?                // Minutes, null = no limit
  allowPause            Boolean             @default(false)

  // Certification
  providesCertificate   Boolean             @default(true)
  certificateValidDays  Int?                // null = never expires

  // Metadata
  tags                  String[]            @default([])
  prerequisites         String[]            @default([]) // Required skill IDs or assessment IDs
  targetRoles           String[]            @default([]) // Job titles this applies to

  // Version tracking
  version               Int                 @default(1)
  isActive              Boolean             @default(true)

  // Timestamps
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  questions             DomainQuestion[]
  attempts              DomainAssessmentAttempt[]

  @@index([domain])
  @@index([isActive])
  @@map("domain_assessments")
}

// Questions for domain assessments
model DomainQuestion {
  id                    String              @id @default(uuid())
  assessmentId          String

  // Question Content
  questionText          String
  questionType          String              // MULTIPLE_CHOICE, MULTI_SELECT, TRUE_FALSE, CASE_STUDY, SCENARIO, SHORT_ANSWER

  // Options for choice questions
  options               Json?               // Array of {id, text, isCorrect}
  correctAnswer         String?             // For short answer

  // Case study/Scenario
  caseStudy             String?             // Long-form case description
  exhibits              Json?               // Supporting documents, charts, data

  // Scoring
  points                Int                 @default(1)
  partialCreditAllowed  Boolean             @default(false)

  // Explanation
  explanation           String?             // Shown after answer
  references            String[]            @default([]) // External reference links

  // Metadata
  difficulty            String              // EASY, MEDIUM, HARD
  topic                 String?             // Specific topic within domain
  skills                String[]            @default([])
  order                 Int                 @default(0)

  // Timestamps
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  assessment            DomainAssessment    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@index([topic])
  @@map("domain_questions")
}

// Attempts at domain assessments
model DomainAssessmentAttempt {
  id                    String              @id @default(uuid())
  assessmentId          String
  userId                String
  applicationId         String?             // If tied to a job application

  // Attempt State
  status                String              @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, TIMED_OUT, ABANDONED
  startedAt             DateTime            @default(now())
  completedAt           DateTime?

  // Time Tracking
  timeSpentSeconds      Int                 @default(0)
  pausedAt              DateTime?
  totalPauseSeconds     Int                 @default(0)

  // Progress
  currentQuestionIndex  Int                 @default(0)
  questionsAnswered     Int                 @default(0)

  // Answers
  answers               Json                // Array of {questionId, answer, timeSpent, flagged}
  flaggedQuestions      String[]            @default([])

  // Results
  rawScore              Float?
  percentageScore       Float?
  passed                Boolean?

  // Topic Breakdown
  topicScores           Json?               // {topic: {correct, total, percentage}}
  skillScores           Json?               // {skill: {correct, total, percentage}}

  // Ranking
  percentile            Float?              // Compared to other attempts
  ranking               Int?                // Position out of total attempts

  // Certificate
  certificateId         String?
  certificateUrl        String?
  certificateExpiresAt  DateTime?

  // Timestamps
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  assessment            DomainAssessment    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@index([userId])
  @@index([status])
  @@map("domain_assessment_attempts")
}

// 1.4.9 - Assessment Analytics
model AssessmentAnalytics {
  id                    String              @id @default(uuid())
  userId                String
  profileId             String?

  // Aggregated Stats
  totalAssessmentsTaken Int                 @default(0)
  totalAssessmentsPassed Int                @default(0)
  overallAverageScore   Float?

  // By Assessment Type
  codingChallenges      Json?               // {taken, passed, avgScore, bestScore, recentScores}
  technicalQuizzes      Json?
  domainAssessments     Json?
  softSkillsTests       Json?
  languageTests         Json?

  // Skill Performance
  skillPerformance      Json?               // {skill: {assessments, avgScore, trend, lastAssessed}}

  // Time Analytics
  averageCompletionTime Int?                // In minutes
  fastestCompletion     Int?
  totalTimeSpent        Int?                // Total minutes across all assessments

  // Trend Analysis
  scoreHistory          Json?               // Array of {date, assessmentType, score}
  monthlyProgress       Json?               // {month: {taken, passed, avgScore}}

  // Comparative Analytics
  percentileRankings    Json?               // {assessmentType: percentile}
  industryComparison    Json?               // How user compares to industry

  // Strengths & Weaknesses
  topStrengths          String[]            @default([])
  areasForImprovement   String[]            @default([])

  // Recommendations
  recommendedAssessments String[]           @default([])
  suggestedLearning     Json?               // {skill: courseRecommendations}

  // Timestamps
  lastAssessmentAt      DateTime?
  lastAnalyzedAt        DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([userId])
  @@index([profileId])
  @@map("assessment_analytics")
}

// 1.4.10 - Skill Decay Tracking
model SkillDecayTracker {
  id                    String              @id @default(uuid())
  userId                String
  skillName             String

  // Assessment History
  lastAssessedAt        DateTime
  lastScore             Float
  peakScore             Float
  assessmentCount       Int                 @default(1)

  // Decay Calculation
  decayRate             Float?              // Estimated decay per month
  currentEstimatedScore Float?              // Projected current score
  confidenceLevel       Float?              // How confident we are in the estimate

  // Refresh Schedule
  refreshDueAt          DateTime?           // When reassessment is recommended
  refreshPriority       String?             // HIGH, MEDIUM, LOW

  // Skill Category
  skillCategory         String?             // TECHNICAL, SOFT_SKILL, DOMAIN, LANGUAGE
  relatedAssessments    String[]            @default([])

  // Notification
  reminderSent          Boolean             @default(false)
  reminderSentAt        DateTime?

  // Score History
  scoreHistory          Json?               // Array of {date, score, assessmentId}

  // Timestamps
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([userId, skillName])
  @@index([userId])
  @@index([refreshDueAt])
  @@map("skill_decay_trackers")
}

// 2.1.1 - AI Profile Scorer
model AIProfileScore {
  id                    String              @id @default(uuid())
  profileId             String
  userId                String

  // Overall Score
  overallScore          Float               // 0-100
  scoreGrade            String              // A+, A, B+, B, C+, C, D, F

  // Component Scores (all 0-100)
  profileCompleteness   Float
  experienceDepth       Float
  skillsVerification    Float
  educationStrength     Float
  projectQuality        Float
  assessmentPerformance Float
  verificationScore     Float
  engagementScore       Float               // Platform activity

  // Weighted Breakdown
  componentWeights      Json                // {component: weight}
  componentDetails      Json                // {component: {score, factors, improvements}}

  // AI Analysis
  strengths             String[]            @default([])
  weaknesses            String[]            @default([])
  recommendations       Json?               // Array of {area, suggestion, impact}

  // Career Level Estimation
  estimatedLevel        String?             // ENTRY, MID, SENIOR, LEAD, EXECUTIVE
  yearsOfExperience     Int?                // AI-estimated

  // Industry Fit
  topIndustries         Json?               // Array of {industry, fitScore, reasons}
  topRoles              Json?               // Array of {role, fitScore, matchingSkills}

