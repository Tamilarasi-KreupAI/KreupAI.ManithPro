  // Timestamps
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([profileId])
  @@index([userId])
  @@index([overallScore])
  @@map("ai_profile_scores")
}

// 2.1.2 - Job-Fit Score
model JobFitScore {
  id                    String              @id @default(uuid())
  userId                String
  profileId             String?
  jobId                 String
  applicationId         String?

  // Overall Fit Score
  overallFitScore       Float               // 0-100
  fitCategory           String              // EXCELLENT_FIT, GOOD_FIT, MODERATE_FIT, LOW_FIT, POOR_FIT

  // Component Scores (all 0-100)
  skillsMatch           Float
  experienceMatch       Float
  educationMatch        Float
  locationMatch         Float
  salaryMatch           Float
  senioritylMatch       Float
  industryMatch         Float
  cultureMatch          Float?              // If culture data available

  // Detailed Breakdown
  matchedSkills         Json                // Array of {skill, requiredLevel, candidateLevel, match}
  missingSkills         String[]            @default([])
