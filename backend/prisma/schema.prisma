// Prisma schema for Recruitment Portal

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CANDIDATE
  RECRUITER
  ADMIN
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  REMOTE
}

enum JobStatus {
  OPEN
  CLOSED
  DRAFT
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  SHORTLISTED
  INTERVIEW_SCHEDULED
  REJECTED
  ACCEPTED
  WITHDRAWN
}

enum InterviewType {
  PHONE_SCREEN
  TECHNICAL
  HR
  FINAL
  PEER
  CULTURAL_FIT
  OTHER
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
  NO_SHOW
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

enum NotificationType {
  APPLICATION_STATUS
  INTERVIEW_SCHEDULED
  INTERVIEW_REMINDER
  MESSAGE_RECEIVED
  JOB_POSTED
  APPLICATION_RECEIVED
  OFFER_MADE
  OFFER_ACCEPTED
  OFFER_REJECTED
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  password      String
  firstName     String
  lastName      String
  role          UserRole      @default(CANDIDATE)
  phone         String?
  bio           String?
  skills        String[]      @default([])
  experience    Int?          // years of experience
  education     String?
  location      String?
  linkedIn      String?
  portfolio     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  postedJobs           Job[]           @relation("PostedJobs")
  applications         Application[]
  savedJobs            SavedJob[]
  scheduledInterviews  Interview[]     @relation("ScheduledInterviews")
  candidateInterviews  Interview[]     @relation("CandidateInterviews")
  sentMessages         Message[]       @relation("SentMessages")
  receivedMessages     Message[]       @relation("ReceivedMessages")
  notifications        Notification[]

  @@map("users")
}

model Job {
  id              String        @id @default(uuid())
  title           String
  description     String
  requirements    String[]      @default([])
  responsibilities String[]     @default([])
  location        String
  type            JobType
  salary          String?
  salaryMin       Int?
  salaryMax       Int?
  benefits        String[]      @default([])
  skills          String[]      @default([])
  experience      String?       // e.g., "2-5 years"
  education       String?
  status          JobStatus     @default(OPEN)
  positions       Int           @default(1)
  deadline        DateTime?

  // Company Information
  companyName     String
  companyDescription String?
  companyWebsite  String?
  companyLogo     String?
  companySize     String?       // e.g., "1-50", "51-200", "201-500", "500+"
  companyIndustry String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  postedById      String
  postedBy        User          @relation("PostedJobs", fields: [postedById], references: [id], onDelete: Cascade)
  applications    Application[]
  savedBy         SavedJob[]

  @@index([status, createdAt])
  @@index([type])
  @@index([companyName])
  @@map("jobs")
}

model Application {
  id            String            @id @default(uuid())
  resume        String            // file path
  coverLetter   String?
  status        ApplicationStatus @default(PENDING)
  notes         String?           // recruiter notes
  appliedAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // Relations
  jobId         String
  job           Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId   String
  candidate     User              @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interviews    Interview[]
  messages      Message[]

  @@unique([jobId, candidateId]) // One application per job per candidate
  @@index([status])
  @@index([candidateId])
  @@map("applications")
}

model SavedJob {
  id          String   @id @default(uuid())
  userId      String
  jobId       String
  savedAt     DateTime @default(now())

  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId]) // One save per job per user
  @@index([userId])
  @@map("saved_jobs")
}

model Interview {
  id              String          @id @default(uuid())
  type            InterviewType
  status          InterviewStatus @default(SCHEDULED)
  scheduledAt     DateTime
  endTime         DateTime
  timeZone        String?         // e.g., "America/New_York"
  meetingLink     String?         // Video call link (Zoom, Google Meet, etc.)
  location        String?         // Physical location if in-person
  instructions    String?         // Instructions for the candidate
  notes           String?         // Internal notes from recruiter
  feedback        String?         // Post-interview feedback
  rating          Int?            // 1-5 rating
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  applicationId   String
  application     Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scheduledById   String
  scheduledBy     User            @relation("ScheduledInterviews", fields: [scheduledById], references: [id])
  candidateId     String
  candidate       User            @relation("CandidateInterviews", fields: [candidateId], references: [id])

  @@index([status, scheduledAt])
  @@index([candidateId])
  @@index([scheduledById])
  @@map("interviews")
}

model Message {
  id              String        @id @default(uuid())
  content         String
  status          MessageStatus @default(SENT)
  attachments     String[]      @default([])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  senderId        String
  sender          User          @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId      String
  receiver        User          @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  applicationId   String?
  application     Application?  @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId])
  @@index([applicationId])
  @@index([createdAt])
  @@map("messages")
}

model Notification {
  id          String            @id @default(uuid())
  type        NotificationType
  title       String
  message     String
  link        String?           // Link to relevant page
  isRead      Boolean           @default(false)
  createdAt   DateTime          @default(now())

  // Relations
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}
