  calculatedAt          DateTime            @default(now())
  expiresAt             DateTime?

  @@unique([roleAId, roleBId])
  @@index([combinedScore])
  @@map("role_similarities")
}

// 5.1.4 - SKILL TRANSFERABILITY ANALYSIS
model SkillTransferability {
  id                    String              @id @default(uuid())

  // Source and Target
