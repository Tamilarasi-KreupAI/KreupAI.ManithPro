// BATCH 21: SEMANTIC MATCHING ENGINE (5.1.1-5.1.7)
// ============================================

// 5.1.1 - SKILL VECTOR EMBEDDING
model SkillEmbedding {
  id                    String              @id @default(uuid())
  companyId             String?

  // Skill Info
  skillName             String
  normalizedName        String              // Lowercase, trimmed
  skillCategory         String?             // e.g., "Programming", "Management", "Design"
  skillType             String              @default("TECHNICAL") // TECHNICAL, SOFT, DOMAIN, TOOL

  // Embedding Vector
  embeddingModel        String              @default("text-embedding-3-small")
  embeddingVersion      String              @default("1.0")
  embeddingVector       Json                // Float array stored as JSON
  vectorDimension       Int                 @default(1536)

  // Related Skills (pre-computed)
  relatedSkills         Json?               // Array of { skillId, similarity }
  synonyms              String[]            @default([])
  alternateNames        String[]            @default([])

  // Usage Stats
  usageCount            Int                 @default(0)
  lastUsedAt            DateTime?

  // Metadata
  isActive              Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([skillName, companyId])
  @@index([normalizedName])
  @@index([skillCategory])
  @@index([skillType])
  @@map("skill_embeddings")
}

// Skill Similarity Cache
model SkillSimilarity {
  id                    String              @id @default(uuid())

  // Skills Being Compared
  skillAId              String
  skillAName            String
  skillBId              String
  skillBName            String

  // Similarity Scores
  cosineSimilarity      Float               // 0-1 score from vector similarity
  contextualSimilarity  Float?              // Adjusted for context
  combinedScore         Float               // Weighted combination

  // Relationship Type
  relationshipType      String              @default("SIMILAR") // SIMILAR, PREREQUISITE, ADVANCED, SUBSET, SUPERSET

  // Confidence
  confidenceScore       Float               @default(0.8)
  validatedBy           String?             // Manual validation
  validatedAt           DateTime?

  // Metadata
  calculatedAt          DateTime            @default(now())
  expiresAt             DateTime?

  @@unique([skillAId, skillBId])
  @@index([skillAName])
  @@index([skillBName])
  @@index([combinedScore])
  @@map("skill_similarities")
}

// 5.1.2 - EXPERIENCE LEVEL INFERENCE
model ExperienceLevelRule {
  id                    String              @id @default(uuid())
  companyId             String?

  // Rule Info
  ruleName              String
  ruleDescription       String?
  ruleType              String              @default("PATTERN") // PATTERN, TITLE, DURATION, KEYWORDS

  // Title Patterns
  titlePatterns         String[]            @default([]) // e.g., ["Senior*", "*Lead*", "Principal*"]
  excludePatterns       String[]            @default([])

  // Duration Rules
  minYearsExperience    Int?
  maxYearsExperience    Int?
  minRoleDuration       Int?                // Minimum months in a role

  // Keyword Indicators
  seniorityKeywords     String[]            @default([]) // Words indicating level
  responsibilityKeywords String[]           @default([])

  // Output Level
  inferredLevel         String              // ENTRY, JUNIOR, MID, SENIOR, LEAD, PRINCIPAL, EXECUTIVE
  levelNumeric          Int                 // 1-10 scale
  levelConfidence       Float               @default(0.8)

  // Priority (higher = evaluated first)
  priority              Int                 @default(100)

  // Metadata
  isActive              Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([companyId])
  @@index([inferredLevel])
  @@map("experience_level_rules")
}

// Candidate Experience Level Inference Result
model CandidateExperienceLevel {
  id                    String              @id @default(uuid())
  candidateId           String
  profileId             String?

  // Inferred Levels
  overallLevel          String              // ENTRY, JUNIOR, MID, SENIOR, LEAD, PRINCIPAL, EXECUTIVE
  overallLevelNumeric   Int                 // 1-10 scale
  technicalLevel        String?
  technicalLevelNumeric Int?
  leadershipLevel       String?
  leadershipLevelNumeric Int?
  domainLevel           String?
  domainLevelNumeric    Int?

  // Evidence
  evidenceFactors       Json                // Array of { factor, weight, contribution }
  titleProgression      Json?               // Career title history
  yearsCalculated       Float?
  roleCount             Int?

  // Confidence
  confidenceScore       Float               @default(0.7)
  confidenceFactors     Json?               // What contributed to confidence

  // Manual Override
  manualOverride        Boolean             @default(false)
  overriddenBy          String?
  overriddenAt          DateTime?
  overrideReason        String?

  // Metadata
  calculatedAt          DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([candidateId])
  @@index([overallLevel])
  @@index([confidenceScore])
  @@map("candidate_experience_levels")
}

// 5.1.3 - ROLE SIMILARITY DETECTION
model RoleMapping {
  id                    String              @id @default(uuid())
  companyId             String?

  // Role Info
  roleTitle             String
  normalizedTitle       String              // Standardized version
  roleCategory          String?             // e.g., "Engineering", "Product", "Design"
  roleFamily            String?             // e.g., "Software Development", "Data Science"
  roleFunction          String?             // e.g., "Individual Contributor", "Management"

  // Industry Context
  industry              String?             // e.g., "Tech", "Finance", "Healthcare"
  industrySpecific      Boolean             @default(false)

  // Embedding
  titleEmbedding        Json?               // Vector embedding for semantic matching
  descriptionEmbedding  Json?

  // Related Roles
  similarRoles          Json?               // Array of { roleId, similarity }
  equivalentTitles      String[]            @default([]) // Same role, different names
  seniorVariants        String[]            @default([]) // Senior versions
  juniorVariants        String[]            @default([]) // Junior versions

  // Typical Requirements
  typicalSkills         String[]            @default([])
  typicalExperience     Int?                // Typical years
  typicalEducation      String?

  // Usage
  usageCount            Int                 @default(0)

  // Metadata
  isActive              Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([normalizedTitle])
  @@index([roleCategory])
  @@index([roleFamily])
  @@index([industry])
  @@map("role_mappings")
}

// Role Similarity Score
model RoleSimilarity {
  id                    String              @id @default(uuid())

  // Roles Being Compared
  roleAId               String
  roleATitle            String
  roleBId               String
  roleBTitle            String

  // Similarity Scores
