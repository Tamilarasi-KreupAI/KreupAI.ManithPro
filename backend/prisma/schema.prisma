  // Candidate Info
  candidateId           String
  profileId             String?

  // Discovery Info
  discoveredForJobId    String?
  discoveredForRole     String?

  // Why Hidden
  hiddenReasons         String[]            @default([]) // Why not found by keyword search
  keywordGaps           String[]            @default([]) // Missing keywords
  unconventionalPath    Boolean             @default(false)
  careerPivot           Boolean             @default(false)
  industryOutsider      Boolean             @default(false)

  // Potential Assessment
  potentialScore        Float               // 0-100 predicted fit
  potentialFactors      Json                // What indicates potential

  // Transferable Strengths
  transferableSkills    Json?               // Skills that transfer to target role
  relevantExperience    Json?               // Experience that's relevant but different
  hiddenQualifications  String[]            @default([])

