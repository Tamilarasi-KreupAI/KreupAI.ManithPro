  flightRisk            Float?              // Likelihood to leave quickly
  growthPotential       Float?              // Potential for growth
  retentionPrediction   Float?              // Predicted retention

  // Hidden Talent Indicator
  isHiddenTalent        Boolean             @default(false)
  hiddenTalentBoost     Float               @default(0)

