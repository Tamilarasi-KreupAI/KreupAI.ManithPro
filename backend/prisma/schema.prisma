  completedAt           DateTime?

  // Settings
  settings              Json?               // Team-specific settings
  notificationPrefs     Json?               // Notification preferences

  // Metrics Summary
  totalCandidates       Int                 @default(0)
  totalInterviews       Int                 @default(0)
  totalHires            Int                 @default(0)
  avgTimeToHire         Float?

  // Metadata
  createdById           String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([companyId])
  @@index([jobId])
  @@index([leadRecruiterId])
  @@index([status])
  @@map("hiring_teams")
}

// 6.1.2 Role-Based Permissions for Team Members
model HiringTeamMember {
  id                    String              @id @default(uuid())
  teamId                String
  userId                String
  companyId             String

  // Role
  role                  String              // LEAD_RECRUITER, RECRUITER, HIRING_MANAGER, INTERVIEWER, COORDINATOR, VIEWER
  title                 String?             // Display title

  // Permissions
  permissionLevel       String              @default("VIEWER") // VIEWER, COMMENTER, EDITOR, ADMIN
  canViewCandidates     Boolean             @default(true)
  canEditCandidates     Boolean             @default(false)
  canScheduleInterviews Boolean             @default(false)
  canSubmitFeedback     Boolean             @default(true)
  canMakeDecisions      Boolean             @default(false)
  canManageTeam         Boolean             @default(false)
  canAccessReports      Boolean             @default(false)
  customPermissions     Json?               // Additional custom permissions

  // Availability
  isActive              Boolean             @default(true)
  availableFrom         DateTime?
  availableUntil        DateTime?
  maxInterviewsPerWeek  Int?
  currentInterviewLoad  Int                 @default(0)

  // Expertise
  expertiseAreas        Json?               // Skills/areas they can interview for
  interviewTypes        Json?               // Types of interviews they conduct

  // Notifications
  notifyOnNewCandidates Boolean             @default(true)
  notifyOnInterviews    Boolean             @default(true)
  notifyOnDecisions     Boolean             @default(true)

  // Metadata
  addedById             String
  joinedAt              DateTime            @default(now())
  lastActiveAt          DateTime?
  updatedAt             DateTime            @updatedAt

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@index([companyId])
  @@index([role])
  @@map("hiring_team_members")
}

// 6.1.3 Interview Panel Setup
model InterviewPanel {
  id                    String              @id @default(uuid())
  companyId             String
  teamId                String
  jobId                 String

  // Panel Details
  name                  String
  roundNumber           Int                 // 1, 2, 3, etc.
  roundType             String              // PHONE_SCREEN, TECHNICAL, BEHAVIORAL, CULTURE, FINAL, OFFER

  // Panel Members
  panelMembers          Json                // Array of {userId, role, isRequired}
