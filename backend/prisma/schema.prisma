  deadlineType          String

  // Status
  status                String              @default("PENDING") // PENDING, COMPLETED, OVERDUE, EXCUSED
  completedAt           DateTime?

  // Reminders
  remindersSent         Json?               // Array of {sentAt, type}
  escalated             Boolean             @default(false)
  escalatedAt           DateTime?
  escalatedTo           String?

  // Extension
  extendedBy            String?
  extendedAt            DateTime?
  originalDueAt         DateTime?
  extensionReason       String?

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([companyId])
  @@index([candidateId])
  @@index([assigneeId])
  @@index([status])
  @@index([dueAt])
  @@map("deadline_instances")
}

// 6.2.8 Disagreement Resolution
model EvaluationDisagreement {
  id                    String              @id @default(uuid())
  companyId             String
  candidateId           String
  jobId                 String

  // Disagreement Details
  disagreementType      String              // SCORE, RECOMMENDATION, CRITERIA, INTERPRETATION
  severity              String              // MINOR, MODERATE, MAJOR, CRITICAL
  criteriaId            String?             // If about specific criteria

  // Parties
  reviewerIds           Json                // Array of disagreeing reviewers
  primaryReviewerId     String?             // Main opposing view
  secondaryReviewerId   String?             // Other opposing view

  // Disagreement Data
  positions             Json                // {userId: {score, reasoning, evidence}}
  scoreDifference       Float?
  description           String              @db.Text

  // Resolution Process
  resolutionMethod      String?             // DISCUSSION, MEDIATOR, TIEBREAKER, CONSENSUS, MANAGER_DECISION
  mediatorId            String?
  discussionNotes       String?             @db.Text

  // Outcome
  resolution            String?             // RESOLVED, UNRESOLVED, ESCALATED, DISMISSED
  finalDecision         Json?               // What was decided
  resolvedById          String?
  resolvedAt            DateTime?
  resolutionRationale   String?             @db.Text

  // Status
  status                String              @default("IDENTIFIED") // IDENTIFIED, IN_DISCUSSION, RESOLVED, ESCALATED

  // Metadata
  identifiedAt          DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([companyId])
  @@index([candidateId])
  @@index([jobId])
  @@index([severity])
  @@index([status])
  @@map("evaluation_disagreements")
}

// 6.2.9 Historical Comparison
model CandidateComparison {
