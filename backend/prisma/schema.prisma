// Candidate Match Score (Overall Matching Result)
model CandidateMatchScore {
  id                    String              @id @default(uuid())
  companyId             String

  // Candidate & Job
  candidateId           String
  jobId                 String

  // Overall Scores
  overallMatchScore     Float               // 0-100 final score
  semanticScore         Float               // From semantic matching
  keywordScore          Float?              // Traditional keyword match
  experienceScore       Float?              // Experience level fit
  skillScore            Float?              // Skills match score
  projectScore          Float?              // Project relevance
  cultureFitScore       Float?              // Culture/values alignment

  // Detailed Breakdown
  scoreBreakdown        Json                // Detailed scoring factors
  matchedSkills         String[]            @default([])
  partialMatchSkills    Json?               // Skills with partial match
  missingSkills         String[]            @default([])
  bonusQualifications   String[]            @default([])

  // Experience Analysis
  experienceLevelFit    String?             // UNDER, MATCH, OVER
  yearsExperienceFit    String?             // Below, Match, Above
  seniorityFit          Float?              // 0-1 how well seniority matches

