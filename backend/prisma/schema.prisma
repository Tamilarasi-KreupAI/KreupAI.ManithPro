  // Match Analysis
  nameMatch             String?             // "exact", "partial", "mismatch"
  dateMatch             String?             // "exact", "approximate", "mismatch"
  holderMatch           String?             // "exact", "partial", "mismatch"
  overallMatch          String?             // "verified", "partial", "invalid", "expired"
  matchScore            Float?              // 0-100

  // Credential Status
  credentialStatus      String?             // "active", "expired", "revoked", "suspended"
  statusCheckedAt       DateTime?

