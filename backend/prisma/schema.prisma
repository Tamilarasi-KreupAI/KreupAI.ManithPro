// ============================================
// BATCH 5: VERIFICATION & TRUST SYSTEM (Features 1.3.1-1.3.5)
// ============================================

enum VerificationRequestStatus {
  PENDING
  SENT
  COMPLETED
  EXPIRED
  DECLINED
  FAILED
}

enum ReferenceRequestStatus {
  PENDING
  SENT
  IN_PROGRESS
  COMPLETED
  DECLINED
  EXPIRED
}

enum EndorsementRequestStatus {
  PENDING
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

// 1.3.1 - Email Domain Verification
model EmailDomainVerification {
  id                    String              @id @default(uuid())
  profileId             String

  // Work Experience Link
  workExperienceId      String?             // Optional link to work experience being verified

  // Email Details
  workEmail             String              // e.g., john@company.com
  emailDomain           String              // e.g., company.com
  companyName           String              // Company name from domain

  // Verification
  verificationCode      String?             // Code sent to work email
  verificationToken     String?             @unique // Token for verification link
  verificationStatus    VerificationRequestStatus @default(PENDING)

  // Verification Results
  isVerified            Boolean             @default(false)
  verifiedAt            DateTime?
  verificationMethod    String?             // "code", "link", "oauth"
  verificationAttempts  Int                 @default(0)
  maxAttempts           Int                 @default(3)

  // Domain Information (auto-detected)
  domainInfo            Json?               // Company info from domain lookup
  mxRecordValid         Boolean?            // MX record validation
  domainCreatedAt       DateTime?           // Domain age for trust scoring

  // Expiry
  expiresAt             DateTime?           // When verification expires
  codeSentAt            DateTime?           // When code was last sent

  // Timestamps
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  profile               CandidateProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, workEmail])
  @@index([profileId])
  @@index([emailDomain])
  @@index([verificationStatus])
  @@map("email_domain_verifications")
}

// 1.3.2 - LinkedIn Employment Verification
model LinkedInEmploymentVerification {
  id                    String              @id @default(uuid())
  profileId             String

  // Work Experience Link
  workExperienceId      String              @unique

  // LinkedIn Profile Link
  linkedInProfileId     String?             // Link to connected LinkedIn profile

  // Claimed Employment
  claimedCompanyName    String
  claimedTitle          String
  claimedStartDate      DateTime
  claimedEndDate        DateTime?
  claimedIsCurrent      Boolean             @default(false)

  // LinkedIn Data Match
  linkedInCompanyName   String?
  linkedInTitle         String?
  linkedInStartDate     DateTime?
  linkedInEndDate       DateTime?
  linkedInIsCurrent     Boolean?

  // Match Results
  companyNameMatch      String?             // "exact", "partial", "no_match", "not_found"
  titleMatch            String?             // "exact", "partial", "no_match", "not_found"
  dateMatch             String?             // "exact", "approximate", "no_match", "not_found"
  overallMatch          String?             // "verified", "partial", "unverified", "mismatch"
  matchScore            Float?              // 0-100 confidence score
  matchDetails          Json?               // Detailed match analysis

  // Verification Status
  verificationStatus    VerificationRequestStatus @default(PENDING)
  isVerified            Boolean             @default(false)
  verifiedAt            DateTime?
  verificationError     String?

  // Manual Review (if needed)
  needsManualReview     Boolean             @default(false)
  reviewedAt            DateTime?
  reviewedBy            String?
  reviewNotes           String?

  // Timestamps
  lastCheckedAt         DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  profile               CandidateProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([workExperienceId])
  @@index([verificationStatus])
  @@map("linkedin_employment_verifications")
}

// 1.3.3 - Peer Endorsements
model PeerEndorsement {
  id                    String              @id @default(uuid())
  profileId             String              // Profile being endorsed

  // Endorsement Request
  requestId             String?             @unique // For tracking requests
  requestStatus         EndorsementRequestStatus @default(PENDING)
  requestSentAt         DateTime?
  requestExpiresAt      DateTime?
  requestMessage        String?             // Personal message with request

  // Endorser Information
  endorserEmail         String
  endorserName          String
  endorserTitle         String?
  endorserCompany       String?
  endorserLinkedIn      String?
  endorserPhone         String?
  endorserAvatar        String?

  // Relationship Details
  relationship          String              // "colleague", "manager", "direct_report", "client", "mentor", "mentee"
  workedTogetherFrom    DateTime?
  workedTogetherTo      DateTime?
  workedAtCompany       String?
  sharedProjects        String[]            @default([])

  // Endorsement Content
  endorsementTitle      String?             // e.g., "Excellent Team Player"
  endorsementText       String?             // Detailed endorsement
  strengths             String[]            @default([]) // Key strengths mentioned
  areasOfExpertise      String[]            @default([])

  // Skill Endorsements
  skillEndorsements     Json?               // Array of {skillId, skillName, rating, comment}

  // Ratings
  overallRating         Int?                // 1-5 stars
  workQualityRating     Int?                // 1-5
  collaborationRating   Int?                // 1-5
  communicationRating   Int?                // 1-5
  leadershipRating      Int?                // 1-5
  technicalSkillsRating Int?                // 1-5
  reliabilityRating     Int?                // 1-5

  // Would Work With Again
  wouldWorkAgain        Boolean?
  wouldRecommend        Boolean?

  // Verification
  isVerified            Boolean             @default(false)
  verifiedAt            DateTime?
  verificationMethod    String?             // "email", "linkedin", "phone"
  verificationToken     String?             @unique

  // Privacy Settings
  isPublic              Boolean             @default(true)
  showOnProfile         Boolean             @default(true)
  anonymizeEndorser     Boolean             @default(false)

  // Timestamps
  endorsedAt            DateTime?           // When endorsement was submitted
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  profile               CandidateProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([endorserEmail])
  @@index([requestStatus])
  @@map("peer_endorsements")
}

// 1.3.4 - Manager References System
model ManagerReference {
