  // Team Dynamics
  teamSizePreference    String              // SMALL, MEDIUM, LARGE, FLEXIBLE
  leadershipStyle       String              // DIRECTIVE, COACHING, DELEGATING, SUPPORTIVE
  conflictResolution    String              // AVOIDANT, ACCOMMODATING, COMPETITIVE, COLLABORATIVE, COMPROMISING
  teamRoleArchetype     String              // DRIVER, ANALYST, COLLABORATOR, VISIONARY

  // Career Motivators
  primaryMotivators     String[]            @default([]) // e.g., ["compensation", "impact", "learning", "recognition"]
  careerPriorities      Json?               // {priority: weight}
  workLifeBalance       Float               // 0-100 importance

  // Company Type Fit
  preferredCompanySize  String              // STARTUP, SMALL, MEDIUM, LARGE, ENTERPRISE
  preferredIndustries   String[]            @default([])
  startupReadiness      Float               // 0-100
  corporateReadiness    Float               // 0-100

  // Risk Profile
  changeAdaptability    Float               // 0-100
  ambiguityTolerance    Float               // 0-100
  riskTolerance         String              // LOW, MODERATE, HIGH

  // AI Analysis
  strengthFactors       Json?               // Array of {factor, description, impact}
