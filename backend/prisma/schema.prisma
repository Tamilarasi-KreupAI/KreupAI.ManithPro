  // Timestamps
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([profileId, companyId, jobId])
  @@index([userId])
  @@index([overallCultureScore])
  @@map("culture_fit_analyses")
}

