  matchingVersion       String              @default("1.0")
  calculatedAt          DateTime            @default(now())
  expiresAt             DateTime?

  @@unique([candidateId, jobId])
  @@index([companyId])
  @@index([jobId])
  @@index([overallMatchScore])
  @@index([recommendation])
  @@map("candidate_match_scores")
}

// Matching Configuration
model MatchingConfig {
  id                    String              @id @default(uuid())
  companyId             String
  jobId                 String?             // null = company default

  // Weight Configuration
  skillWeight           Float               @default(0.35)
  experienceWeight      Float               @default(0.25)
  projectWeight         Float               @default(0.15)
  educationWeight       Float               @default(0.10)
  cultureFitWeight      Float               @default(0.10)
  bonusWeight           Float               @default(0.05)

  // Thresholds
  minimumMatchScore     Float               @default(50)
  hiddenTalentThreshold Float               @default(60)
  autoAdvanceThreshold  Float               @default(80)
