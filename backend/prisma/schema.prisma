  category              String
  subcategory           String?

  // Content
  title                 String
  description           String              @db.Text
  detailedExplanation   String?             @db.Text

  // Example
  exampleScenario       String?             @db.Text
  goodExample           String?             @db.Text
  badExample            String?             @db.Text

  // Applicability
  applicableRoles       String[]            @default([])
  applicableSeniorityLevels String[]        @default([])
  applicableInterviewTypes String[]         @default([])

  // Tips
  dosList               String[]            @default([])
  dontsList             String[]            @default([])
  commonMistakes        String[]            @default([])

  // Evidence
  sourceReference       String?
  successRate           Float?              // If tracked
  usageCount            Int                 @default(0)

  // Rating
  rating                Float               @default(0)
  ratingsCount          Int                 @default(0)
  feedback              Json?               // Array of feedback entries

  // Tags
  tags                  String[]            @default([])
  keywords              String[]            @default([])

  // Status
  isVerified            Boolean             @default(false)
  verifiedById          String?
  isActive              Boolean             @default(true)

  // Metadata
  createdById           String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([practiceType])
  @@index([category])
  @@map("best_practices")
}

// 4.3.5 - COMPETITOR INTELLIGENCE
model CompetitorIntelligence {
  id                    String              @id @default(uuid())

  // Competitor Info
  competitorName        String
  competitorWebsite     String?
  industry              String

  // Company Comparison
  ourCompany            String?             // Company for comparison context
  competitorSize        String?             // Estimated employee count
  marketPosition        String?             // LEADER, CHALLENGER, FOLLOWER, NICHE

  // Intelligence Type
  intelligenceType      String              // COMPENSATION, BENEFITS, CULTURE, TECH_STACK, HIRING_PRACTICES, TALENT_POOL

  // Compensation Intelligence
  salaryRanges          Json?               // { role: { min, max, median } }
  bonusStructure        String?
  equityOfferings       String?

  // Benefits Intelligence
  benefitsOffered       String[]            @default([])
  uniquePerks           String[]            @default([])
  benefitComparison     Json?               // Side-by-side comparison

  // Culture Intelligence
  cultureHighlights     String[]            @default([])
  workArrangement       String?             // REMOTE, HYBRID, ONSITE
  glassdoorRating       Float?
  reviewSummary         String?             @db.Text

  // Tech Stack
  techStackUsed         String[]            @default([])
  recentTechAdoptions   String[]            @default([])

  // Hiring Intelligence
  hiringVelocity        String?             // HIGH, MEDIUM, LOW
  openPositionsCount    Int?
  talentFocusAreas      String[]            @default([])
  hiringChallenges      String[]            @default([])

  // Talent Pool
  talentPoolOverlap     Float?              // % of talent they compete for
  poachingRisk          String?             // HIGH, MEDIUM, LOW
  retentionStrategies   String[]            @default([])

  // Key Insights
  strengthsVsUs         String[]            @default([])
  weaknessesVsUs        String[]            @default([])
  opportunities         String[]            @default([])
  threats               String[]            @default([])

  // Data Source
  dataSource            String?
  dataConfidence        String              @default("MEDIUM") // LOW, MEDIUM, HIGH
  lastVerified          DateTime?

  // Status
  isActive              Boolean             @default(true)

  // Metadata
  createdById           String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([competitorName])
  @@index([industry])
  @@index([intelligenceType])
  @@map("competitor_intelligence")
}

// 4.3.6 - DYNAMIC FAQ ANSWERS
model DynamicFAQ {
  id                    String              @id @default(uuid())

  // Question
  question              String              @db.Text
  questionVariants      String[]            @default([]) // Alternative phrasings
  questionCategory      String              // ROLE, COMPANY, BENEFITS, PROCESS, TEAM, TECHNICAL, CULTURE

  // Answer
  answer                String              @db.Text
  shortAnswer           String?             // Brief version
  detailedAnswer        String?             @db.Text // Extended version

  // Context
  applicableRoles       String[]            @default([]) // Empty means all roles
  applicableDepartments String[]            @default([])
  applicableJobIds      String[]            @default([])

  // AI Configuration
  useAIGeneration       Boolean             @default(false) // Should AI generate/enhance answer
  aiGeneratedAnswer     String?             @db.Text
  aiConfidence          Float?

  // Source
  sourceType            String              @default("MANUAL") // MANUAL, IMPORTED, AI_GENERATED
  sourceReference       String?

  // Embedding for semantic match
  embeddingVector       String?             @db.Text

  // Usage Stats
  timesAsked            Int                 @default(0)
  helpfulCount          Int                 @default(0)
  notHelpfulCount       Int                 @default(0)

  // Related
  relatedFAQIds         String[]            @default([])
  relatedTopics         String[]            @default([])

  // Visibility
  showToCandidates      Boolean             @default(true)
  showToInterviewers    Boolean             @default(true)

  // Status
  isActive              Boolean             @default(true)
  isVerified            Boolean             @default(false)
  verifiedById          String?

  // Metadata
  createdById           String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([questionCategory])
  @@index([isActive])
  @@map("dynamic_faqs")
}

// 4.3.7 - CONTINUOUS LEARNING (AI FEEDBACK)
model AIFeedbackLearning {
  id                    String              @id @default(uuid())

  // Context
  feedbackType          String              // ASSESSMENT_CORRECTION, SCORING_ADJUSTMENT, QUESTION_QUALITY, ANSWER_EVALUATION, RED_FLAG_ACCURACY

  // Source
  sourceEntityType      String              // INTERVIEW, TRANSCRIPTION, ANSWER_ANALYSIS, SUMMARY, RED_FLAG
  sourceEntityId        String

  // AI Output Being Evaluated
  originalAIOutput      Json                // What the AI produced
  aiConfidence          Float?              // AI's confidence in original output

  // Recruiter Feedback
  feedbackById          String
  feedbackRating        Int                 // 1-5 scale
  isAccurate            Boolean?
  accuracyPercentage    Float?              // 0-100

  // Corrections
  corrections           Json?               // What should have been output
  correctedFields       String[]            @default([])
  correctionNotes       String?             @db.Text

  // Categorization
  errorType             String?             // FALSE_POSITIVE, FALSE_NEGATIVE, OVERSCORED, UNDERSCORED, MISSED_CONTEXT
  impactLevel           String              @default("MEDIUM") // LOW, MEDIUM, HIGH

  // Training Signal
  shouldTrainOn         Boolean             @default(true)
  trainingWeight        Float               @default(1.0)
  isProcessedForTraining Boolean            @default(false)
  processedAt           DateTime?

  // Patterns
  relatedPatterns       String[]            @default([])
  suggestedImprovement  String?             @db.Text

  // Follow-up
  wasAddressed          Boolean             @default(false)
  addressedAt           DateTime?
  addressedNotes        String?

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([feedbackType])
  @@index([sourceEntityType, sourceEntityId])
  @@index([feedbackById])
  @@map("ai_feedback_learning")
}

// 4.3.8 - CUSTOM EVALUATION CRITERIA
model CustomEvaluationCriteria {
  id                    String              @id @default(uuid())

  // Scope
  companyName           String?
  department            String?
  roleTitle             String?
  jobId                 String?

  // Criterion Info
  criterionName         String
  criterionCode         String              // Short code for reference
  description           String              @db.Text
  category              String              // TECHNICAL, BEHAVIORAL, CULTURAL, COMMUNICATION, LEADERSHIP, PROBLEM_SOLVING

  // Importance
  weight                Float               @default(1.0) // Importance weight
  isMandatory           Boolean             @default(false)
  isKnockout            Boolean             @default(false) // Failing this disqualifies candidate

  // Scoring
  scoringType           String              @default("NUMERIC") // NUMERIC, PASS_FAIL, RUBRIC, COMPETENCY_LEVELS
  minScore              Float               @default(0)
  maxScore              Float               @default(5)
  passingScore          Float?

  // Rubric
  scoringRubric         Json?               // { 1: "description", 2: "description", ... }
  behavioralIndicators  Json?               // { level: ["indicators"] }

  // What to Look For
  positiveIndicators    String[]            @default([])
  negativeIndicators    String[]            @default([])
  questionSuggestions   String[]            @default([]) // Questions that help assess this

  // AI Guidance
  aiEvaluationPrompt    String?             @db.Text // Custom prompt for AI evaluation
  aiKeywords            String[]            @default([]) // Keywords AI should look for
  aiIgnoreKeywords      String[]            @default([]) // Keywords AI should ignore

  // Comparison
  industryBenchmark     Float?
  internalBenchmark     Float?
  topPerformerThreshold Float?

  // Examples
  idealResponse         String?             @db.Text
  acceptableResponse    String?             @db.Text
  poorResponse          String?             @db.Text

  // Status
  isActive              Boolean             @default(true)
  isTemplate            Boolean             @default(false)

  // Usage
  timesUsed             Int                 @default(0)
  averageScore          Float?

  // Metadata
  createdById           String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([companyName])
  @@index([category])
  @@index([roleTitle])
  @@map("custom_evaluation_criteria")
}

// ============================================
// BATCH 20: VIDEO INTERVIEW PLATFORM (4.4.1-4.4.12)
// ============================================

// 4.4.1 - BUILT-IN VIDEO CONFERENCING
model VideoRoom {
  id                    String              @id @default(uuid())

  // Room Info
  roomName              String
  roomCode              String              @unique
  roomType              String              // INTERVIEW, SCREENING, TECHNICAL, PANEL

  // Interview Context
  interviewId           String?
  jobId                 String?
  applicationId         String?

  // Host
  hostId                String
  coHostIds             String[]            @default([])

  // Participants
  maxParticipants       Int                 @default(10)
  currentParticipants   Int                 @default(0)
  participantIds        String[]            @default([])

  // Schedule
  scheduledStartTime    DateTime?
  scheduledEndTime      DateTime?
  actualStartTime       DateTime?
  actualEndTime         DateTime?
  duration              Int?                // Actual duration in minutes

  // Configuration
  waitingRoomEnabled    Boolean             @default(true)
  recordingEnabled      Boolean             @default(false)
  transcriptionEnabled  Boolean             @default(false)
  chatEnabled           Boolean             @default(true)
  screenShareEnabled    Boolean             @default(true)
  whiteboardEnabled     Boolean             @default(false)
  codeEditorEnabled     Boolean             @default(false)

  // Security
  password              String?
  requireApproval       Boolean             @default(true)
  allowedDomains        String[]            @default([])

  // Status
  status                String              @default("SCHEDULED") // SCHEDULED, WAITING, LIVE, ENDED, CANCELLED

  // Media Server
  serverRegion          String?
  serverUrl             String?
  iceServers            Json?

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  recordings            VideoRecording[]
  transcriptions        LiveTranscription[]
  participants          VideoParticipant[]
  chatMessages          VideoChatMessage[]
  whiteboardSessions    WhiteboardSession[]
  codeEditorSessions    CodeEditorSession[]

  @@index([hostId])
  @@index([status])
  @@index([scheduledStartTime])
  @@map("video_rooms")
}

// Video Participant
model VideoParticipant {
  id                    String              @id @default(uuid())
  roomId                String
  room                  VideoRoom           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId                String
  userEmail             String?
  userName              String?

  // Role
  role                  String              @default("PARTICIPANT") // HOST, CO_HOST, INTERVIEWER, CANDIDATE, OBSERVER

  // Status
  status                String              @default("INVITED") // INVITED, WAITING, JOINED, LEFT, REMOVED
  joinedAt              DateTime?
  leftAt                DateTime?

  // Media State
  audioEnabled          Boolean             @default(true)
  videoEnabled          Boolean             @default(true)
  screenSharing         Boolean             @default(false)

  // Virtual Background
  virtualBackgroundEnabled Boolean          @default(false)
  virtualBackgroundType String?             // BLUR, IMAGE, VIDEO
  virtualBackgroundUrl  String?

  // Connection
  connectionQuality     String?             // EXCELLENT, GOOD, FAIR, POOR
  deviceInfo            Json?

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([roomId])
  @@index([userId])
  @@map("video_participants")
}

// 4.4.2-4.4.4 - PLATFORM INTEGRATIONS (Zoom, Google Meet, Teams)
model VideoIntegration {
  id                    String              @id @default(uuid())
  userId                String
  platform              String              // ZOOM, GOOGLE_MEET, MICROSOFT_TEAMS

  // OAuth Tokens
  accessToken           String              @db.Text
  refreshToken          String?             @db.Text
  tokenExpiry           DateTime?
  scope                 String[]            @default([])

  // Account Info
  accountEmail          String?
  accountId             String?
  accountName           String?

  // Settings
  isDefault             Boolean             @default(false)
  autoCreateMeetings    Boolean             @default(true)
  defaultSettings       Json?               // Platform-specific defaults

  // Status
  isConnected           Boolean             @default(true)
  lastSyncAt            DateTime?
  errorMessage          String?

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  meetings              ExternalMeeting[]

  @@unique([userId, platform])
  @@index([platform])
  @@map("video_integrations")
}

// External Meeting (Zoom/Meet/Teams)
model ExternalMeeting {
  id                    String              @id @default(uuid())
  integrationId         String
  integration           VideoIntegration    @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  // Meeting Info
  platform              String              // ZOOM, GOOGLE_MEET, MICROSOFT_TEAMS
  externalMeetingId     String
  meetingUrl            String
  joinUrl               String
  hostUrl               String?
  password              String?

  // Context
  interviewId           String?
  jobId                 String?
  title                 String
  description           String?

  // Schedule
  scheduledStartTime    DateTime
  scheduledEndTime      DateTime?
  timezone              String?

  // Participants
  hostEmail             String
  attendeeEmails        String[]            @default([])

  // Settings
  waitingRoom           Boolean             @default(true)
  recordingEnabled      Boolean             @default(false)
  muteOnEntry           Boolean             @default(true)

  // Status
  status                String              @default("SCHEDULED") // SCHEDULED, STARTED, ENDED, CANCELLED
  startedAt             DateTime?
  endedAt               DateTime?

  // Recording
  recordingUrl          String?
  recordingDownloadUrl  String?
  recordingPassword     String?

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([integrationId])
  @@index([platform])
  @@index([interviewId])
  @@map("external_meetings")
}

// 4.4.5 - INTERVIEW RECORDING
model VideoRecording {
  id                    String              @id @default(uuid())
  roomId                String?
  room                  VideoRoom?          @relation(fields: [roomId], references: [id], onDelete: SetNull)

  // Recording Info
  recordingType         String              // FULL, AUDIO_ONLY, VIDEO_ONLY, SCREEN
  format                String              @default("MP4") // MP4, WEBM, MP3

  // Storage
  fileUrl               String?
  filePath              String?
  fileSize              Int?                // Size in bytes
  duration              Int?                // Duration in seconds

  // Processing
  processingStatus      String              @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  processedAt           DateTime?
  errorMessage          String?

  // Transcription Link
  transcriptionId       String?

  // Participants in Recording
  participantIds        String[]            @default([])

  // Consent
  consentObtained       Boolean             @default(false)
  consentTimestamp      DateTime?
  consentParticipantIds String[]            @default([])

  // Access Control
  isPublic              Boolean             @default(false)
  allowedUserIds        String[]            @default([])
  password              String?
  expiresAt             DateTime?

  // Analytics
  viewCount             Int                 @default(0)
  downloadCount         Int                 @default(0)

  // Metadata
  startedAt             DateTime?
  endedAt               DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([roomId])
  @@index([processingStatus])
  @@map("video_recordings")
}

// 4.4.6 - LIVE TRANSCRIPTION
model LiveTranscription {
  id                    String              @id @default(uuid())
  roomId                String?
  room                  VideoRoom?          @relation(fields: [roomId], references: [id], onDelete: SetNull)

  // Transcription Settings
  language              String              @default("en-US")
  isLive                Boolean             @default(true)

  // Content
  segments              Json                // Array of { speaker, text, startTime, endTime, confidence }
  fullText              String?             @db.Text

  // Speaker Identification
  speakerLabels         Json?               // { speakerId: participantInfo }
  speakerCount          Int                 @default(0)

  // Processing
  status                String              @default("LIVE") // LIVE, PROCESSING, COMPLETED, FAILED
  wordCount             Int                 @default(0)
  averageConfidence     Float?

  // Export
  exportFormats         String[]            @default([]) // VTT, SRT, TXT, JSON
  exportUrls            Json?               // { format: url }

  // Timing
  startedAt             DateTime?
  endedAt               DateTime?
  duration              Int?                // Duration in seconds

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([roomId])
  @@index([status])
  @@map("live_transcriptions")
}

// 4.4.7 - VIRTUAL BACKGROUNDS
model VirtualBackground {
  id                    String              @id @default(uuid())
  userId                String?             // Null for system backgrounds

  // Background Info
  name                  String
  type                  String              // BLUR, IMAGE, VIDEO, COLOR
  category              String?             // PROFESSIONAL, OFFICE, NATURE, ABSTRACT, CUSTOM

  // Media
  imageUrl              String?
  thumbnailUrl          String?
  videoUrl              String?
  color                 String?             // Hex color for solid backgrounds

  // Properties
  blurIntensity         Int?                // 1-10 for blur type

  // Status
  isSystem              Boolean             @default(false)
  isActive              Boolean             @default(true)
  isDefault             Boolean             @default(false)

  // Usage
  usageCount            Int                 @default(0)

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([userId])
  @@index([category])
  @@map("virtual_backgrounds")
}

// 4.4.8 - SCREEN SHARING (tracked via VideoParticipant)
// 4.4.9 - COLLABORATIVE WHITEBOARD
model WhiteboardSession {
  id                    String              @id @default(uuid())
  roomId                String?
  room                  VideoRoom?          @relation(fields: [roomId], references: [id], onDelete: SetNull)

  // Session Info
  name                  String?
  description           String?

  // Canvas
  canvasWidth           Int                 @default(1920)
  canvasHeight          Int                 @default(1080)
  backgroundColor       String              @default("#FFFFFF")

  // Content
  elements              Json                // Array of drawing elements
  currentVersion        Int                 @default(1)
  versionHistory        Json?               // Array of version snapshots

  // Collaboration
  activeEditors         String[]            @default([])
  maxEditors            Int                 @default(10)
  isLocked              Boolean             @default(false)

  // Tools Available
  availableTools        String[]            @default([]) // PEN, MARKER, ERASER, SHAPES, TEXT, IMAGE, STICKY

  // Export
  exportUrl             String?
  exportFormat          String?             // PNG, SVG, PDF

  // Status
  status                String              @default("ACTIVE") // ACTIVE, PAUSED, ENDED

  // Timing
  startedAt             DateTime            @default(now())
  endedAt               DateTime?

  // Metadata
  createdById           String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([roomId])
  @@index([status])
  @@map("whiteboard_sessions")
}

// 4.4.10 - LIVE CODE EDITOR
model CodeEditorSession {
  id                    String              @id @default(uuid())
  roomId                String?
  room                  VideoRoom?          @relation(fields: [roomId], references: [id], onDelete: SetNull)

  // Session Info
  title                 String?
  description           String?
  problemStatement      String?             @db.Text

  // Code
  language              String              @default("javascript")
  initialCode           String?             @db.Text
  currentCode           String?             @db.Text
  solutionCode          String?             @db.Text

  // Editor Settings
  theme                 String              @default("vs-dark")
  fontSize              Int                 @default(14)
  tabSize               Int                 @default(2)
  wordWrap              Boolean             @default(true)
  lineNumbers           Boolean             @default(true)

  // Collaboration
  activeEditors         String[]            @default([])
  cursorPositions       Json?               // { odingSessionId: { line, column } }
  isReadOnly            Boolean             @default(false)
  allowedEditors        String[]            @default([]) // Empty = all can edit

  // Execution
  lastExecutionResult   Json?               // { output, errors, executionTime }
  executionHistory      Json?               // Array of execution results
  executionEnabled      Boolean             @default(true)

  // Test Cases
  testCases             Json?               // Array of { input, expectedOutput, description }
  testResults           Json?               // Array of { passed, actualOutput, executionTime }

  // Version History
  versionHistory        Json?               // Array of code snapshots
  currentVersion        Int                 @default(1)

  // Status
  status                String              @default("ACTIVE") // ACTIVE, PAUSED, ENDED, SUBMITTED

  // Timing
  startedAt             DateTime            @default(now())
  endedAt               DateTime?
  timeLimit             Int?                // Time limit in minutes

  // Metadata
  createdById           String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([roomId])
  @@index([language])
  @@map("code_editor_sessions")
}

// Video Chat Message
model VideoChatMessage {
  id                    String              @id @default(uuid())
  roomId                String
  room                  VideoRoom           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId              String
  senderName            String

  // Message
  content               String              @db.Text
  messageType           String              @default("TEXT") // TEXT, FILE, SYSTEM, QUESTION

  // File Attachment
  fileUrl               String?
  fileName              String?
  fileType              String?
  fileSize              Int?

  // Status
  isDeleted             Boolean             @default(false)
  isPinned              Boolean             @default(false)

  // For Q&A
  isQuestion            Boolean             @default(false)
  isAnswered            Boolean             @default(false)
  answeredById          String?
  answerContent         String?

  // Visibility
  isPrivate             Boolean             @default(false)
  recipientId           String?             // For private messages

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([roomId])
  @@index([senderId])
  @@map("video_chat_messages")
}

// 4.4.11 - INTERVIEW TIMER
model InterviewTimer {
  id                    String              @id @default(uuid())
  roomId                String?

  // Timer Info
  timerType             String              // COUNTDOWN, SECTION, TOTAL
  name                  String?
  description           String?

  // Duration
  totalDuration         Int                 // Total time in seconds
  remainingTime         Int                 // Remaining time in seconds
  elapsedTime           Int                 @default(0) // Elapsed time in seconds

  // Sections (for multi-section timers)
  sections              Json?               // Array of { name, duration, order }
  currentSection        Int                 @default(0)

  // Status
  status                String              @default("STOPPED") // STOPPED, RUNNING, PAUSED, COMPLETED
  startedAt             DateTime?
  pausedAt              DateTime?
  completedAt           DateTime?

  // Alerts
  alertsEnabled         Boolean             @default(true)
  alertTimes            Int[]               @default([]) // Alert when X seconds remaining
  alertsSent            Int[]               @default([])

  // Visibility
  visibleToAll          Boolean             @default(true)
  visibleToRoles        String[]            @default([])

  // Metadata
  createdById           String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([roomId])
  @@index([status])
  @@map("interview_timers")
}

// 4.4.12 - ONE-WAY VIDEO INTERVIEW
model OneWayInterview {
  id                    String              @id @default(uuid())

  // Interview Context
  jobId                 String?
  applicationId         String?
  candidateId           String
  recruiterId           String

  // Interview Info
  title                 String
  description           String?             @db.Text
  instructions          String?             @db.Text

  // Questions
  questions             Json                // Array of { id, text, thinkTime, answerTime, maxRetakes }
  questionCount         Int                 @default(0)

  // Settings
  totalTimeLimit        Int?                // Total time limit in minutes
  allowRetakes          Boolean             @default(true)
  maxRetakesPerQuestion Int                 @default(2)
  showQuestionPreview   Boolean             @default(true)
  randomizeQuestions    Boolean             @default(false)

  // Deadline
  deadline              DateTime?
  remindersSent         Int                 @default(0)

  // Status
  status                String              @default("PENDING") // PENDING, IN_PROGRESS, SUBMITTED, REVIEWED, EXPIRED
  startedAt             DateTime?
  submittedAt           DateTime?
  reviewedAt            DateTime?
  expiredAt             DateTime?

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  responses             OneWayResponse[]

  @@index([candidateId])
  @@index([recruiterId])
  @@index([status])
  @@map("one_way_interviews")
}

// One-Way Interview Response
model OneWayResponse {
  id                    String              @id @default(uuid())
  interviewId           String
  interview             OneWayInterview     @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  questionId            String
  questionIndex         Int

  // Response
  videoUrl              String?
  videoPath             String?
  videoDuration         Int?                // Duration in seconds
  thumbnailUrl          String?

  // Retakes
  attemptNumber         Int                 @default(1)
  previousAttempts      Json?               // Array of previous video URLs

  // Timing
  thinkTimeUsed         Int?                // Seconds used for thinking
  answerTimeUsed        Int?                // Seconds used for answering
  startedAt             DateTime?
  completedAt           DateTime?

  // Transcription
  transcription         String?             @db.Text
  transcriptionStatus   String?             // PENDING, PROCESSING, COMPLETED

  // AI Analysis
  aiAnalysis            Json?               // Sentiment, keywords, etc.
  aiScore               Float?

  // Recruiter Review
  reviewerNotes         String?             @db.Text
  rating                Int?                // 1-5
  flagged               Boolean             @default(false)
  flagReason            String?

  // Status
  status                String              @default("PENDING") // PENDING, RECORDING, COMPLETED, SKIPPED

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([interviewId])
  @@index([questionId])
  @@map("one_way_responses")
