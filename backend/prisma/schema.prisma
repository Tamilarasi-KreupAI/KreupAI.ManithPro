  userAgent             String?

  // Rooms/Channels
  subscribedChannels    Json?               // List of channels subscribed to

  // Status
  isActive              Boolean             @default(true)
  disconnectedAt        DateTime?
  disconnectReason      String?

  @@index([userId])
  @@index([socketId])
  @@index([isActive])
  @@map("realtime_connections")
}

// 7.1.3 Real-Time Notifications
model RealtimeNotification {
  id                    String              @id @default(uuid())
  companyId             String?
  userId                String              // Recipient

  // Notification Content
  type                  String              // MESSAGE, APPLICATION, INTERVIEW, SYSTEM, etc.
  title                 String
  body                  String
  icon                  String?
  imageUrl              String?

  // Reference
  entityType            String?             // What entity this relates to
  entityId              String?
  actionUrl             String?             // URL to navigate to

  // Priority & Display
  priority              String              @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  sound                 Boolean             @default(true)
  vibrate               Boolean             @default(true)
  persistent            Boolean             @default(false)

  // Status
  isDelivered           Boolean             @default(false)
  deliveredAt           DateTime?
  isRead                Boolean             @default(false)
  readAt                DateTime?
  isDismissed           Boolean             @default(false)
  dismissedAt           DateTime?

  // Actions
  actions               Json?               // {id, label, action, url}[]

  // Metadata
  expiresAt             DateTime?
  metadata              Json?
  createdAt             DateTime            @default(now())

  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
  @@map("realtime_notifications")
}

// 7.1.4 Dashboard Live Update Subscriptions
model DashboardSubscription {
  id                    String              @id @default(uuid())
  userId                String
  dashboardId           String

  // Widgets subscribed to
  widgetIds             Json                // List of widget IDs to receive updates

  // Update Preferences
  refreshInterval       Int                 @default(30) // seconds
  autoRefresh           Boolean             @default(true)

  // Status
  isActive              Boolean             @default(true)

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([userId, dashboardId])
  @@index([userId])
  @@map("dashboard_subscriptions")
}

// 7.2.1-7.2.2 Conversations (DM and Group)
model Conversation {
  id                    String              @id @default(uuid())
  companyId             String?

  // Type
  type                  String              @default("DIRECT") // DIRECT, GROUP, CHANNEL
  name                  String?             // For groups/channels
  description           String?
  avatarUrl             String?

  // Context (optional)
  contextType           String?             // JOB, APPLICATION, INTERVIEW
  contextId             String?

  // Settings
  isArchived            Boolean             @default(false)
  isMuted               Boolean             @default(false)
  allowReactions        Boolean             @default(true)
  allowAttachments      Boolean             @default(true)

  // Group Settings
  isPublic              Boolean             @default(false)
  maxParticipants       Int?

  // Activity
  lastMessageId         String?
  lastMessageAt         DateTime?
  messageCount          Int                 @default(0)

  // Metadata
  createdBy             String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  participants          ConversationParticipant[]
  messages              Message[]

  @@index([companyId])
  @@index([type])
  @@index([contextType, contextId])
  @@index([lastMessageAt])
  @@map("conversations")
}

// Conversation Participants
model ConversationParticipant {
  id                    String              @id @default(uuid())
  conversationId        String
  userId                String

  // Role
  role                  String              @default("MEMBER") // OWNER, ADMIN, MEMBER

  // Status
  isActive              Boolean             @default(true)
  isMuted               Boolean             @default(false)
  isPinned              Boolean             @default(false)

  // Read Status
  lastReadMessageId     String?
  lastReadAt            DateTime?
  unreadCount           Int                 @default(0)

  // Notifications
  notifyOnMessage       Boolean             @default(true)
  notifyOnMention       Boolean             @default(true)

  // Metadata
  joinedAt              DateTime            @default(now())
  leftAt                DateTime?
  removedBy             String?

  // Relations
  conversation          Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
  @@map("conversation_participants")
}

// 7.2.1 Messages
model Message {
  id                    String              @id @default(uuid())
  conversationId        String
  senderId              String

  // Content
  type                  String              @default("TEXT") // TEXT, IMAGE, FILE, AUDIO, SYSTEM
  content               String?             @db.Text
  richContent           Json?               // For rich text formatting

  // Reply
  replyToId             String?             // Parent message for threads
  threadCount           Int                 @default(0)

  // Mentions
  mentions              Json?               // {userId, startIndex, length}[]

  // Status
  status                String              @default("SENT") // SENDING, SENT, DELIVERED, READ, FAILED
  editedAt              DateTime?
  deletedAt             DateTime?
  deletedBy             String?

  // Delivery Tracking (7.1.6)
  deliveredTo           Json?               // {userId: deliveredAt}
  readBy                Json?               // {userId: readAt}

  // Metadata
  metadata              Json?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  conversation          Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments           MessageAttachment[]
  reactions             MessageReaction[]

  @@index([conversationId])
  @@index([senderId])
  @@index([replyToId])
  @@index([createdAt])
  @@map("messages")
}

// 7.2.1 Message Reactions
model MessageReaction {
  id                    String              @id @default(uuid())
  messageId             String
  userId                String

  // Reaction
  emoji                 String              // Unicode emoji or custom code

  // Metadata
  createdAt             DateTime            @default(now())

  // Relations
  message               Message             @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("message_reactions")
}

// 7.2.6 Message Attachments
model MessageAttachment {
  id                    String              @id @default(uuid())
  messageId             String

  // File Info
  fileName              String
  fileType              String              // MIME type
  fileSize              Int                 // bytes
  fileUrl               String
  thumbnailUrl          String?

  // Type
  attachmentType        String              // IMAGE, DOCUMENT, AUDIO, VIDEO, OTHER

  // Processing
  isProcessed           Boolean             @default(false)
  processingError       String?

  // Metadata
  dimensions            Json?               // {width, height} for images/videos
  duration              Int?                // seconds for audio/video
  metadata              Json?

  createdAt             DateTime            @default(now())

  // Relations
  message               Message             @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_attachments")
}

// 7.2.3 Message Templates
model MessageTemplate {
  id                    String              @id @default(uuid())
  companyId             String?
  userId                String?             // Personal templates

  // Template Info
  name                  String
  shortcut              String?             // e.g., "/thanks" for quick insert
  category              String              // GREETING, FOLLOWUP, REJECTION, CUSTOM

  // Content
  content               String              @db.Text
  richContent           Json?               // For rich text
  variables             Json?               // {name, placeholder, defaultValue}[]

  // Usage
  usageCount            Int                 @default(0)
  lastUsedAt            DateTime?

  // Settings
  isShared              Boolean             @default(false)
  isActive              Boolean             @default(true)

  // Metadata
  createdBy             String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([companyId])
  @@index([userId])
  @@index([category])
  @@index([shortcut])
  @@map("message_templates")
}

// 7.2.4 Scheduled Messages
model ScheduledMessage {
  id                    String              @id @default(uuid())
  conversationId        String
  senderId              String

  // Content
  type                  String              @default("TEXT")
  content               String              @db.Text
  richContent           Json?
  attachmentIds         Json?               // Pre-uploaded attachment IDs

  // Schedule
  scheduledFor          DateTime
  timezone              String              @default("UTC")

  // Status
  status                String              @default("PENDING") // PENDING, SENT, CANCELLED, FAILED
  sentAt                DateTime?
  sentMessageId         String?             // ID of actual message once sent
  failureReason         String?

  // Recurrence (optional)
  isRecurring           Boolean             @default(false)
  recurrenceRule        Json?               // {frequency, interval, endDate, etc.}

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([senderId])
  @@index([conversationId])
  @@index([scheduledFor])
  @@index([status])
  @@map("scheduled_messages")
}

// 7.2.8 Email Fallback Settings
model EmailFallbackConfig {
  id                    String              @id @default(uuid())
  userId                String              @unique

  // Settings
  enabled               Boolean             @default(true)
  offlineMinutes        Int                 @default(15) // Send email if offline for this long
  digestMode            Boolean             @default(false) // Bundle into digest vs individual
  digestIntervalHours   Int                 @default(4)

  // Preferences
  includeContent        Boolean             @default(true)
  includeSender         Boolean             @default(true)
  maxEmailsPerDay       Int                 @default(50)

  // Tracking
  lastDigestSent        DateTime?
  emailsSentToday       Int                 @default(0)

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([userId])
  @@map("email_fallback_configs")
}

// 7.1.5 Typing Indicators (Stored briefly)
model TypingIndicator {
  id                    String              @id @default(uuid())
  conversationId        String
  userId                String

  // Status
  isTyping              Boolean             @default(true)
  startedAt             DateTime            @default(now())
  expiresAt             DateTime            // Auto-expire after ~5 seconds

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([expiresAt])
  @@map("typing_indicators")
}

// ============================================================================
// BATCH 27: AUTHENTICATION & ACCESS (8.1.1-8.1.11)
// ============================================================================

// 8.1.1 Two-Factor Authentication
model TwoFactorAuth {
  id                    String              @id @default(uuid())
  userId                String              @unique

  // 2FA Status
  enabled               Boolean             @default(false)
  method                String              @default("TOTP") // TOTP, SMS, EMAIL, BACKUP_CODES
  verifiedAt            DateTime?

  // TOTP Settings
  totpSecret            String?             // Encrypted TOTP secret
  totpVerified          Boolean             @default(false)

  // SMS Settings
  phoneNumber           String?
  phoneVerified         Boolean             @default(false)

  // Email Settings
  emailVerified         Boolean             @default(false)

  // Backup Codes
  backupCodes           Json?               // Array of hashed backup codes
  backupCodesUsed       Int                 @default(0)
  backupCodesGenerated  DateTime?

  // Recovery
  recoveryEmail         String?
  recoveryPhone         String?

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([userId])
  @@map("two_factor_auth")
}

// 8.1.2, 8.1.3 SSO Provider Configuration
model SSOProvider {
  id                    String              @id @default(uuid())
  organizationId        String?             // Optional, for org-specific SSO

  // Provider Info
  name                  String              // Display name
  type                  String              // SAML, OAUTH2, OIDC
  isEnabled             Boolean             @default(true)
  isDefault             Boolean             @default(false)

  // SAML Configuration
  samlEntityId          String?
  samlSsoUrl            String?
  samlCertificate       String?             // Public certificate
  samlLogoutUrl         String?
  samlNameIdFormat      String?             @default("email")

  // OAuth2/OIDC Configuration
  clientId              String?
  clientSecret          String?             // Encrypted
  authorizationUrl      String?
  tokenUrl              String?
  userInfoUrl           String?
  scopes                String[]            @default([])
  callbackUrl           String?

  // Provider-specific (Google, Microsoft, Okta)
  provider              String?             // google, microsoft, okta, custom
  tenantId              String?             // For Microsoft Azure AD
  oktaDomain            String?             // For Okta

  // Attribute Mapping
  attributeMapping      Json?               // Map SSO attributes to user fields

  // Domain restrictions
  allowedDomains        String[]            @default([])

  // Auto-provisioning
  autoCreateUsers       Boolean             @default(false)
  defaultRole           String              @default("CANDIDATE")

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  sessions              SSOSession[]

  @@index([organizationId])
  @@index([type])
  @@map("sso_providers")
}

// SSO Session Tracking
model SSOSession {
  id                    String              @id @default(uuid())
  userId                String
  providerId            String

  // Session Info
  ssoSessionId          String?             // Provider's session ID
  accessToken           String?             // Encrypted
  refreshToken          String?             // Encrypted
  idToken               String?             // Encrypted

  // Token expiry
  accessTokenExpiry     DateTime?
  refreshTokenExpiry    DateTime?

  // Status
  isActive              Boolean             @default(true)
  revokedAt             DateTime?
  revokedReason         String?

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  lastUsedAt            DateTime            @default(now())

  // Relations
  provider              SSOProvider         @relation(fields: [providerId], references: [id])

  @@index([userId])
  @@index([providerId])
  @@index([ssoSessionId])
  @@map("sso_sessions")
}

// 8.1.4 Password Policy Configuration
model PasswordPolicy {
  id                    String              @id @default(uuid())
  organizationId        String?             @unique // null for global policy

  // Complexity Requirements
  minLength             Int                 @default(8)
  maxLength             Int                 @default(128)
  requireUppercase      Boolean             @default(true)
  requireLowercase      Boolean             @default(true)
  requireNumbers        Boolean             @default(true)
  requireSpecialChars   Boolean             @default(true)
  specialCharsAllowed   String              @default("!@#$%^&*()_+-=[]{}|;:,.<>?")

  // History & Rotation
  passwordHistoryCount  Int                 @default(5) // Prevent reuse of last N passwords
  maxPasswordAgeDays    Int                 @default(90) // Force rotation after N days
  minPasswordAgeDays    Int                 @default(1) // Prevent immediate re-change
  warnBeforeExpireDays  Int                 @default(14)

  // Lockout
  maxFailedAttempts     Int                 @default(5)
  lockoutDurationMins   Int                 @default(30)
  resetCounterAfterMins Int                 @default(60)

  // Additional Rules
  preventCommonPasswords Boolean            @default(true)
  preventUserInfoInPwd  Boolean             @default(true) // No name/email in password

  // Metadata
  isActive              Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([organizationId])
  @@map("password_policies")
}

// Password History for preventing reuse
model PasswordHistory {
  id                    String              @id @default(uuid())
  userId                String
  passwordHash          String              // Hashed password

  createdAt             DateTime            @default(now())

  @@index([userId])
  @@map("password_history")
}

// 8.1.5 Session Management
model UserSession {
  id                    String              @id @default(uuid())
  userId                String
  sessionToken          String              @unique

  // Device Info
  deviceId              String?
  deviceType            String?             // desktop, mobile, tablet
  deviceName            String?
  browser               String?
  browserVersion        String?
  operatingSystem       String?
  osVersion             String?

  // Location
  ipAddress             String?
  country               String?
  region                String?
  city                  String?
  latitude              Float?
  longitude             Float?

  // Status
  isActive              Boolean             @default(true)
  lastActivityAt        DateTime            @default(now())
  expiresAt             DateTime
  terminatedAt          DateTime?
  terminatedReason      String?             // logout, timeout, forced, security

  // Security
  isTrusted             Boolean             @default(false)
  riskScore             Int                 @default(0)

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([userId])
  @@index([sessionToken])
  @@index([isActive])
  @@index([expiresAt])
  @@map("user_sessions")
}

// Session Settings per user/org
model SessionSettings {
  id                    String              @id @default(uuid())
  userId                String?             @unique // User-specific settings
  organizationId        String?             @unique // Org-wide settings

  // Timeout settings
  sessionTimeoutMins    Int                 @default(30)
  idleTimeoutMins       Int                 @default(15)
  absoluteTimeoutHours  Int                 @default(24)

  // Concurrent sessions
  maxConcurrentSessions Int                 @default(5)
  singleSessionOnly     Boolean             @default(false)
  terminateOldest       Boolean             @default(true) // When limit reached

  // Remember me
  allowRememberMe       Boolean             @default(true)
  rememberMeDays        Int                 @default(30)

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@map("session_settings")
}

// 8.1.6 IP Whitelisting
model IPWhitelist {
  id                    String              @id @default(uuid())
  organizationId        String?

  // IP Configuration
  name                  String
  description           String?
  ipAddress             String?             // Single IP
  ipRangeStart          String?             // Range start
  ipRangeEnd            String?             // Range end
  cidrBlock             String?             // CIDR notation (e.g., 192.168.1.0/24)

  // Scope
  appliesToAll          Boolean             @default(true)
  appliesToRoles        String[]            @default([])
  appliesToUsers        String[]            @default([])

  // Status
  isEnabled             Boolean             @default(true)
  enforcementMode       String              @default("BLOCK") // BLOCK, WARN, LOG

  // Time-based restrictions
  activeStartTime       String?             // HH:MM format
  activeEndTime         String?
  activeDays            String[]            @default([]) // MON, TUE, etc.

  // Metadata
  createdBy             String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([organizationId])
  @@index([isEnabled])
  @@map("ip_whitelists")
}

// 8.1.7 Trusted Devices
model TrustedDevice {
  id                    String              @id @default(uuid())
  userId                String

  // Device Fingerprint
  deviceFingerprint     String              // Hashed device fingerprint
  deviceId              String?             // Optional persistent ID

  // Device Info
  deviceName            String?
  deviceType            String              // desktop, mobile, tablet
  browser               String?
  browserVersion        String?
  operatingSystem       String?
  osVersion             String?

  // Trust Status
  isTrusted             Boolean             @default(true)
  trustLevel            String              @default("STANDARD") // STANDARD, HIGH, ALWAYS
  verificationMethod    String?             // 2fa, email, sms

  // Last seen
  lastUsedAt            DateTime            @default(now())
  lastIpAddress         String?
  lastLocation          String?

  // Expiry
  expiresAt             DateTime?           // null = never expires
  autoRenew             Boolean             @default(true)

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  revokedAt             DateTime?
  revokedReason         String?

  @@unique([userId, deviceFingerprint])
  @@index([userId])
  @@index([isTrusted])
  @@map("trusted_devices")
}

// 8.1.8 Login Attempts for Anomaly Detection
model LoginAttempt {
  id                    String              @id @default(uuid())
  userId                String?             // null if user not found

  // Attempt details
  email                 String
  success               Boolean
  failureReason         String?             // invalid_password, account_locked, 2fa_failed, etc.

  // Client info
  ipAddress             String
  userAgent             String?
  deviceFingerprint     String?

  // Location
  country               String?
  region                String?
  city                  String?
  latitude              Float?
  longitude             Float?

  // Risk assessment
  riskScore             Int                 @default(0)
  riskFactors           Json?               // Array of detected risk factors
  isAnomaly             Boolean             @default(false)
  anomalyType           String?             // new_location, new_device, impossible_travel, etc.

  // Action taken
  actionTaken           String?             // allowed, blocked, challenged

  // Metadata
  createdAt             DateTime            @default(now())

  @@index([userId])
  @@index([email])
  @@index([ipAddress])
  @@index([createdAt])
  @@index([isAnomaly])
  @@map("login_attempts")
}

// Login Anomaly Configuration
model LoginAnomalyConfig {
  id                    String              @id @default(uuid())
  organizationId        String?             @unique

  // Detection settings
  enableAnomalyDetection Boolean            @default(true)
  enableImpossibleTravel Boolean            @default(true)
  enableNewLocationAlert Boolean            @default(true)
  enableNewDeviceAlert   Boolean            @default(true)
  enableBruteForceDetect Boolean            @default(true)

  // Thresholds
  maxTravelSpeedKmh     Int                 @default(1000) // For impossible travel
  suspiciousCountryList String[]            @default([])
  blockedCountryList    String[]            @default([])

  // Action configuration
  anomalyAction         String              @default("CHALLENGE") // BLOCK, CHALLENGE, WARN, LOG
  alertAdmins           Boolean             @default(true)
  alertUser             Boolean             @default(true)

  // ML model settings
  modelSensitivity      String              @default("MEDIUM") // LOW, MEDIUM, HIGH
  learningPeriodDays    Int                 @default(30)

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@map("login_anomaly_configs")
}

// 8.1.9 API Key Management
model APIKey {
  id                    String              @id @default(uuid())
  userId                String
  organizationId        String?

  // Key info
  name                  String
  description           String?
  keyPrefix             String              // First few chars for identification
  keyHash               String              // Hashed full key
  lastFourChars         String              // Last 4 chars for display

  // Permissions
  scopes                String[]            @default([]) // read:jobs, write:applications, etc.
  allowedEndpoints      String[]            @default([]) // Specific endpoint restrictions
  allowedIPs            String[]            @default([]) // IP restrictions

  // Rate limiting
  rateLimit             Int                 @default(1000) // Requests per hour
  rateLimitWindow       Int                 @default(3600) // Window in seconds

  // Status
  isActive              Boolean             @default(true)
  expiresAt             DateTime?

  // Usage tracking
  lastUsedAt            DateTime?
  lastUsedIP            String?
  totalRequests         Int                 @default(0)

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  revokedAt             DateTime?
  revokedBy             String?
  revokedReason         String?

  // Relations
  usageLogs             APIKeyUsageLog[]

  @@index([userId])
  @@index([organizationId])
  @@index([keyPrefix])
  @@index([isActive])
  @@map("api_keys")
}

// API Key Usage Logs
model APIKeyUsageLog {
  id                    String              @id @default(uuid())
  apiKeyId              String

  // Request info
  endpoint              String
  method                String
  statusCode            Int
  responseTimeMs        Int

  // Client info
  ipAddress             String
  userAgent             String?

  // Metadata
  createdAt             DateTime            @default(now())

  // Relations
  apiKey                APIKey              @relation(fields: [apiKeyId], references: [id])

  @@index([apiKeyId])
  @@index([createdAt])
  @@map("api_key_usage_logs")
}

// 8.1.10 Role-Based Access Control (RBAC)
model Role {
  id                    String              @id @default(uuid())
  organizationId        String?

  // Role info
  name                  String
  displayName           String
  description           String?

  // Hierarchy
  level                 Int                 @default(0) // Higher = more permissions
  parentRoleId          String?             // For role inheritance

  // Status
  isSystem              Boolean             @default(false) // Built-in roles
  isActive              Boolean             @default(true)

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  permissions           RolePermission[]
  userRoles             UserRole[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

// Permission definitions
model Permission {
  id                    String              @id @default(uuid())

  // Permission info
  name                  String              @unique // e.g., jobs:create, applications:read
  displayName           String
  description           String?
  category              String              // jobs, applications, users, admin, etc.

  // Resource info
  resource              String              // jobs, applications, users, etc.
  action                String              // create, read, update, delete, manage

  // Status
  isSystem              Boolean             @default(false)

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  rolePermissions       RolePermission[]
  userOverrides         UserPermissionOverride[]

  @@index([category])
  @@index([resource])
  @@map("permissions")
}

// Role-Permission mapping
model RolePermission {
  id                    String              @id @default(uuid())
  roleId                String
  permissionId          String

  // Grant type
  grantType             String              @default("ALLOW") // ALLOW, DENY

  // Conditions
  conditions            Json?               // Additional conditions for this permission

  // Metadata
  createdAt             DateTime            @default(now())

  // Relations
  role                  Role                @relation(fields: [roleId], references: [id])
  permission            Permission          @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// User Role assignments
model UserRole {
  id                    String              @id @default(uuid())
  userId                String
  roleId                String

  // Scope
  organizationId        String?
  departmentId          String?

  // Time-bound access
  startsAt              DateTime            @default(now())
  expiresAt             DateTime?

  // Metadata
  assignedBy            String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  role                  Role                @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId, organizationId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

// User-level permission overrides
model UserPermissionOverride {
  id                    String              @id @default(uuid())
  userId                String
  permissionId          String

  // Override type
  grantType             String              // ALLOW, DENY

  // Scope
  organizationId        String?
  resourceId            String?             // Specific resource ID

  // Time-bound
  expiresAt             DateTime?

  // Metadata
  reason                String?
  grantedBy             String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  permission            Permission          @relation(fields: [permissionId], references: [id])

  @@unique([userId, permissionId, organizationId, resourceId])
  @@index([userId])
  @@index([permissionId])
  @@map("user_permission_overrides")
}

// 8.1.11 Attribute-Based Access Control (ABAC)
model ABACPolicy {
  id                    String              @id @default(uuid())
  organizationId        String?

  // Policy info
  name                  String
  description           String?
  priority              Int                 @default(0) // Higher = evaluated first

  // Target
  targetResource        String              // jobs, applications, users, etc.
  targetAction          String?             // create, read, update, delete, * for all

  // Conditions (evaluated at runtime)
  conditions            Json                // Complex condition tree
  /*
    Example conditions:
    {
      "all": [
        { "attribute": "user.role", "operator": "eq", "value": "RECRUITER" },
        { "attribute": "resource.department", "operator": "eq", "value": "${user.department}" },
        { "attribute": "time.hour", "operator": "between", "value": [9, 17] }
      ]
    }
  */

  // Effect
  effect                String              @default("ALLOW") // ALLOW, DENY

  // Status
  isEnabled             Boolean             @default(true)

  // Metadata
  createdBy             String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([organizationId])
  @@index([targetResource])
  @@index([isEnabled])
  @@map("abac_policies")
}

// ABAC Attribute Definitions
model ABACAttribute {
  id                    String              @id @default(uuid())

  // Attribute info
  name                  String              @unique // user.department, resource.owner, etc.
  displayName           String
  description           String?

  // Type info
  category              String              // user, resource, environment, context
  dataType              String              // string, number, boolean, array, date

  // Source
  source                String              // database, jwt, header, computed
  sourcePath            String?             // Path to extract value (e.g., jwt.claims.department)

  // Validation
  allowedValues         Json?               // For enum-like attributes

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([category])
  @@map("abac_attributes")
}

// Security Audit Log
model SecurityAuditLog {
  id                    String              @id @default(uuid())
  userId                String?

  // Event info
  eventType             String              // login, logout, password_change, 2fa_enable, etc.
  eventCategory         String              // authentication, authorization, configuration
  eventAction           String              // success, failure, attempt

  // Details
  description           String
  details               Json?               // Additional event-specific details

  // Target
  targetType            String?             // user, role, permission, policy
  targetId              String?

  // Client info
  ipAddress             String?
  userAgent             String?
  sessionId             String?

  // Risk
  riskLevel             String              @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL

  // Metadata
  createdAt             DateTime            @default(now())

  @@index([userId])
  @@index([eventType])
  @@index([eventCategory])
  @@index([createdAt])
  @@index([riskLevel])
  @@map("security_audit_logs")
}

// ============================================================================
// BATCH 28: DATA PROTECTION (8.2.1-8.2.8)
// ============================================================================

// 8.2.1, 8.2.8 Encryption Key Management
model EncryptionKey {
  id                    String              @id @default(uuid())
  organizationId        String?

  // Key Info
  name                  String
  description           String?
  keyType               String              // MASTER, DATA, FIELD, BACKUP
  algorithm             String              @default("AES-256-GCM")

  // Key Material (encrypted with master key or HSM)
  encryptedKeyMaterial  String
  keyCheckValue         String?             // KCV for verification

  // Version & Rotation
  version               Int                 @default(1)
  previousKeyId         String?             // For key rotation
  rotationDue           DateTime?

  // Status
  status                String              @default("ACTIVE") // ACTIVE, PENDING_ROTATION, ROTATED, REVOKED, DESTROYED
  activatedAt           DateTime?
  expiresAt             DateTime?

  // Usage
  purpose               String[]            @default([]) // database, files, backups, api_tokens
  allowedOperations     String[]            @default([]) // encrypt, decrypt, sign, verify

  // HSM Integration
  isHSMKey              Boolean             @default(false)
  hsmKeyId              String?
  hsmProvider           String?             // aws_kms, azure_keyvault, gcp_kms, hashicorp_vault

  // Audit
  lastUsedAt            DateTime?
  usageCount            Int                 @default(0)

  // Metadata
  createdBy             String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([organizationId, name, version])
  @@index([organizationId])
  @@index([keyType])
  @@index([status])
  @@map("encryption_keys")
}

// Key Rotation Schedule
model KeyRotationSchedule {
  id                    String              @id @default(uuid())
  keyId                 String

  // Schedule
  rotationIntervalDays  Int                 @default(90)
  nextRotationAt        DateTime
  lastRotationAt        DateTime?

  // Notifications
  notifyBeforeDays      Int                 @default(14)
  notifyEmails          String[]            @default([])

  // Auto rotation
  autoRotate            Boolean             @default(false)
  autoRevokeOldDays     Int                 @default(30)

  // Status
  isEnabled             Boolean             @default(true)

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([keyId])
  @@index([nextRotationAt])
  @@map("key_rotation_schedules")
}

// 8.2.3 PII Detection & Masking Configuration
model PIIDetectionConfig {
  id                    String              @id @default(uuid())
  organizationId        String?

  // Detection settings
  isEnabled             Boolean             @default(true)
  scanFrequency         String              @default("REALTIME") // REALTIME, HOURLY, DAILY

  // PII Types to detect
  detectEmail           Boolean             @default(true)
  detectPhone           Boolean             @default(true)
  detectSSN             Boolean             @default(true)
  detectCreditCard      Boolean             @default(true)
  detectAddress         Boolean             @default(true)
  detectDOB             Boolean             @default(true)
  detectPassport        Boolean             @default(true)
  detectDriverLicense   Boolean             @default(true)
  customPatterns        Json?               // Custom regex patterns

  // Action settings
  defaultAction         String              @default("MASK") // MASK, ENCRYPT, REDACT, LOG_ONLY
  maskingChar           String              @default("*")
  preserveFormat        Boolean             @default(true)

  // Notifications
  alertOnDetection      Boolean             @default(true)
  alertEmails           String[]            @default([])

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([organizationId])
  @@map("pii_detection_configs")
}

// PII Detection Log
model PIIDetectionLog {
  id                    String              @id @default(uuid())
  organizationId        String?

  // Detection info
  sourceType            String              // database, upload, api_request
  sourceLocation        String              // table.column, file_path, endpoint
  recordId              String?

  // PII found
  piiType               String              // email, phone, ssn, etc.
  piiCount              Int                 @default(1)
  confidence            Float               // 0-1 confidence score

  // Action taken
  actionTaken           String              // masked, encrypted, redacted, logged
  originalHash          String?             // Hash of original for verification

  // Metadata
  detectedAt            DateTime            @default(now())
  processedBy           String?

  @@index([organizationId])
  @@index([piiType])
  @@index([detectedAt])
  @@map("pii_detection_logs")
}

// 8.2.4 Data Anonymization Rules
model AnonymizationRule {
  id                    String              @id @default(uuid())
  organizationId        String?

  // Rule info
  name                  String
  description           String?
  isEnabled             Boolean             @default(true)

  // Target
  targetTable           String
  targetColumn          String

  // Anonymization method
  method                String              // hash, fake, mask, shuffle, null, generalize
  methodConfig          Json?               // Method-specific config

  // Conditional application
  conditions            Json?               // When to apply (e.g., only for certain roles)

  // Metadata
  createdBy             String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([organizationId, targetTable, targetColumn])
  @@index([organizationId])
  @@index([targetTable])
  @@map("anonymization_rules")
}

// Anonymization Job
model AnonymizationJob {
  id                    String              @id @default(uuid())
  organizationId        String?

  // Job info
  name                  String
  description           String?
  jobType               String              // FULL, INCREMENTAL, SELECTIVE

  // Scope
  targetEnvironment     String              // production, staging, analytics
  includeTables         String[]            @default([])
  excludeTables         String[]            @default([])
  ruleIds               String[]            @default([])

  // Execution
  status                String              @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED
  startedAt             DateTime?
  completedAt           DateTime?
  recordsProcessed      Int                 @default(0)
  errorCount            Int                 @default(0)
  errorLog              Json?

  // Scheduling
  isScheduled           Boolean             @default(false)
  cronExpression        String?
  nextRunAt             DateTime?

  // Metadata
  createdBy             String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([nextRunAt])
  @@map("anonymization_jobs")
}

// 8.2.5 Secure File Storage
model SecureFile {
  id                    String              @id @default(uuid())
  organizationId        String?
  uploadedBy            String?

  // File info
  originalName          String
  storedName            String              // UUID-based name
  mimeType              String
  fileSize              Int

  // Storage location
  storageProvider       String              @default("LOCAL") // LOCAL, S3, AZURE_BLOB, GCS
  storagePath           String
  storageRegion         String?

  // Encryption
  isEncrypted           Boolean             @default(true)
  encryptionKeyId       String?
  encryptionAlgorithm   String?             @default("AES-256-GCM")
  checksum              String?             // SHA-256 of encrypted content

  // Classification
  classification        String              @default("INTERNAL") // PUBLIC, INTERNAL, CONFIDENTIAL, RESTRICTED
  containsPII           Boolean             @default(false)
  piiTypes              String[]            @default([])

  // Access control
  accessLevel           String              @default("OWNER") // PUBLIC, AUTHENTICATED, OWNER, SPECIFIC
  allowedUsers          String[]            @default([])
  allowedRoles          String[]            @default([])

  // Retention
  retentionPolicy       String?
  expiresAt             DateTime?
  deletedAt             DateTime?
  deleteReason          String?

  // Versioning
  version               Int                 @default(1)
  previousVersionId     String?

  // Audit
  downloadCount         Int                 @default(0)
  lastAccessedAt        DateTime?

  // Metadata
  metadata              Json?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  accessLogs            FileAccessLog[]

  @@index([organizationId])
  @@index([uploadedBy])
  @@index([classification])
  @@index([containsPII])
  @@index([expiresAt])
  @@map("secure_files")
}

// File Access Log
model FileAccessLog {
  id                    String              @id @default(uuid())
  fileId                String
  userId                String?

  // Access info
  action                String              // VIEW, DOWNLOAD, SHARE, DELETE
  ipAddress             String?
  userAgent             String?

  // Outcome
  success               Boolean             @default(true)
  failureReason         String?

  // Metadata
  accessedAt            DateTime            @default(now())

  // Relations
  file                  SecureFile          @relation(fields: [fileId], references: [id])

  @@index([fileId])
  @@index([userId])
  @@index([accessedAt])
  @@map("file_access_logs")
}

// 8.2.6 Data Residency Configuration
model DataResidencyConfig {
  id                    String              @id @default(uuid())
  organizationId        String              @unique

  // Primary Region
  primaryRegion         String              // us-east, eu-west, ap-south, etc.
  primaryProvider       String              // aws, azure, gcp

  // Data categories and their regions
  piiDataRegion         String?             // Override for PII data
  backupRegion          String?             // Region for backups
  analyticsRegion       String?             // Region for analytics data

  // Replication
  enableReplication     Boolean             @default(false)
  replicaRegions        String[]            @default([])

  // Compliance
  gdprCompliant         Boolean             @default(false)
  ccpaCompliant         Boolean             @default(false)
  hipaaCompliant        Boolean             @default(false)

  // Transfer rules
  allowCrossBorderTransfer Boolean          @default(true)
  approvedCountries     String[]            @default([])
  blockedCountries      String[]            @default([])

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@map("data_residency_configs")
}

// 8.2.7 Backup & Recovery
model BackupConfig {
  id                    String              @id @default(uuid())
  organizationId        String?

  // Backup settings
  name                  String
  description           String?
  isEnabled             Boolean             @default(true)

  // Scope
  backupType            String              @default("FULL") // FULL, INCREMENTAL, DIFFERENTIAL
  includeTables         String[]            @default([])
  excludeTables         String[]            @default([])
  includeFiles          Boolean             @default(true)

  // Schedule
  schedule              String              // cron expression
  retentionDays         Int                 @default(30)
  maxBackups            Int                 @default(10)

  // Storage
  storageProvider       String              // LOCAL, S3, AZURE_BLOB, GCS
  storagePath           String
  storageRegion         String?

  // Encryption
  encryptBackups        Boolean             @default(true)
  encryptionKeyId       String?

  // Notifications
  notifyOnSuccess       Boolean             @default(false)
  notifyOnFailure       Boolean             @default(true)
  notifyEmails          String[]            @default([])

  // Metadata
  createdBy             String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  backups               Backup[]

  @@index([organizationId])
  @@map("backup_configs")
}

// Backup Record
model Backup {
  id                    String              @id @default(uuid())
  configId              String
  organizationId        String?

  // Backup info
  backupType            String              // FULL, INCREMENTAL, DIFFERENTIAL
  status                String              @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED, VERIFYING

  // Timing
  startedAt             DateTime?
  completedAt           DateTime?
  duration              Int?                // seconds

  // Size
  sizeBytes             BigInt?
  compressedSizeBytes   BigInt?
  recordCount           Int?

  // Storage
  storagePath           String?
  storageRegion         String?

  // Encryption
  isEncrypted           Boolean             @default(true)
  encryptionKeyId       String?
  checksum              String?

  // Verification
  verifiedAt            DateTime?
  isVerified            Boolean             @default(false)
  verificationResult    Json?

  // Retention
  expiresAt             DateTime?
  deletedAt             DateTime?

  // Error handling
  errorMessage          String?
  errorDetails          Json?
  retryCount            Int                 @default(0)

  // Metadata
  triggeredBy           String?             // SCHEDULED, MANUAL, API
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  config                BackupConfig        @relation(fields: [configId], references: [id])
  restores              RestoreJob[]

  @@index([configId])
  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
  @@index([expiresAt])
  @@map("backups")
}

// Restore Job
model RestoreJob {
  id                    String              @id @default(uuid())
  backupId              String
  organizationId        String?

  // Restore info
  restoreType           String              // FULL, PARTIAL, POINT_IN_TIME
  targetEnvironment     String              // production, staging, new_instance

  // Scope
  includeTables         String[]            @default([])
  excludeTables         String[]            @default([])
  pointInTime           DateTime?

  // Status
  status                String              @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED, CANCELLED

  // Progress
  startedAt             DateTime?
  completedAt           DateTime?
  progress              Int                 @default(0)       // percentage
  recordsRestored       Int                 @default(0)

  // Error handling
  errorMessage          String?
  errorDetails          Json?

  // Validation
  validateAfterRestore  Boolean             @default(true)
  validationResult      Json?

  // Metadata
  requestedBy           String
  approvedBy            String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  backup                Backup              @relation(fields: [backupId], references: [id])

  @@index([backupId])
  @@index([organizationId])
  @@index([status])
  @@map("restore_jobs")
}

// 8.2.2 TLS Configuration (for compliance tracking)
model TLSConfig {
  id                    String              @id @default(uuid())
  organizationId        String?             @unique

  // TLS Settings
  minVersion            String              @default("1.2") // 1.2, 1.3
  preferredVersion      String              @default("1.3")

  // Cipher suites
  allowedCipherSuites   String[]            @default([])
  blockedCipherSuites   String[]            @default([])

  // Certificate
  certificateProvider   String?             // letsencrypt, digicert, custom
  certificateExpiry     DateTime?
  autoRenew             Boolean             @default(true)
  renewBeforeDays       Int                 @default(30)

  // HSTS
  hstsEnabled           Boolean             @default(true)
  hstsMaxAge            Int                 @default(31536000)
  hstsIncludeSubdomains Boolean             @default(true)
  hstsPreload           Boolean             @default(false)

  // Other security headers
  enableCertTransparency Boolean            @default(true)
  enableOCSPStapling     Boolean            @default(true)

  // Metadata
  lastAuditedAt         DateTime?
  auditResult           Json?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@map("tls_configs")
}

// Data Protection Audit Log
model DataProtectionAuditLog {
  id                    String              @id @default(uuid())
  organizationId        String?
  userId                String?

  // Event info
  eventType             String              // encryption, decryption, key_access, backup, restore, pii_access
  eventCategory         String              // keys, data, files, backups

  // Resource
  resourceType          String              // key, file, table, backup
  resourceId            String

  // Details
  description           String
  details               Json?

  // Outcome
  success               Boolean             @default(true)
  failureReason         String?

  // Client info
  ipAddress             String?
  userAgent             String?

  // Metadata
  createdAt             DateTime            @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([eventType])
  @@index([resourceType])
  @@index([createdAt])
  @@map("data_protection_audit_logs")
}
