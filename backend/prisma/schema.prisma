  lastVerificationAttempt DateTime?
  verificationAttempts  Int                 @default(0)

  // Manual Review
  needsManualReview     Boolean             @default(false)
  reviewedAt            DateTime?
  reviewedBy            String?
  reviewNotes           String?

  // Auto-Reverification
  autoReverify          Boolean             @default(true)
  nextReverificationAt  DateTime?

  // Timestamps
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  profile               CandidateProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([certificationId])
  @@index([verificationStatus])
  @@index([isVerified])
