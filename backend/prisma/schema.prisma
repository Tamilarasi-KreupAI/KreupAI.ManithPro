  // Custom Rules
  mustHaveSkills        String[]            @default([])
  niceToHaveSkills      String[]            @default([])
  dealBreakerMissing    String[]            @default([])
  customRules           Json?               // Custom matching rules

  // Metadata
  isActive              Boolean             @default(true)
  createdById           String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([companyId, jobId])
  @@index([companyId])
  @@map("matching_configs")
}

