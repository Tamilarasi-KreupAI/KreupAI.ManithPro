  confidenceLevel       String              // HIGH, MEDIUM, LOW

  // Improvement Suggestions
  immediateActions      Json                // What to do right now
  profileImprovements   Json                // Profile changes to make
  followUpAdvice        Json                // When/how to follow up
  interviewTips         Json?               // If interview pending

  // Timeline Expectations
  expectedNextStep      String              // What happens next
  expectedTimeline      String              // When to expect news
  typicalProcessLength  Int                 // Days for full process
  urgencyLevel          String              // HIGH, MEDIUM, LOW

  // Historical Context
  companyHiringPattern  Json                // How this company typically hires
  roleCompetitiveness   String              // How competitive this role is
  seasonalFactors       Json?               // Time of year factors

  // Red Flags & Opportunities
  redFlags              Json                // Warning signs
  positiveSignals       Json                // Good signs
  dealBreakers          Json                // What could disqualify

  // Metadata
  modelVersion          String
  generatedAt           DateTime            @default(now())
  expiresAt             DateTime            // Insights become stale
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([applicationId])
  @@index([userId])
  @@map("application_insights")
}

// 2.3.10 - PORTFOLIO FEEDBACK
model PortfolioFeedback {
  id                    String              @id @default(uuid())
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Portfolio Details
  portfolioUrl          String?
  portfolioType         String              // GITHUB, PERSONAL_WEBSITE, BEHANCE, DRIBBBLE, OTHER
  projectCount          Int
  analyzedProjects      Json                // Projects that were analyzed

