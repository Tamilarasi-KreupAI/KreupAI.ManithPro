  // Work Style Preferences (0-100 alignment scores)
  workStyleAlignment    Float
  collaborationStyle    String              // HIGHLY_COLLABORATIVE, BALANCED, INDEPENDENT
  communicationStyle    String              // FORMAL, CASUAL, ASYNC_FIRST, MEETING_HEAVY
  decisionMaking        String              // AUTONOMOUS, CONSULTATIVE, CONSENSUS
  feedbackPreference    String              // DIRECT, SUPPORTIVE, STRUCTURED

