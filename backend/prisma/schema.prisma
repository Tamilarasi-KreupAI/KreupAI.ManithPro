  recommendationScore   Float               // 0-100 effectiveness
  recommendationRank    Int
  confidenceLevel       Float               // Confidence in recommendation

  // Channel Metrics
  expectedCandidates    Int?                // Expected volume
  expectedQuality       Float?              // Quality score 0-1
  expectedCost          Float?              // Cost per hire
  expectedTimeToHire    Int?                // Days
  historicalSuccessRate Float?              // Past success %

  // Why Recommended
  channelStrengths      String[]            @default([])
  bestFor               String[]            @default([]) // What this channel excels at
  considerations        String[]            @default([])

  // Historical Data
  pastHiresFromChannel  Int                 @default(0)
  pastSuccessRate       Float?
  avgTimeToHire         Int?
  avgCostPerHire        Float?

  // Action Items
  suggestedActions      Json                // How to use this channel
  budgetRecommendation  Float?
  timelineRecommendation String?

  // Metadata
  generatedAt           DateTime            @default(now())
  dataFreshness         DateTime?
  updatedAt             DateTime            @updatedAt

  @@index([companyId])
  @@index([jobId])
  @@index([channelName])
  @@index([recommendationScore])
