// 1.2.1 - GitHub Integration
model GithubProfile {
  id                    String              @id @default(uuid())
  profileId             String              @unique

  // GitHub Account Info
  githubId              String              @unique
  username              String
  displayName           String?
  avatarUrl             String?
  profileUrl            String
  bio                   String?
  company               String?
  location              String?
  blog                  String?
  email                 String?

  // Statistics
  publicRepos           Int                 @default(0)
  privateRepos          Int                 @default(0)
  totalStars            Int                 @default(0)
  followers             Int                 @default(0)
  following             Int                 @default(0)
  gists                 Int                 @default(0)

  // Contribution Data
  totalContributions    Int                 @default(0)
  contributionsLastYear Int                 @default(0)
  longestStreak         Int                 @default(0)
  currentStreak         Int                 @default(0)

  // Languages & Skills
  topLanguages          Json?               // Array of {name, percentage, bytes}
  pinnedRepos           Json?               // Array of pinned repository data

  // Activity
  recentActivity        Json?               // Recent commits, PRs, issues
  contributionGraph     Json?               // Contribution data for heatmap

  // Connection Status
  status                IntegrationStatus   @default(CONNECTED)
  accessToken           String?             // Encrypted OAuth token
  refreshToken          String?             // Encrypted refresh token
  tokenExpiresAt        DateTime?
  scopes                String[]            @default([])

  // Sync Info
  lastSyncAt            DateTime?
  syncError             String?
  autoSync              Boolean             @default(true)

  // Timestamps
  connectedAt           DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  profile               CandidateProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  repositories          GithubRepository[]

  @@index([profileId])
  @@index([username])
  @@index([status])
  @@map("github_profiles")
}

model GithubRepository {
  id                    String              @id @default(uuid())
  githubProfileId       String

  // Repository Info
  repoId                String              // GitHub repo ID
  name                  String
  fullName              String
  description           String?
  language              String?
  languages             Json?               // All languages with bytes

  // URLs
  htmlUrl               String
  cloneUrl              String?
  homepage              String?

  // Stats
  stars                 Int                 @default(0)
  forks                 Int                 @default(0)
  watchers              Int                 @default(0)
  openIssues            Int                 @default(0)
  size                  Int                 @default(0)

  // Features
  hasWiki               Boolean             @default(false)
  hasPages              Boolean             @default(false)
  hasProjects           Boolean             @default(false)
  hasDiscussions        Boolean             @default(false)

  // Topics & Categories
  topics                String[]            @default([])
  isForked              Boolean             @default(false)
  isFork                Boolean             @default(false)
  isArchived            Boolean             @default(false)
  isPrivate             Boolean             @default(false)

