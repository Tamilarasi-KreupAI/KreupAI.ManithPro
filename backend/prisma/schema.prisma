// ============================================
// 2.4 NLP & CONTENT ANALYSIS
// ============================================

// 2.4.1 - RESUME/PROFILE PARSER
model ParsedDocument {
  id                    String              @id @default(uuid())
  userId                String?
  user                  User?               @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Document Info
  documentType          String              // RESUME, CV, LINKEDIN_EXPORT, PROFILE_EXPORT
  fileName              String?
  fileUrl               String?
  rawText               String?             // Extracted text
  fileHash              String?             // For deduplication

  // Parsed Sections
  contactInfo           Json                // Name, email, phone, location
  summary               String?             // Professional summary
  workExperience        Json                // Array of work experiences
  education             Json                // Array of education
  skills                Json                // Extracted skills with categories
  certifications        Json                // Certifications
  projects              Json                // Projects
  publications          Json?               // Publications if any
  awards                Json?               // Awards/honors
  languages             Json?               // Languages spoken
  volunteerWork         Json?               // Volunteer experience
  additionalSections    Json?               // Other sections

  // Quality Metrics
  parseConfidence       Float               // How confident in parsing
  completenessScore     Float               // How complete the document is
  formatQuality         String              // EXCELLENT, GOOD, FAIR, POOR
  issues                Json                // Parsing issues encountered

  // Extracted Entities
  companies             Json                // Companies mentioned
  technologies          Json                // Technologies mentioned
  locations             Json                // Locations mentioned
  dates                 Json                // Dates extracted
  urls                  Json                // URLs found

  // Analysis
  seniorityLevel        String?             // Inferred seniority
  industryFocus         Json?               // Industries worked in
  careerProgression     Json?               // Career trajectory analysis
  keyAchievements       Json?               // Key achievements extracted

  // Status
  status                String              @default("PARSED") // PARSING, PARSED, FAILED, NEEDS_REVIEW
  errorMessage          String?

  // Metadata
  modelVersion          String
  processingTime        Int?                // Milliseconds to parse
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([userId])
  @@index([fileHash])
  @@map("parsed_documents")
}

// 2.4.2 - SKILL EXTRACTION
model SkillExtraction {
  id                    String              @id @default(uuid())
  userId                String?
  user                  User?               @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Source
  sourceType            String              // RESUME, JOB_DESCRIPTION, PROFILE, PROJECT, FREE_TEXT
  sourceId              String?             // ID of source document
  sourceText            String              // Text that was analyzed

  // Extracted Skills
  skills                Json                // Array of extracted skills
  skillCategories       Json                // Skills grouped by category
  skillLevels           Json                // Inferred proficiency levels
  skillRelationships    Json                // Related skills graph

  // Technical Skills
  programmingLanguages  Json
  frameworks            Json
  databases             Json
  cloudPlatforms        Json
  tools                 Json
  methodologies         Json

  // Soft Skills
  softSkills            Json
  leadershipSkills      Json
  communicationSkills   Json

  // Domain Skills
  domainExpertise       Json                // Industry-specific knowledge
  certificationSkills   Json                // Skills from certifications

  // Skill Insights
  coreCompetencies      Json                // Primary skills
  emergingSkills        Json                // Recently acquired
  legacySkills          Json                // Older/outdated skills
  rarityScores          Json                // How rare each skill is

  // Market Analysis
  marketDemand          Json                // Demand for each skill
  salaryImpact          Json                // Salary impact of skills
  trendingSkills        Json                // Which skills are trending

  // Confidence
  overallConfidence     Float
  perSkillConfidence    Json                // Confidence per skill

  // Metadata
  modelVersion          String
  processingTime        Int?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([userId])
  @@index([sourceType, sourceId])
  @@map("skill_extractions")
}

// 2.4.3 - SEMANTIC SEARCH INDEX
model SemanticSearchIndex {
  id                    String              @id @default(uuid())

  // Entity Reference
  entityType            String              // CANDIDATE, JOB, PROJECT, COMPANY
  entityId              String              // ID of the entity
  userId                String?             // If candidate-related
  user                  User?               @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Text Content
  title                 String              // Main title/name
  content               String              // Full searchable content
  summary               String?             // Short summary
  keywords              Json                // Extracted keywords

  // Vector Embeddings (stored as JSON array)
  embedding             Json                // Vector embedding for semantic search
  embeddingModel        String              // Model used for embedding
  embeddingDimension    Int                 // Dimension of embedding vector

  // Categorization
  category              String?             // Primary category
  subcategories         Json?               // Subcategories
  tags                  Json?               // Tags for filtering
  skills                Json?               // Skills if applicable
  industries            Json?               // Industries if applicable
  locations             Json?               // Locations if applicable

  // Metadata for Search
  seniorityLevel        String?
  experienceYears       Int?
  salaryMin             Float?
  salaryMax             Float?
  remoteEligible        Boolean?

  // Search Quality
  contentQuality        Float               // Quality score for ranking
  freshness             DateTime            // When content was last updated
  popularity            Float               @default(0) // Click/view score

  // Status
  status                String              @default("ACTIVE") // ACTIVE, STALE, DELETED
  lastIndexed           DateTime            @default(now())

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([entityType, entityId])
  @@index([userId])
  @@index([entityType])
  @@index([status])
  @@map("semantic_search_index")
}

// 2.4.4 - ENTITY RECOGNITION
model EntityRecognition {
  id                    String              @id @default(uuid())
  userId                String?
  user                  User?               @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Source
  sourceType            String              // RESUME, JOB_DESCRIPTION, MESSAGE, PROFILE
  sourceId              String?
  sourceText            String

  // Recognized Entities
  people                Json                // Names of people
  organizations         Json                // Company names
  locations             Json                // Cities, countries, addresses
  dates                 Json                // Dates and time periods
  money                 Json                // Salaries, budgets
  percentages           Json                // Percentages
  quantities            Json                // Numbers and quantities

  // Technology Entities
  technologies          Json                // Tech stack, tools
  products              Json                // Product names
  platforms             Json                // Platforms (AWS, GCP, etc)
  languages             Json                // Programming languages

  // Professional Entities
  jobTitles             Json                // Job titles mentioned
  degrees               Json                // Educational degrees
  certifications        Json                // Certification names
  universities          Json                // Universities
  industries            Json                // Industry references

  // Relationships
  entityRelationships   Json                // Relationships between entities
  timeline              Json                // Temporal relationships

  // Confidence Scores
  perEntityConfidence   Json                // Confidence per entity
  overallConfidence     Float

  // Normalized Entities
  normalizedEntities    Json                // Entities mapped to standard forms

  // Metadata
  modelVersion          String
  processingTime        Int?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([userId])
  @@index([sourceType, sourceId])
  @@map("entity_recognitions")
}

// ============================================
// BATCH 15: SMART CALENDAR & AUTOMATED SCHEDULING
// Features 3.1.1-3.2.4
// ============================================

// 3.1.1-3.1.5 - CALENDAR INTEGRATIONS
model CalendarIntegration {
  id                    String              @id @default(uuid())
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Integration Type
  provider              String              // GOOGLE, OUTLOOK, APPLE, ICAL, OTHER
  name                  String              // Display name
  email                 String?             // Calendar email
  isDefault             Boolean             @default(false)
  isPrimary             Boolean             @default(false)

  // OAuth Credentials (encrypted in production)
  accessToken           String?
  refreshToken          String?
  tokenExpiry           DateTime?
  scope                 String?

  // iCal/CalDAV Settings
  calendarUrl           String?             // For iCal feeds
  caldavUrl             String?             // For CalDAV
  caldavUsername        String?
  caldavPassword        String?             // Encrypted

  // Sync Settings
  syncEnabled           Boolean             @default(true)
  syncDirection         String              @default("BIDIRECTIONAL") // INBOUND, OUTBOUND, BIDIRECTIONAL
  lastSyncAt            DateTime?
  syncStatus            String              @default("PENDING") // PENDING, SYNCING, SYNCED, ERROR
  syncError             String?

  // Calendar Settings
  color                 String?             // Calendar color
  timezone              String              @default("UTC")
  showInAvailability    Boolean             @default(true)

  // Metadata
  externalCalendarId    String?             // ID in external system
  metadata              Json?               // Provider-specific metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  events                CalendarEvent[]

  @@unique([userId, provider, email])
  @@index([userId])
  @@index([provider])
  @@map("calendar_integrations")
}

model CalendarEvent {
  id                    String              @id @default(uuid())
  calendarId            String
  calendar              CalendarIntegration @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Event Details
  title                 String
  description           String?
  location              String?
  meetingLink           String?

  // Time
  startTime             DateTime
  endTime               DateTime
  allDay                Boolean             @default(false)
  timezone              String              @default("UTC")

  // Recurrence
  isRecurring           Boolean             @default(false)
  recurrenceRule        String?             // RRULE format
  recurrenceId          String?             // For recurring instances

  // Status
  status                String              @default("CONFIRMED") // CONFIRMED, TENTATIVE, CANCELLED
  visibility            String              @default("BUSY") // BUSY, FREE, TENTATIVE

  // External Reference
  externalEventId       String?             // ID in external calendar
  externalLink          String?             // Link to external event

  // Interview Link
  interviewId           String?
  applicationId         String?

  // Attendees (stored as JSON for flexibility)
  attendees             Json?               // Array of attendee objects
  organizer             Json?               // Organizer info

  // Sync Status
  syncStatus            String              @default("SYNCED") // SYNCED, PENDING_SYNC, CONFLICT
  lastSyncAt            DateTime?

  // Metadata
  metadata              Json?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([calendarId])
  @@index([userId])
  @@index([startTime, endTime])
  @@map("calendar_events")
}

// 3.1.6 - CALENDAR CONFLICT DETECTION
model CalendarConflict {
  id                    String              @id @default(uuid())
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Conflicting Events
  event1Id              String
  event2Id              String
  event1Title           String
  event2Title           String
  event1Start           DateTime
  event1End             DateTime
  event2Start           DateTime
  event2End             DateTime

  // Conflict Details
  conflictType          String              // OVERLAP, BACK_TO_BACK, TRAVEL_TIME, BUFFER_VIOLATION
  overlapMinutes        Int                 // Minutes of overlap
  severity              String              // LOW, MEDIUM, HIGH, CRITICAL

  // Resolution
  status                String              @default("UNRESOLVED") // UNRESOLVED, RESOLVED, IGNORED
  resolution            String?             // How it was resolved
  resolvedAt            DateTime?
  resolvedBy            String?

  // Suggestions
  suggestions           Json?               // AI suggestions for resolution

  // Metadata
  detectedAt            DateTime            @default(now())
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([userId])
  @@index([status])
  @@map("calendar_conflicts")
}

// 3.1.7 - BUFFER TIME SETTINGS
model BufferTimeSettings {
  id                    String              @id @default(uuid())
  userId                String              @unique
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Default Buffer Times
  beforeMeeting         Int                 @default(0) // Minutes before meeting
  afterMeeting          Int                 @default(0) // Minutes after meeting

  // Interview-Specific Buffers
  beforeInterview       Int                 @default(15)
  afterInterview        Int                 @default(10)

  // Travel Time
  includeTravel         Boolean             @default(false)
  defaultTravelTime     Int                 @default(30)

  // Type-Specific Settings
  phoneScreenBuffer     Int                 @default(5)
  videoInterviewBuffer  Int                 @default(10)
  onsiteInterviewBuffer Int                 @default(30)
  panelInterviewBuffer  Int                 @default(15)

  // Auto-Apply Settings
  autoApply             Boolean             @default(true)
  applyToExternal       Boolean             @default(false) // Apply to external calendar events too

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@map("buffer_time_settings")
}

// 3.1.8 - WORKING HOURS CONFIGURATION
model WorkingHours {
  id                    String              @id @default(uuid())
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Basic Settings
  name                  String              @default("Default")
  timezone              String              @default("UTC")
  isDefault             Boolean             @default(false)

  // Weekly Schedule (JSON for flexibility)
  // Format: { dayOfWeek: { enabled: boolean, slots: [{ start: "09:00", end: "17:00" }] } }
  monday                Json
  tuesday               Json
  wednesday             Json
  thursday              Json
  friday                Json
  saturday              Json
  sunday                Json

  // Availability Preferences
  minNoticeHours        Int                 @default(24) // Minimum notice for scheduling
  maxAdvanceDays        Int                 @default(30) // How far in advance to allow scheduling
  slotDuration          Int                 @default(30) // Default slot duration in minutes
  slotIncrement         Int                 @default(15) // Increment for slot start times

  // Lunch/Break Settings
  lunchStart            String?             // e.g., "12:00"
  lunchEnd              String?             // e.g., "13:00"
  excludeLunch          Boolean             @default(true)

  // Effective Dates
  effectiveFrom         DateTime?
  effectiveTo           DateTime?

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([userId])
  @@map("working_hours")
}

// 3.1.9 - HOLIDAY CALENDAR
model HolidayCalendar {
  id                    String              @id @default(uuid())
  userId                String?
  user                  User?               @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Holiday Info
  name                  String
  date                  DateTime
  endDate               DateTime?           // For multi-day holidays
  isRecurring           Boolean             @default(true)
  recurrenceRule        String?             // RRULE for recurring holidays

  // Classification
  type                  String              // PUBLIC, COMPANY, PERSONAL, RELIGIOUS, OBSERVANCE
  country               String?             // ISO country code
  region                String?             // State/Province
  isOfficial            Boolean             @default(false)

  // Blocking Settings
  blockEntireDay        Boolean             @default(true)
  blockStart            String?             // Partial day block start
  blockEnd              String?             // Partial day block end

  // Scope
  scope                 String              @default("USER") // USER, COMPANY, GLOBAL
  companyId             String?             // For company-wide holidays

  // Metadata
  source                String?             // Where this holiday data came from
  externalId            String?             // ID in external holiday API
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([userId])
  @@index([date])
  @@index([country, region])
  @@map("holiday_calendars")
}

// 3.2.1 - SELF-SCHEDULING LINKS
model SchedulingLink {
  id                    String              @id @default(uuid())
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Link Settings
  slug                  String              @unique // URL-friendly slug
  name                  String
  description           String?
  isActive              Boolean             @default(true)

  // Meeting Type
  meetingType           String              // PHONE_SCREEN, VIDEO_INTERVIEW, ONSITE, PANEL, CUSTOM
  duration              Int                 // Duration in minutes
  location              String?             // Physical location or video link type

  // Availability
  workingHoursId        String?             // Link to specific working hours
  bufferBefore          Int                 @default(0)
  bufferAfter           Int                 @default(0)
  minNotice             Int                 @default(24) // Hours
  maxAdvance            Int                 @default(30) // Days

  // Booking Limits
  maxBookingsPerDay     Int?
  maxBookingsPerWeek    Int?

  // Confirmation Settings
  requireConfirmation   Boolean             @default(false)
  autoConfirm           Boolean             @default(true)
  confirmationMessage   String?

  // Questions for Booker
  questions             Json?               // Array of questions to ask

  // Notifications
  notifyOnBooking       Boolean             @default(true)
  reminderSchedule      Json?               // When to send reminders

  // Branding
  brandColor            String?
  logoUrl               String?
  welcomeMessage        String?

  // Job/Application Link
  jobId                 String?
  applicationId         String?

  // Analytics
  viewCount             Int                 @default(0)
  bookingCount          Int                 @default(0)

  // Expiry
  expiresAt             DateTime?

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  bookings              SchedulingBooking[]

  @@index([userId])
  @@index([slug])
  @@map("scheduling_links")
}

model SchedulingBooking {
  id                    String              @id @default(uuid())
  linkId                String
  link                  SchedulingLink      @relation(fields: [linkId], references: [id], onDelete: Cascade)

  // Booker Info
  bookerEmail           String
  bookerName            String
  bookerPhone           String?
  bookerTimezone        String

  // Booking Details
  startTime             DateTime
  endTime               DateTime
  status                String              @default("PENDING") // PENDING, CONFIRMED, CANCELLED, COMPLETED, NO_SHOW

  // Associated Records
  candidateId           String?
  applicationId         String?
  interviewId           String?

  // Question Responses
  responses             Json?

  // Meeting Details
  meetingLink           String?
  meetingPassword       String?
  location              String?

  // Confirmation
  confirmationToken     String?
  confirmedAt           DateTime?
  cancelledAt           DateTime?
  cancellationReason    String?

  // Reminders
  remindersSent         Json?               // Track which reminders were sent

  // Metadata
  ipAddress             String?
  userAgent             String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([linkId])
  @@index([bookerEmail])
  @@index([startTime])
  @@map("scheduling_bookings")
}

// 3.2.2 - AUTO-AVAILABILITY DETECTION
model AvailabilitySlot {
  id                    String              @id @default(uuid())
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Time Slot
  date                  DateTime            @db.Date
  startTime             DateTime
  endTime               DateTime
  timezone              String              @default("UTC")

  // Availability Status
  status                String              @default("AVAILABLE") // AVAILABLE, BUSY, TENTATIVE, BLOCKED
  source                String              // CALENDAR_SYNC, MANUAL, WORKING_HOURS, HOLIDAY

  // Slot Quality
  preferenceScore       Float               @default(1.0) // 0-1, higher is more preferred
  isOptimal             Boolean             @default(false) // AI-determined optimal slot

  // Conflicts
  hasConflict           Boolean             @default(false)
  conflictEventId       String?

  // For Panel Scheduling
  isPanelSlot           Boolean             @default(false)
  panelSessionId        String?

  // Metadata
  generatedAt           DateTime            @default(now())
  expiresAt             DateTime            // When this slot data becomes stale
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([userId, date])
  @@index([status])
  @@map("availability_slots")
}

// 3.2.3 - PANEL INTERVIEW COORDINATOR
model PanelSession {
  id                    String              @id @default(uuid())
  organizerId           String
  organizer             User                @relation("PanelOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)

  // Session Details
  name                  String
  description           String?
  duration              Int                 // Duration in minutes

  // Associated Records
  jobId                 String?
  applicationId         String?

  // Panelists
  panelists             PanelMember[]

  // Status
  status                String              @default("SCHEDULING") // SCHEDULING, SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED

  // Scheduling Settings
  minPanelistsRequired  Int                 @default(2)
  requireAllPanelists   Boolean             @default(false)
  schedulingDeadline    DateTime?

  // Preferred Times
  preferredDates        Json?               // Array of preferred dates
  preferredTimeRanges   Json?               // Preferred time ranges
  excludedDates         Json?               // Dates to exclude

  // Scheduling Result
  scheduledStartTime    DateTime?
  scheduledEndTime      DateTime?
  meetingLink           String?
  location              String?

  // Candidate Info
  candidateId           String?
  candidateName         String?
  candidateEmail        String?

  // Notifications
  invitesSentAt         DateTime?
  remindersSentAt       Json?

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([organizerId])
  @@index([status])
  @@map("panel_sessions")
}

model PanelMember {
  id                    String              @id @default(uuid())
  sessionId             String
  session               PanelSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Role
  role                  String              @default("PANELIST") // LEAD, PANELIST, OBSERVER, NOTETAKER
  isRequired            Boolean             @default(true)
  isOptional            Boolean             @default(false)

  // Response
  responseStatus        String              @default("PENDING") // PENDING, ACCEPTED, DECLINED, TENTATIVE
  respondedAt           DateTime?
  declineReason         String?

  // Availability Submitted
  availabilitySubmitted Boolean             @default(false)
  availableSlots        Json?               // Array of available time slots
  preferredSlots        Json?               // Array of preferred time slots
  unavailableDates      Json?               // Dates they're unavailable

  // Metadata
  invitedAt             DateTime            @default(now())
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
  @@map("panel_members")
}

// 3.2.4 - TIMEZONE INTELLIGENCE
model TimezonePreference {
  id                    String              @id @default(uuid())
  userId                String              @unique
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Primary Timezone
  primaryTimezone       String              @default("UTC")
  autoDetect            Boolean             @default(true)
  lastDetectedTimezone  String?
  lastDetectedAt        DateTime?

  // Display Preferences
  use24HourFormat       Boolean             @default(false)
  showSecondaryTimezone Boolean             @default(false)
  secondaryTimezone     String?

  // Meeting Preferences
  preferLocalTime       Boolean             @default(true) // Show times in local TZ
  includeTimezoneInInvites Boolean          @default(true)

  // Travel/Remote Settings
  workLocation          String?             // City for TZ detection
  travelSchedule        Json?               // Known travel affecting TZ

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@map("timezone_preferences")
}

// ============================================
// BATCH 16: REMINDERS & NOTIFICATIONS (3.3.x)
// ============================================

// 3.3.1 - EMAIL REMINDERS & 3.3.6 - REMINDER CUSTOMIZATION
model ReminderSchedule {
  id                    String              @id @default(uuid())
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Schedule Configuration
  name                  String              // e.g., "Standard Interview Reminder"
  description           String?
  isDefault             Boolean             @default(false)
  isActive              Boolean             @default(true)

  // Reminder Timing (array of minutes before event)
  reminderTimes         Json                // e.g., [1440, 60, 15] for 24h, 1h, 15min

  // Event Types this schedule applies to
  eventTypes            String[]            @default([]) // INTERVIEW, SCREENING, PANEL, etc.

  // Channel Configuration
  emailEnabled          Boolean             @default(true)
  smsEnabled            Boolean             @default(false)
  whatsappEnabled       Boolean             @default(false)
  pushEnabled           Boolean             @default(true)

  // Templates
  emailTemplateId       String?
  smsTemplateId         String?
  whatsappTemplateId    String?

  // Scope
  scope                 String              @default("USER") // USER, TEAM, ORGANIZATION

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([userId])
  @@index([isDefault])
  @@index([isActive])
  @@map("reminder_schedules")
}

// 3.3.2-3.3.4 - NOTIFICATION CHANNELS (SMS, WhatsApp, Push)
model NotificationChannel {
  id                    String              @id @default(uuid())
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Channel Type
  channelType           String              // EMAIL, SMS, WHATSAPP, PUSH
  isEnabled             Boolean             @default(true)
  isPrimary             Boolean             @default(false)

  // Channel-Specific Configuration
  // Email
  emailAddress          String?
  emailVerified         Boolean             @default(false)
  emailVerifiedAt       DateTime?

  // SMS
  phoneNumber           String?
  phoneCountryCode      String?
  phoneVerified         Boolean             @default(false)
  phoneVerifiedAt       DateTime?
  smsCarrier            String?

  // WhatsApp
  whatsappNumber        String?
  whatsappVerified      Boolean             @default(false)
  whatsappOptIn         Boolean             @default(false)
  whatsappOptInAt       DateTime?

  // Push
  pushToken             String?
  pushPlatform          String?             // IOS, ANDROID, WEB
  pushEnabled           Boolean             @default(true)

  // Delivery Preferences
  quietHoursEnabled     Boolean             @default(false)
  quietHoursStart       String?             // e.g., "22:00"
  quietHoursEnd         String?             // e.g., "08:00"
  timezone              String?

  // Rate Limiting
  maxPerHour            Int?
  maxPerDay             Int?

  // Metadata
  lastUsedAt            DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([userId, channelType])
  @@index([userId])
  @@index([channelType])
  @@map("notification_channels")
}

// Reminder Notification Instance
model ReminderNotification {
  id                    String              @id @default(uuid())
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Associated Interview
  interviewId           String?
  interview             Interview?          @relation(fields: [interviewId], references: [id], onDelete: SetNull)

  // Reminder Details
  reminderType          String              // PRE_INTERVIEW, DAY_OF, FOLLOW_UP
  scheduledFor          DateTime            // When reminder should be sent
  minutesBefore         Int                 // Minutes before event

  // Delivery Status
  status                String              @default("PENDING") // PENDING, SENT, DELIVERED, FAILED, CANCELLED
  sentAt                DateTime?
  deliveredAt           DateTime?
  failedAt              DateTime?
  failureReason         String?
  retryCount            Int                 @default(0)
  maxRetries            Int                 @default(3)

  // Channel Used
  channel               String              // EMAIL, SMS, WHATSAPP, PUSH
  recipientAddress      String?             // Email, phone, or push token

  // Content
  subject               String?
  body                  String?
  templateId            String?
  templateData          Json?               // Variables for template

  // External IDs (from providers)
  externalMessageId     String?             // Provider's message ID
  providerResponse      Json?               // Full provider response

  // Tracking
  openedAt              DateTime?
  clickedAt             DateTime?
  interactionData       Json?

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([userId])
  @@index([interviewId])
  @@index([status])
  @@index([scheduledFor])
  @@map("reminder_notifications")
}

// 3.3.4 - PUSH NOTIFICATIONS
model PushSubscription {
  id                    String              @id @default(uuid())
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Subscription Details
  endpoint              String              @unique
  p256dh                String              // Public key
  auth                  String              // Auth secret

  // Platform Info
  platform              String              @default("WEB") // WEB, IOS, ANDROID
  browser               String?             // Chrome, Firefox, Safari
  browserVersion        String?
  deviceName            String?
  deviceModel           String?

  // Status
  isActive              Boolean             @default(true)
  lastPingAt            DateTime?
  failedAttempts        Int                 @default(0)

  // Notification Preferences
  interviewReminders    Boolean             @default(true)
  applicationUpdates    Boolean             @default(true)
  messageNotifications  Boolean             @default(true)
  systemAlerts          Boolean             @default(true)

  // Metadata
  subscribedAt          DateTime            @default(now())
  expiresAt             DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([userId])
  @@index([isActive])
  @@map("push_subscriptions")
}

// 3.3.5 - CALENDAR EVENT UPDATES
// (Uses existing CalendarEvent model with sync tracking)

// 3.3.7 - CONFIRMATION REQUESTS
model ConfirmationRequest {
  id                    String              @id @default(uuid())

  // Recipient
  recipientId           String
  recipient             User                @relation("ConfirmationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  // Sender
  senderId              String
  sender                User                @relation("ConfirmationSender", fields: [senderId], references: [id], onDelete: Cascade)

  // Associated Interview
  interviewId           String
  interview             Interview           @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  // Request Details
  requestType           String              @default("ATTENDANCE") // ATTENDANCE, RESCHEDULE, CANCELLATION
  message               String?             // Custom message from sender

  // Confirmation Token
  token                 String              @unique @default(uuid())
  expiresAt             DateTime

  // Status
  status                String              @default("PENDING") // PENDING, CONFIRMED, DECLINED, EXPIRED
  respondedAt           DateTime?
  responseMessage       String?             // Optional message from recipient

  // Decline Options
  declineReason         String?             // SCHEDULING_CONFLICT, NOT_INTERESTED, OTHER
  suggestReschedule     Boolean             @default(false)
  suggestedTimes        Json?               // Array of suggested alternative times

  // Notification Tracking
  notificationsSent     Int                 @default(0)
  lastNotificationAt    DateTime?
  channelsUsed          String[]            @default([]) // EMAIL, SMS, etc.

  // Reminders
  reminderSchedule      Json?               // When to send reminder if no response
  nextReminderAt        DateTime?

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([recipientId])
  @@index([senderId])
  @@index([interviewId])
  @@index([status])
  @@index([token])
  @@map("confirmation_requests")
}

// 3.3.8 - PREP MATERIAL DELIVERY
model PrepMaterial {
  id                    String              @id @default(uuid())
  createdById           String
  createdBy             User                @relation(fields: [createdById], references: [id], onDelete: Cascade)

  // Material Info
  title                 String
  description           String?
  materialType          String              // DOCUMENT, VIDEO, LINK, CHECKLIST, GUIDE

  // Content
  content               String?             // Rich text content
  fileUrl               String?             // Uploaded file URL
  externalUrl           String?             // External link

  // File Details
  fileName              String?
  fileSize              Int?
  mimeType              String?

  // Categorization
  category              String?             // COMPANY_INFO, ROLE_INFO, INTERVIEW_TIPS, TECHNICAL_PREP
  tags                  String[]            @default([])

  // Target Audience
  forInterviewTypes     String[]            @default([]) // TECHNICAL, BEHAVIORAL, etc.
  forJobIds             String[]            @default([]) // Specific jobs
  forDepartments        String[]            @default([])

  // Visibility
  isPublic              Boolean             @default(false)
  isActive              Boolean             @default(true)

  // Delivery Settings
  sendAutomatically     Boolean             @default(true)
  hoursBefore           Int                 @default(24) // Hours before interview to send

  // Usage Stats
  viewCount             Int                 @default(0)
  downloadCount         Int                 @default(0)

  // Relations
  deliveries            PrepMaterialDelivery[]

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([createdById])
  @@index([materialType])
  @@index([isActive])
  @@map("prep_materials")
}

model PrepMaterialDelivery {
  id                    String              @id @default(uuid())

  // Material
  materialId            String
  material              PrepMaterial        @relation(fields: [materialId], references: [id], onDelete: Cascade)

  // Recipient
  recipientId           String
  recipient             User                @relation("PrepDeliveryRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  // Interview
  interviewId           String?
  interview             Interview?          @relation(fields: [interviewId], references: [id], onDelete: SetNull)

  // Delivery Details
  deliveryMethod        String              @default("EMAIL") // EMAIL, SMS, WHATSAPP, IN_APP
  scheduledFor          DateTime

  // Status
  status                String              @default("PENDING") // PENDING, SENT, DELIVERED, VIEWED, FAILED
  sentAt                DateTime?
  deliveredAt           DateTime?
  viewedAt              DateTime?
  failedAt              DateTime?
  failureReason         String?

  // Tracking
  openCount             Int                 @default(0)
  downloadCount         Int                 @default(0)
  timeSpentSeconds      Int?                // Estimated reading/viewing time

  // Feedback
  helpfulRating         Int?                // 1-5 rating
  feedbackText          String?

  // External Tracking
  externalMessageId     String?
  trackingPixelId       String?

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([materialId, recipientId, interviewId])
  @@index([materialId])
  @@index([recipientId])
  @@index([interviewId])
  @@index([status])
  @@map("prep_material_deliveries")
}

// User Notification Preferences (aggregated settings)
model NotificationPreference {
  id                    String              @id @default(uuid())
  userId                String              @unique
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Global Settings
  notificationsEnabled  Boolean             @default(true)
  digestMode            String              @default("INSTANT") // INSTANT, HOURLY, DAILY, WEEKLY
  digestTime            String?             // Preferred time for digest (e.g., "09:00")
  digestDay             String?             // For weekly digest (e.g., "MONDAY")

  // Channel Preferences
  emailEnabled          Boolean             @default(true)
  smsEnabled            Boolean             @default(false)
  whatsappEnabled       Boolean             @default(false)
  pushEnabled           Boolean             @default(true)
  inAppEnabled          Boolean             @default(true)

  // Notification Type Preferences
  interviewReminders    Boolean             @default(true)
  applicationUpdates    Boolean             @default(true)
  messageAlerts         Boolean             @default(true)
  jobAlerts             Boolean             @default(true)
  systemAnnouncements   Boolean             @default(true)
  marketingEmails       Boolean             @default(false)

  // Reminder Preferences
  defaultReminderTimes  Json?               // e.g., [1440, 60, 15] minutes before
  confirmationRequests  Boolean             @default(true)
  prepMaterialDelivery  Boolean             @default(true)

  // Quiet Hours
  quietHoursEnabled     Boolean             @default(false)
  quietHoursStart       String?             // e.g., "22:00"
  quietHoursEnd         String?             // e.g., "08:00"
  quietHoursTimezone    String?

  // Unsubscribe Tracking
  unsubscribedAt        DateTime?
  unsubscribeReason     String?

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@map("notification_preferences")
}

// ============================================
// BATCH 17: AI SCREENING INTERVIEWS (4.1.x)
// ============================================

// 4.1.1-4.1.3 - AI SCREENING INTERVIEW (Video, Phone, Chat)
model AIScreeningInterview {
  id                    String              @id @default(uuid())

  // Participants
  candidateId           String
  candidate             User                @relation("ScreeningCandidate", fields: [candidateId], references: [id], onDelete: Cascade)
  recruiterId           String?
  recruiter             User?               @relation("ScreeningRecruiter", fields: [recruiterId], references: [id], onDelete: SetNull)

  // Context
  jobId                 String?
  job                   Job?                @relation(fields: [jobId], references: [id], onDelete: SetNull)
  applicationId         String?
  application           Application?        @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  // Interview Type
  interviewType         String              // VIDEO_ASYNC, PHONE, CHAT
  title                 String
  description           String?

  // Question Flow
  questionFlowId        String?
  questionFlow          QuestionFlow?       @relation(fields: [questionFlowId], references: [id], onDelete: SetNull)

  // Status & Progress
  status                String              @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, EXPIRED, CANCELLED
  currentQuestionIndex  Int                 @default(0)
  totalQuestions        Int                 @default(0)
  completedQuestions    Int                 @default(0)

  // Scheduling
  invitedAt             DateTime            @default(now())
  startedAt             DateTime?
  completedAt           DateTime?
  expiresAt             DateTime?
  deadlineExtensions    Int                 @default(0)

  // Time Limits
  totalTimeLimit        Int?                // Total time in minutes
  timeRemaining         Int?                // Remaining time in seconds
  perQuestionTimeLimit  Int?                // Time per question in seconds

  // Language & Accessibility (4.1.6, 4.1.7)
  language              String              @default("en")
  accessibilitySettings Json?               // { extraTime, captions, screenReader, etc. }

  // AI Configuration (4.1.8)
  aiTone                String              @default("PROFESSIONAL") // PROFESSIONAL, FRIENDLY, CASUAL
  aiPersonality         String?
  enableSmallTalk       Boolean             @default(true)

  // Scoring
  overallScore          Float?
  aiScoreSummary        Json?               // { categories: [...], recommendations: [...] }

  // Recording & Media
  recordingConsent      Boolean             @default(false)
  recordingUrl          String?
  transcriptUrl         String?

  // Invitation Token
  inviteToken           String              @unique @default(uuid())
  tokenExpiresAt        DateTime?

  // Relations
  responses             ScreeningResponse[]

  // Batch 18: AI Interview Analysis Relations
  transcriptions        InterviewTranscription[]
  answerAnalyses        AnswerAnalysis[]
  topicDetections       TopicDetection[]
  sentimentAnalyses     SentimentAnalysis[]
  communicationScores   CommunicationScore[]
  technicalVerifications TechnicalVerification[]
  redFlagAlerts         RedFlagAlert[]
  summaries             InterviewSummary[]
  highlights            InterviewHighlight[]

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([candidateId])
  @@index([jobId])
  @@index([status])
  @@index([inviteToken])
  @@map("ai_screening_interviews")
}

// 4.1.4 - STRUCTURED QUESTION FLOW
model QuestionFlow {
  id                    String              @id @default(uuid())
  createdById           String
  createdBy             User                @relation(fields: [createdById], references: [id], onDelete: Cascade)

  // Flow Configuration
  name                  String
  description           String?
  category              String?             // TECHNICAL, BEHAVIORAL, SCREENING, etc.

  // Target Role/Level
  jobId                 String?
  job                   Job?                @relation(fields: [jobId], references: [id], onDelete: SetNull)
  targetRole            String?
  targetLevel           String?             // ENTRY, MID, SENIOR, LEAD, EXECUTIVE

  // Interview Type
  interviewType         String              @default("VIDEO_ASYNC") // VIDEO_ASYNC, PHONE, CHAT

  // Language & Accessibility
  supportedLanguages    String[]            @default(["en"])
  defaultLanguage       String              @default("en")

  // Timing
  estimatedDuration     Int?                // In minutes
  defaultTimePerQuestion Int?               // Default seconds per question

  // Status
  isActive              Boolean             @default(true)
  isTemplate            Boolean             @default(false)
  version               Int                 @default(1)

  // Usage Stats
  usageCount            Int                 @default(0)
  avgCompletionRate     Float?
  avgScore              Float?

  // Relations
  questions             ScreeningQuestion[]
  followUpRules         FollowUpRule[]
  screeningInterviews   AIScreeningInterview[]

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([createdById])
  @@index([isActive])
  @@index([category])
  @@map("question_flows")
}

// Individual Questions in a Flow
model ScreeningQuestion {
  id                    String              @id @default(uuid())
  flowId                String
  flow                  QuestionFlow        @relation(fields: [flowId], references: [id], onDelete: Cascade)

  // Question Content
  questionText          String
  questionType          String              // TEXT, VIDEO, AUDIO, MULTIPLE_CHOICE, CODING
  category              String?             // TECHNICAL, BEHAVIORAL, SITUATIONAL, etc.

  // Multi-language Support (4.1.6)
  translations          Json?               // { "es": "...", "fr": "...", etc. }

  // Response Configuration
  expectedResponseType  String              @default("VIDEO") // VIDEO, AUDIO, TEXT, CODE
  maxResponseDuration   Int?                // Seconds for video/audio
  maxResponseLength     Int?                // Characters for text
  allowRetakes          Boolean             @default(true)
  maxRetakes            Int                 @default(2)

  // Multiple Choice Options
  options               Json?               // Array of { value, label, isCorrect }
  correctAnswer         String?

  // Ordering
  orderIndex            Int                 @default(0)
  isRequired            Boolean             @default(true)

  // Difficulty & Scoring
  difficulty            String              @default("MEDIUM") // EASY, MEDIUM, HARD
  maxPoints             Int                 @default(10)
  scoringCriteria       Json?               // AI scoring criteria

  // Hints & Help
  hint                  String?
  sampleAnswer          String?
  evaluationGuidelines  String?

  // Time Limit
  timeLimit             Int?                // Seconds

  // Accessibility (4.1.7)
  accessibilityNotes    String?
  hasAudioDescription   Boolean             @default(false)
  hasSignLanguage       Boolean             @default(false)

  // AI Configuration
  aiFollowUpEnabled     Boolean             @default(true)
  aiEvaluationPrompt    String?

  // Relations
  responses             ScreeningResponse[]
  followUpRules         FollowUpRule[]      @relation("TriggerQuestion")
  asFollowUp            FollowUpRule[]      @relation("FollowUpQuestion")

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([flowId])
  @@index([orderIndex])
  @@map("screening_questions")
}

// Candidate Responses to Questions
model ScreeningResponse {
  id                    String              @id @default(uuid())
  interviewId           String
  interview             AIScreeningInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  questionId            String
  question              ScreeningQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Response Content
  responseType          String              // VIDEO, AUDIO, TEXT, CODE, CHOICE
  textResponse          String?
  videoUrl              String?
  audioUrl              String?
  codeResponse          String?
  codeLanguage          String?
  selectedOptions       String[]            @default([])

  // Timing
  startedAt             DateTime?
  completedAt           DateTime?
  timeSpentSeconds      Int?
  retakeNumber          Int                 @default(0)

  // Transcription (4.2.1 preview)
  transcription         String?
  transcriptionStatus   String?             // PENDING, PROCESSING, COMPLETED, FAILED

  // AI Analysis
  aiScore               Float?
  aiScoreBreakdown      Json?               // { clarity: 8, relevance: 7, ... }
  aiSummary             String?
  aiKeyPoints           String[]            @default([])
  aiFeedback            String?
  aiSentiment           String?             // POSITIVE, NEUTRAL, NEGATIVE
  aiConfidenceLevel     Float?

  // Keyword & Topic Detection (4.2.3 preview)
  detectedKeywords      String[]            @default([])
  detectedTopics        String[]            @default([])

  // Red Flags (4.2.7 preview)
  redFlags              Json?               // Array of { type, description, severity }
  greenFlags            Json?               // Array of positive indicators

  // Manual Review
  manualScore           Float?
  manualFeedback        String?
  reviewedById          String?
  reviewedAt            DateTime?

  // Status
  status                String              @default("PENDING") // PENDING, SUBMITTED, ANALYZING, REVIEWED

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([interviewId, questionId, retakeNumber])
  @@index([interviewId])
  @@index([questionId])
  @@index([userId])
  @@map("screening_responses")
}

// 4.1.5 - DYNAMIC FOLLOW-UP RULES
model FollowUpRule {
  id                    String              @id @default(uuid())
  flowId                String
  flow                  QuestionFlow        @relation(fields: [flowId], references: [id], onDelete: Cascade)

  // Trigger Question
  triggerQuestionId     String
  triggerQuestion       ScreeningQuestion   @relation("TriggerQuestion", fields: [triggerQuestionId], references: [id], onDelete: Cascade)

  // Condition
  conditionType         String              // KEYWORD_MATCH, SCORE_THRESHOLD, SENTIMENT, TOPIC_DETECTED, ANSWER_CHOICE
  conditionValue        Json                // { keywords: [...], threshold: 5, sentiment: "NEGATIVE", etc. }
  conditionOperator     String              @default("EQUALS") // EQUALS, CONTAINS, GREATER_THAN, LESS_THAN

  // Follow-up Action
  actionType            String              // ASK_FOLLOW_UP, SKIP_QUESTION, ADD_QUESTIONS, END_INTERVIEW
  followUpQuestionId    String?
  followUpQuestion      ScreeningQuestion?  @relation("FollowUpQuestion", fields: [followUpQuestionId], references: [id], onDelete: SetNull)
  customFollowUpText    String?             // Dynamic AI-generated follow-up
  additionalQuestionIds String[]            @default([])

  // AI Generation
  useAIGeneration       Boolean             @default(false)
  aiGenerationPrompt    String?

  // Priority & Ordering
  priority              Int                 @default(0)
  isActive              Boolean             @default(true)

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([flowId])
  @@index([triggerQuestionId])
  @@map("follow_up_rules")
}

// AI Screening Template (Reusable configurations)
model ScreeningTemplate {
  id                    String              @id @default(uuid())

  // Template Info
  name                  String
  description           String?
  category              String?             // TECH, SALES, CUSTOMER_SERVICE, etc.

  // Interview Type
  interviewType         String              @default("VIDEO_ASYNC")

  // Configuration
  defaultQuestions      Json?               // Array of default question templates
  defaultDuration       Int?                // Minutes
  defaultTimePerQuestion Int?               // Seconds

  // AI Settings (4.1.8)
  aiTone                String              @default("PROFESSIONAL")
  aiPersonality         Json?               // { name, traits, greeting, closing }
  smallTalkEnabled      Boolean             @default(true)
  smallTalkPrompts      String[]            @default([])

  // Language (4.1.6)
  supportedLanguages    String[]            @default(["en"])
  defaultLanguage       String              @default("en")

  // Accessibility Defaults (4.1.7)
  defaultAccessibility  Json?               // { extraTimePercent, captionsEnabled, etc. }

  // Branding
  logoUrl               String?
  primaryColor          String?
  welcomeMessage        String?
  completionMessage     String?

  // Status
  isActive              Boolean             @default(true)
  isPublic              Boolean             @default(false)

  // Usage
  usageCount            Int                 @default(0)

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([category])
  @@index([isActive])
  @@map("screening_templates")
}

// Candidate Accessibility Preferences
model CandidateAccessibilityPrefs {
  id                    String              @id @default(uuid())
  candidateId           String              @unique

  // Visual
  highContrastMode      Boolean             @default(false)
  largeText             Boolean             @default(false)
  fontSize              Int                 @default(16)

  // Audio/Video
  captionsEnabled       Boolean             @default(false)
  captionsLanguage      String              @default("en")
  audioDescriptions     Boolean             @default(false)
  signLanguageSupport   Boolean             @default(false)
  signLanguageType      String?             // ASL, BSL, etc.

  // Time Extensions
  extraTimePercent      Int                 @default(0) // 0, 25, 50, 100
  pauseAllowed          Boolean             @default(false)
  maxPauseMinutes       Int                 @default(5)

  // Input Methods
  voiceInputEnabled     Boolean             @default(false)
  keyboardOnlyMode      Boolean             @default(false)

  // Screen Reader
  screenReaderOptimized Boolean             @default(false)
  screenReaderType      String?             // JAWS, NVDA, VoiceOver, etc.

  // Cognitive Support
  simplifiedInstructions Boolean            @default(false)
  progressIndicator     Boolean             @default(true)
  breakReminders        Boolean             @default(false)
  breakInterval         Int?                // Minutes between break reminders

  // Communication
  preferredCommunication String             @default("TEXT") // TEXT, AUDIO, VIDEO

  // Documentation
  accommodationDocs     String?             // URL to accommodation documentation
  verifiedAt            DateTime?

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@map("candidate_accessibility_prefs")
}

// ============================================
// BATCH 18: AI INTERVIEW ANALYSIS (4.2.x)
// ============================================

// 4.2.1 - SPEECH-TO-TEXT TRANSCRIPTION
model InterviewTranscription {
  id                    String              @id @default(uuid())
  interviewId           String
  interview             AIScreeningInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  responseId            String?             // Optional link to specific response

  // Source
  sourceType            String              // VIDEO, AUDIO, PHONE
  sourceUrl             String?             // URL to source media
  duration              Int?                // Duration in seconds

  // Transcription
  rawTranscript         String              @db.Text
  formattedTranscript   String?             @db.Text // With timestamps, speaker labels
  language              String              @default("en")
  detectedLanguage      String?

  // Processing
  transcriptionEngine   String              @default("WHISPER") // WHISPER, GOOGLE, AWS, AZURE
  confidence            Float?              // Overall confidence score
  wordCount             Int                 @default(0)

  // Timestamps
  timestamps            Json?               // Array of { word, start, end, confidence }
  speakerLabels         Json?               // Speaker diarization { speaker, segments }

  // Quality
  audioQuality          String?             // EXCELLENT, GOOD, FAIR, POOR
  noiseLevel            Float?              // 0-1 background noise detection
  clarityScore          Float?              // 0-1 speech clarity

  // Status
  status                String              @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  errorMessage          String?
  processingTime        Int?                // Milliseconds

  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  answerAnalyses        AnswerAnalysis[]
  topicDetections       TopicDetection[]
  sentimentAnalyses     SentimentAnalysis[]

  @@index([interviewId])
  @@index([status])
  @@map("interview_transcriptions")
}

// 4.2.2 - ANSWER QUALITY SCORING
model AnswerAnalysis {
  id                    String              @id @default(uuid())
  interviewId           String
  interview             AIScreeningInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  transcriptionId       String?
  transcription         InterviewTranscription? @relation(fields: [transcriptionId], references: [id], onDelete: SetNull)
  responseId            String?             // Link to ScreeningResponse
  questionId            String?

  // Question Context
  questionText          String?             @db.Text
  questionType          String?             // BEHAVIORAL, TECHNICAL, SITUATIONAL, etc.
  expectedKeywords      String[]            @default([])

  // Answer Content
  answerText            String              @db.Text
  answerLength          Int                 @default(0) // Word count

  // Quality Scores (0-100)
  overallScore          Float               @default(0)
  relevanceScore        Float               @default(0)  // How relevant to the question
  completenessScore     Float               @default(0)  // How complete the answer is
  depthScore            Float               @default(0)  // Depth of explanation
  clarityScore          Float               @default(0)  // Clarity of expression
  structureScore        Float               @default(0)  // Answer organization (STAR method, etc.)
  specificityScore      Float               @default(0)  // Use of specific examples

  // AI Insights
  strengths             String[]            @default([])
  weaknesses            String[]            @default([])
  keyPoints             String[]            @default([])
  missingElements       String[]            @default([])
  suggestions           String[]            @default([])

  // Scoring Details
  scoringCriteria       Json?               // Detailed breakdown
  aiReasoning           String?             @db.Text // Why the AI scored this way
  confidenceLevel       Float               @default(0)

  // Metadata
  analyzedAt            DateTime            @default(now())
  modelVersion          String?

  @@index([interviewId])
  @@index([overallScore])
  @@map("answer_analyses")
}

// 4.2.3 - KEYWORD & TOPIC DETECTION
model TopicDetection {
  id                    String              @id @default(uuid())
  interviewId           String
  interview             AIScreeningInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  transcriptionId       String?
  transcription         InterviewTranscription? @relation(fields: [transcriptionId], references: [id], onDelete: SetNull)

  // Topics Detected
  topics                Json                // Array of { topic, relevance, frequency, context }
  primaryTopics         String[]            @default([]) // Main topics discussed
  secondaryTopics       String[]            @default([]) // Supporting topics

  // Keywords
  keywords              Json                // Array of { keyword, count, importance, contextSamples }
  technicalKeywords     String[]            @default([])
  softSkillKeywords     String[]            @default([])
  industryKeywords      String[]            @default([])

  // Named Entities
  namedEntities         Json?               // { companies: [], technologies: [], people: [], locations: [] }

  // Topic Categories
  technicalTopics       Json?               // Technical areas covered
  behavioralTopics      Json?               // Soft skills and behaviors discussed
  experienceTopics      Json?               // Past experience topics

  // Coverage Analysis
  expectedTopics        String[]            @default([]) // Topics expected based on role
  coveredExpected       String[]            @default([]) // Expected topics that were covered
  missedTopics          String[]            @default([]) // Expected topics not mentioned
  unexpectedTopics      String[]            @default([]) // Interesting topics not expected

  // Scores
  topicCoverageScore    Float               @default(0) // 0-100
  topicDepthScore       Float               @default(0) // 0-100
  relevanceScore        Float               @default(0) // 0-100

  // Metadata
  analyzedAt            DateTime            @default(now())

  @@index([interviewId])
  @@map("topic_detections")
}

// 4.2.4 - SENTIMENT & CONFIDENCE ANALYSIS
model SentimentAnalysis {
  id                    String              @id @default(uuid())
  interviewId           String
  interview             AIScreeningInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  transcriptionId       String?
  transcription         InterviewTranscription? @relation(fields: [transcriptionId], references: [id], onDelete: SetNull)
  responseId            String?

  // Overall Sentiment
  overallSentiment      String              @default("NEUTRAL") // VERY_POSITIVE, POSITIVE, NEUTRAL, NEGATIVE, VERY_NEGATIVE
  sentimentScore        Float               @default(0) // -1 to 1
  sentimentConfidence   Float               @default(0) // 0-1

  // Emotion Detection
  emotions              Json?               // { joy, enthusiasm, confidence, nervousness, frustration, etc. }
  dominantEmotion       String?
  emotionalVariation    Float               @default(0) // How much emotions change

  // Confidence Indicators
  confidenceLevel       String              @default("MODERATE") // HIGH, MODERATE, LOW, UNCERTAIN
  confidenceScore       Float               @default(0) // 0-100
  hesitationMarkers     Int                 @default(0) // Count of "um", "uh", pauses
  fillerWords           Json?               // { word: count }

  // Enthusiasm
  enthusiasmScore       Float               @default(0) // 0-100
  passionIndicators     String[]            @default([])

  // Authenticity
  authenticityScore     Float               @default(0) // 0-100
  consistencyScore      Float               @default(0) // How consistent sentiment is

  // Timeline Analysis
  sentimentTimeline     Json?               // Array of { timestamp, sentiment, confidence }
  sentimentTrend        String?             // IMPROVING, STABLE, DECLINING

  // Per-Question Analysis
  questionSentiments    Json?               // Array of { questionId, sentiment, confidence, emotion }

  // Voice Analysis (if audio available)
  voiceEnergy           Float?              // 0-100
  speechPace            String?             // SLOW, NORMAL, FAST
  toneVariation         Float?              // 0-100

  // Metadata
  analyzedAt            DateTime            @default(now())

  @@index([interviewId])
  @@index([overallSentiment])
  @@map("sentiment_analyses")
}

// 4.2.5 - COMMUNICATION SKILLS SCORE
model CommunicationScore {
  id                    String              @id @default(uuid())
  interviewId           String
  interview             AIScreeningInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  // Overall Score
  overallScore          Float               @default(0) // 0-100

  // Verbal Communication (Text/Speech)
  clarityScore          Float               @default(0)  // Clear expression
  articulationScore     Float               @default(0)  // Well-articulated points
  vocabularyScore       Float               @default(0)  // Appropriate vocabulary usage
  grammarScore          Float               @default(0)  // Grammar correctness
  coherenceScore        Float               @default(0)  // Logical flow

  // Structure
  structureScore        Float               @default(0)  // Answer organization
  conciseness           Float               @default(0)  // Being concise vs verbose
  relevance             Float               @default(0)  // Staying on topic

  // Interpersonal
  professionalismScore  Float               @default(0)  // Professional tone
  engagementScore       Float               @default(0)  // Engagement level
  listeningIndicators   Float               @default(0)  // Response to follow-ups

  // Technical Communication (if applicable)
  technicalClarity      Float?              // Explaining technical concepts
  useOfExamples         Float               @default(0)  // Supporting with examples

  // Areas Assessment
  strengths             String[]            @default([])
  areasForImprovement   String[]            @default([])

  // Detailed Feedback
  feedback              Json?               // Structured feedback per area
  recommendations       String[]            @default([])

  // Benchmark Comparison
  percentile            Float?              // Compared to other candidates
  benchmarkRole         String?             // Role used for benchmarking

  // Metadata
  analyzedAt            DateTime            @default(now())

  @@unique([interviewId])
  @@map("communication_scores")
}

// 4.2.6 - TECHNICAL ACCURACY CHECKER
model TechnicalVerification {
  id                    String              @id @default(uuid())
  interviewId           String
  interview             AIScreeningInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  responseId            String?

  // Claim
  claimText             String              @db.Text
  claimType             String              // TECHNICAL_FACT, EXPERIENCE, METRIC, CREDENTIAL
  claimContext          String?             @db.Text

  // Verification
  verificationStatus    String              @default("PENDING") // VERIFIED, PARTIALLY_VERIFIED, UNVERIFIABLE, INACCURATE, PENDING
  accuracyScore         Float               @default(0) // 0-100
  confidenceLevel       Float               @default(0) // 0-1

  // Evidence
  supportingEvidence    Json?               // Sources that support the claim
  contradictingEvidence Json?               // Sources that contradict
  relatedInformation    Json?               // Additional context

  // Technical Assessment
  technicalDepth        String?             // SURFACE, INTERMEDIATE, DEEP, EXPERT
  isCurrent             Boolean             @default(true) // Is the information current?
  relevanceToRole       Float               @default(0) // 0-100

  // Issues Found
  potentialIssues       String[]            @default([])
  exaggerationRisk      Float               @default(0) // 0-100
  inconsistencies       Json?               // Any inconsistencies found

  // Recommendations
  followUpQuestions     String[]            @default([]) // Suggested follow-up questions
  verificationNotes     String?             @db.Text

  // Knowledge Base Reference
  knowledgeBaseMatches  Json?               // Matches from company knowledge base

  // Metadata
  verifiedAt            DateTime            @default(now())
  verifiedBy            String?             // AI model or manual reviewer

  @@index([interviewId])
  @@index([verificationStatus])
  @@map("technical_verifications")
}

// 4.2.7 - RED FLAG DETECTION
model RedFlagAlert {
  id                    String              @id @default(uuid())
  interviewId           String
  interview             AIScreeningInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  responseId            String?

  // Flag Details
  flagType              String              // INCONSISTENCY, EVASION, NEGATIVE_ATTITUDE, CONCERNING_RESPONSE, SKILL_GAP, CULTURAL_MISMATCH
  severity              String              @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  title                 String
  description           String              @db.Text

  // Context
  triggerText           String?             @db.Text // What triggered the flag
  questionContext       String?             // Which question/topic
  timestamp             String?             // When in the interview

  // Analysis
  confidence            Float               @default(0) // 0-1 confidence in the flag
  evidence              Json?               // Supporting evidence
  patterns              String[]            @default([]) // Related patterns detected

  // Categories
  categories            String[]            @default([]) // INTEGRITY, COMPETENCE, FIT, ATTITUDE, CONSISTENCY

  // Impact Assessment
  impactArea            String?             // What this might impact
  riskLevel             String              @default("MEDIUM") // Assessment of risk

  // Recommendations
  suggestedActions      String[]            @default([])
  followUpQuestions     String[]            @default([])
  additionalContext     String?             @db.Text

  // Review
  isReviewed            Boolean             @default(false)
  reviewedById          String?
  reviewedAt            DateTime?
  reviewNotes           String?             @db.Text
  isFalsePositive       Boolean             @default(false)
  disposition           String?             // CONFIRMED, DISMISSED, NEEDS_FOLLOW_UP

  // Metadata
  detectedAt            DateTime            @default(now())

  @@index([interviewId])
  @@index([severity])
  @@index([flagType])
  @@map("red_flag_alerts")
}

// 4.2.8 - SUMMARY GENERATION
model InterviewSummary {
  id                    String              @id @default(uuid())
  interviewId           String
  interview             AIScreeningInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  // Candidate Reference
  candidateId           String
  candidate             User                @relation("SummaryCandidate", fields: [candidateId], references: [id], onDelete: Cascade)

  // Summary Content
  executiveSummary      String              @db.Text // Brief 2-3 sentence summary
  detailedSummary       String              @db.Text // Full summary
  bulletPoints          String[]            @default([]) // Key takeaways

  // Scores Overview
  overallScore          Float               @default(0)
  scoreBreakdown        Json?               // { technical, communication, cultural, etc. }
  ranking               String?             // Strong, Average, Below Average

  // Strengths & Weaknesses
  topStrengths          String[]            @default([])
  areasOfConcern        String[]            @default([])
  uniqueQualities       String[]            @default([])

  // Skills Assessment
  technicalSkills       Json?               // { skill: level }
  softSkills            Json?               // { skill: level }
  skillGaps             String[]            @default([])

  // Cultural Fit
  culturalFitScore      Float?
  culturalFitNotes      String[]            @default([])

  // Experience Highlights
  relevantExperience    String[]            @default([])
  notableAchievements   String[]            @default([])
  experienceGaps        String[]            @default([])

  // Recommendations
  hiringRecommendation  String              @default("NEEDS_REVIEW") // STRONG_YES, YES, MAYBE, NO, STRONG_NO
  recommendationReason  String?             @db.Text
  nextSteps             String[]            @default([])
  suggestedInterviewers String[]            @default([]) // Suggested people for next round

  // Questions for Follow-up
  followUpQuestions     String[]            @default([])
  areasToProbe          String[]            @default([])

  // Comparison Notes
  comparedToCriteria    Json?               // How they match job requirements
  standoutFactors       String[]            @default([])

  // Review
  reviewedById          String?
  reviewer              User?               @relation("SummaryReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt            DateTime?
  reviewNotes           String?             @db.Text
  isApproved            Boolean             @default(false)

  // Version Control
  version               Int                 @default(1)
  previousVersionId     String?

  // Metadata
  generatedAt           DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([interviewId])
  @@index([candidateId])
  @@index([hiringRecommendation])
  @@map("interview_summaries")
}

// 4.2.9 - HIGHLIGHT EXTRACTION
model InterviewHighlight {
  id                    String              @id @default(uuid())
  interviewId           String
  interview             AIScreeningInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  responseId            String?

