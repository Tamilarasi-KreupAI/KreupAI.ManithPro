// Recommendation Feedback (for improving recommendations)
model RecommendationFeedback {
  id                    String              @id @default(uuid())
  companyId             String

  // What recommendation
  recommendationType    String              // JOB, CANDIDATE, SIMILAR, PASSIVE, SKILL_UP, REENGAGE, PANEL, SOURCING
  recommendationId      String

  // Who gave feedback
  userId                String
  userRole              String              // CANDIDATE, RECRUITER, HIRING_MANAGER

  // Feedback
  rating                Int                 // 1-5 stars
  wasHelpful            Boolean?
  wasAccurate           Boolean?
  feedbackText          String?             @db.Text

  // Outcome
  actionTaken           String?             // What they did with recommendation
  outcome               String?             // Result of the action

  // Metadata
  createdAt             DateTime            @default(now())

  @@index([companyId])
  @@index([recommendationType])
  @@index([recommendationId])
  @@map("recommendation_feedback")
}

// Recommendation Configuration
model RecommendationConfig {
  id                    String              @id @default(uuid())
  companyId             String
  recommendationType    String              // Which type of recommendation

  // Algorithm Settings
  algorithmVersion      String              @default("1.0")
  isEnabled             Boolean             @default(true)

  // Weights
  weights               Json                // Factor weights
  thresholds            Json                // Score thresholds

  // Filters
  includeFilters        Json?               // What to include
  excludeFilters        Json?               // What to exclude
  diversitySettings     Json?               // Diversity considerations

  // Frequency
  refreshFrequency      String              @default("DAILY") // REALTIME, HOURLY, DAILY, WEEKLY
  maxRecommendations    Int                 @default(20)

  // Personalization
  usePersonalization    Boolean             @default(true)
  personalizationFactors Json?

  // Metadata
  createdById           String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([companyId, recommendationType])
  @@index([companyId])
  @@map("recommendation_configs")
}

// ============================================================================
// BATCH 24: HIRING TEAM MANAGEMENT (6.1.1-6.1.7)
// ============================================================================

// 6.1.1 Hiring Team Creation
model HiringTeam {
  id                    String              @id @default(uuid())
  companyId             String
  jobId                 String

  // Team Details
  name                  String
  description           String?             @db.Text
  teamType              String              @default("STANDARD") // STANDARD, EXECUTIVE, HIGH_VOLUME

  // Team Lead
  leadRecruiterId       String
  hiringManagerId       String?

  // Status
  status                String              @default("ACTIVE") // ACTIVE, PAUSED, COMPLETED, ARCHIVED
