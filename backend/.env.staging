# KreupAI ManithPro - Staging Environment Configuration
# NOTE: This file is a template. Actual secrets should be stored in CI/CD secrets.

# =============================================================================
# Database
# =============================================================================
DATABASE_URL="${STAGING_DATABASE_URL}"

# =============================================================================
# Authentication
# =============================================================================
JWT_SECRET="${STAGING_JWT_SECRET}"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="${STAGING_JWT_REFRESH_SECRET}"
JWT_REFRESH_EXPIRES_IN="30d"

# =============================================================================
# Server
# =============================================================================
PORT=3000
NODE_ENV="staging"
LOG_LEVEL="info"

# =============================================================================
# URLs
# =============================================================================
FRONTEND_URL="${STAGING_FRONTEND_URL}"
API_URL="${STAGING_API_URL}"
CORS_ORIGINS="${STAGING_CORS_ORIGINS}"

# =============================================================================
# Redis
# =============================================================================
REDIS_URL="${STAGING_REDIS_URL}"
REDIS_PASSWORD="${STAGING_REDIS_PASSWORD}"

# =============================================================================
# Email (SendGrid/SES)
# =============================================================================
SMTP_HOST="${STAGING_SMTP_HOST}"
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER="${STAGING_SMTP_USER}"
SMTP_PASS="${STAGING_SMTP_PASS}"
EMAIL_FROM="staging@manithpro.com"

# =============================================================================
# File Upload (S3)
# =============================================================================
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES="pdf,doc,docx,txt,jpg,jpeg,png"
AWS_ACCESS_KEY_ID="${STAGING_AWS_ACCESS_KEY_ID}"
AWS_SECRET_ACCESS_KEY="${STAGING_AWS_SECRET_ACCESS_KEY}"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="manithpro-staging"

# =============================================================================
# OAuth Providers
# =============================================================================
LINKEDIN_CLIENT_ID="${STAGING_LINKEDIN_CLIENT_ID}"
LINKEDIN_CLIENT_SECRET="${STAGING_LINKEDIN_CLIENT_SECRET}"
LINKEDIN_REDIRECT_URI="${STAGING_API_URL}/api/auth/linkedin/callback"

GOOGLE_CLIENT_ID="${STAGING_GOOGLE_CLIENT_ID}"
GOOGLE_CLIENT_SECRET="${STAGING_GOOGLE_CLIENT_SECRET}"
GOOGLE_REDIRECT_URI="${STAGING_API_URL}/api/auth/google/callback"

# =============================================================================
# Payments (Stripe Test Mode)
# =============================================================================
STRIPE_SECRET_KEY="${STAGING_STRIPE_SECRET_KEY}"
STRIPE_WEBHOOK_SECRET="${STAGING_STRIPE_WEBHOOK_SECRET}"
STRIPE_PUBLISHABLE_KEY="${STAGING_STRIPE_PUBLISHABLE_KEY}"

# =============================================================================
# Monitoring
# =============================================================================
SENTRY_DSN="${STAGING_SENTRY_DSN}"
ENABLE_MONITORING=true

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
