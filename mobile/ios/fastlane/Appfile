# ManithPro iOS App Configuration
# ============================================================
#
# This file contains the app-specific configuration for fastlane.
# Update these values with your actual App Store Connect details.
# ============================================================

# App Identifier (Bundle ID)
app_identifier ENV["IOS_APP_IDENTIFIER"] || "com.kreupai.manithpro"

# Apple ID email
apple_id ENV["APPLE_ID"] || "developer@kreupai.com"

# Apple Developer Team ID
team_id ENV["APPLE_TEAM_ID"] || "YOUR_TEAM_ID"

# App Store Connect Team ID (if different from Developer Team)
itc_team_id ENV["ITC_TEAM_ID"] || ENV["APPLE_TEAM_ID"]

# For App Store Connect API Key authentication (recommended for CI)
# Generate at: https://appstoreconnect.apple.com/access/api
#
# To use API key authentication, set these environment variables:
# - APP_STORE_CONNECT_API_KEY_ID
# - APP_STORE_CONNECT_API_ISSUER_ID
# - APP_STORE_CONNECT_API_KEY_CONTENT (or APP_STORE_CONNECT_API_KEY_PATH)

# ============================================================
# LANES CONFIGURATION
# ============================================================

for_platform :ios do
  # Use App Store Connect API for authentication if available
  if ENV["APP_STORE_CONNECT_API_KEY_ID"]
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false
    )
  end
end
